  position: fixed;
  ...
}
*/

/* ❌ 임시 제거 대상 - draggable helper */
/* .draggable-helper { ... } */

/* ❌ 임시 제거 대상 - 미완성 bottom-sheet */
/*
.bottom-sheet {
  position: fixed;
  ...
}
*/

/* ❌ 임시 제거: 바텀시트 오버레이 (position: fixed) */
/*
