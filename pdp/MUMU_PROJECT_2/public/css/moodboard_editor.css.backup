/* =========================
   MOODBOARD EDITOR STYLES
   바텀시트 및 툴바 스타일
   ========================= */

/* =========================
   레이아웃 복구: 기본 구조 강제
   ========================= */
html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  overflow-x: hidden;
  overflow-y: auto;
}

.moodboard-editor-page {
  height: 100vh;
  overflow-x: hidden;
  overflow-y: auto;
}

/* =========================
   모바일 프레임 강제 고정 (핵심)
   ========================= */
#mobile-root {
  width: 100%;
  max-width: 430px; /* iPhone 14 Pro 기준 */
  margin: 0 auto;
  min-height: 100vh;
  background: #fff;
  position: relative;
  overflow-x: hidden;
}

.app-frame {
  height: 100vh;
  overflow-x: hidden;
  overflow-y: auto;
}

#editor-root {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #fff;
  position: relative;
}

/* =========================
   상단 헤더 복구
   ========================= */
#editor-header {
  position: sticky;
  top: 0;
  z-index: 100;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  border-bottom: 1px solid #eee;
  background: #fff;
  flex-shrink: 0;
}

#editor-header .header-btn {
  background: transparent;
  border: none;
  padding: 8px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333;
}

#editor-header .header-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
  margin: 0;
  flex: 1;
  text-align: center;
}

#editor-header .header-actions {
  display: flex;
  align-items: center;
}

#editor-header .save-btn {
  font-size: 14px;
  font-weight: 500;
  color: #3b82f6;
  padding: 8px 16px;
}

/* =========================
   캔버스 영역 중앙 정렬 강제 (모바일 폭 고정)
   ========================= */
#editor-canvas-area {
  flex: 1;
  min-height: calc(100vh - 120px); /* 상단 헤더 + 하단 탭 제외 */
  display: flex;
  justify-content: center;
  align-items: center; /* 시각적 중심 고정 */
  padding: 24px 16px;
  padding-bottom: calc(80px + env(safe-area-inset-bottom)); /* 하단 네비 충돌 방지 */
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
}

.canvas-container {
  width: 100%;
  max-width: 430px; /* 모바일 폭 강제 고정 */
  margin: 0 auto;
  display: flex;
  justify-content: center;
  align-items: center; /* 시각적 중심 고정 */
}

.moodboard-canvas,
#canvas {
  width: 100%;
  max-width: 360px;
  min-height: 360px;
  background: #fafafa;
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  position: relative;
  aspect-ratio: 1;
}

/* ❌ 절대 사용 금지: 데스크탑 폭으로 늘어남 */
.editor-canvas {
  width: 100%;
  max-width: 360px; /* 모바일 기준 */
  aspect-ratio: 1 / 1;
  margin: 0 auto;
}

/* =========================
   슬롯 placeholder 아이콘 제거 (이미지가 있는 슬롯)
   ========================= */
.template-slot.has-content .template-slot-placeholder {
  display: none !important; /* 이미지가 있는 슬롯의 placeholder 즉시 제거 */
}

.slot-placeholder-icon {
  display: none !important; /* 응급 제거 */
}

/* 캔버스 내부 요소 위치 조정 */
.moodboard-canvas > *,
#canvas > * {
  position: relative;
}

.moodboard-canvas .empty-guide {
  position: absolute;
  top: 16px;
  left: 50%;
  transform: translateX(-50%);
  color: #999;
  font-size: 14px;
  text-align: center;
  pointer-events: none;
  z-index: 1;
}

.moodboard-canvas .empty-state-icon {
  font-size: 48px;
  margin-bottom: 8px;
}

.moodboard-canvas .empty-state-text {
  font-size: 14px;
  color: #999;
}

/* =========================
   하단 툴바 복구 (가림 방지)
   ========================= */
#editor-toolbar {
  position: sticky;
  bottom: 0;
  height: 72px;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1px solid #eee;
  display: flex !important; /* 항상 표시 강제 */
  justify-content: space-around;
  align-items: center;
  z-index: 100;
  flex-shrink: 0;
  visibility: visible !important; /* 항상 보이도록 강제 */
  opacity: 1 !important; /* 항상 보이도록 강제 */
}

#editor-toolbar .toolbar-btn {
  flex: 1;
  display: flex !important; /* 항상 표시 강제 */
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px 4px;
  border: none;
  background: transparent;
  cursor: pointer;
  transition: all 0.2s;
  min-width: 0;
  visibility: visible !important; /* 항상 보이도록 강제 */
  opacity: 1 !important; /* 항상 보이도록 강제 */
}

#editor-toolbar .toolbar-btn:active {
  transform: scale(0.95);
}

#editor-toolbar .toolbar-btn.active {
  color: #3b82f6;
}

#editor-toolbar .toolbar-icon {
  font-size: 24px;
  margin-bottom: 4px;
}

#editor-toolbar .toolbar-label {
  font-size: 11px;
  color: #666;
}

#editor-toolbar .toolbar-btn.active .toolbar-label {
  color: #3b82f6;
  font-weight: 500;
}

/* =========================
   임시 제거: position fixed 요소들
   ========================= */
/* ❌ 임시 제거 대상 - position: fixed로 떠 있는 요소들 */
/*
