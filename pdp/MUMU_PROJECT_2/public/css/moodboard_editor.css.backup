  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9998;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.bottom-sheet-overlay.show {
  opacity: 1;
  visibility: visible;
}
*/

/* ❌ 임시 제거: 바텀시트 (position: fixed) */
/*
.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: env(safe-area-inset-bottom);
  max-height: 80vh;
  background: #ffffff;
  border-radius: 20px 20px 0 0;
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
  z-index: 9999;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.bottom-sheet.open {
  transform: translateY(0);
}
*/

/* 바텀시트 헤더 */
.bottom-sheet-header {
  padding: 12px 20px 8px;
  border-bottom: 1px solid #e5e5e5;
  flex-shrink: 0;
}

.bottom-sheet-handle {
  width: 40px;
  height: 4px;
  background: #ddd;
  border-radius: 2px;
  margin: 0 auto;
}

/* 바텀시트 콘텐츠 */
.bottom-sheet-content {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
  -webkit-overflow-scrolling: touch;
}

/* 바텀시트 액션 버튼 영역 */
.bottom-sheet-actions {
  padding: 16px 20px;
  border-top: 1px solid #e5e5e5;
  flex-shrink: 0;
}

/* 패널 섹션 */
.panel-section {
  margin-bottom: 24px;
}

.panel-section:last-child {
  margin-bottom: 0;
}

.panel-title {
  font-size: 18px;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16px;
}

.panel-subtitle {
  font-size: 14px;
  font-weight: 500;
  color: #666;
  margin-bottom: 12px;
}

.panel-hint {
  font-size: 13px;
  color: #999;
  text-align: center;
  margin-top: 16px;
}

/* 무드 프리셋 그리드 */
.mood-preset-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}

.mood-preset-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px;
  border: 2px solid #e5e5e5;
  border-radius: 12px;
  background: #ffffff;
  cursor: pointer;
  transition: all 0.2s;
}

.mood-preset-btn:active {
  transform: scale(0.95);
}

.mood-preset-btn.active {
  border-color: #3b82f6;
  background: #eff6ff;
}

.mood-preset-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.mood-preset-preview {
  width: 60px;
  height: 60px;
  border-radius: 8px;
  margin-bottom: 8px;
}

.mood-preset-name {
  font-size: 13px;
  color: #333;
  font-weight: 500;
}

.mood-preset-btn.active .mood-preset-name {
  color: #3b82f6;
}

/* 조정 패널 */
.adjust-group {
  margin-bottom: 20px;
}

.adjust-group label {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #666;
  margin-bottom: 12px;
}

.adjust-buttons {
  display: flex;
  gap: 8px;
}

.adjust-btn {
  flex: 1;
  padding: 12px 16px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  background: #ffffff;
  font-size: 14px;
  color: #333;
  cursor: pointer;
  transition: all 0.2s;
}

.adjust-btn:active {
  transform: scale(0.98);
}

.adjust-btn.active {
  border-color: #3b82f6;
  background: #eff6ff;
  color: #3b82f6;
}

/* 정렬 프리셋 그리드 */
.align-preset-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}

.align-preset-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px;
  border: 1px solid #e5e5e5;
  border-radius: 12px;
  background: #ffffff;
  cursor: pointer;
  transition: all 0.2s;
}

.align-preset-btn:active {
  transform: scale(0.95);
}

.align-preset-btn.active {
  border-color: #3b82f6;
  background: #eff6ff;
}

.align-preset-btn span:first-child {
  font-size: 24px;
  margin-bottom: 4px;
}

.align-preset-btn span:last-child {
  font-size: 12px;
  color: #666;
}

/* 텍스처 효과 */
.texture-paper {
  background-image: 
    repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.03) 0px,
      transparent 1px,
      transparent 2px,
      rgba(0, 0, 0, 0.03) 3px
    );
}

/* 컷 컨트롤 버튼 */
.cut-controls {
  position: absolute;
  top: 8px;
  right: 8px;
  display: flex;
  gap: 4px;
  z-index: 1000;
  pointer-events: auto;
}

.cut-controls button {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: none;
  background: rgba(0, 0, 0, 0.7);
  color: white;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s;
}

.cut-controls button:active {
  background: rgba(0, 0, 0, 0.9);
}

.cut-controls button span {
  display: block;
  line-height: 1;
}

/* ❌ 임시 제거: 기존 툴바 (position: fixed) - #editor-toolbar로 대체됨 */
/*
.editor-toolbar {
  position: fixed;
  bottom: env(safe-area-inset-bottom);
  left: 0;
  right: 0;
  background: #ffffff;
  border-top: 1px solid #e5e5e5;
  padding: 8px 16px calc(8px + env(safe-area-inset-bottom));
  z-index: 9997;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
*/

.toolbar-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.toolbar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px 4px;
  border: none;
  background: transparent;
  cursor: pointer;
  transition: all 0.2s;
  min-width: 0;
}

.toolbar-btn:active {
  transform: scale(0.95);
}

.toolbar-btn.active {
  color: #3b82f6;
}

.toolbar-btn:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.toolbar-btn-icon {
  font-size: 24px;
  margin-bottom: 4px;
}

.toolbar-btn-label {
  font-size: 11px;
  color: #666;
}

.toolbar-btn.active .toolbar-btn-label {
  color: #3b82f6;
  font-weight: 500;
}

/* 템플릿 슬롯 스타일 */
.template-slot {
  position: absolute;
  border: 2px dashed #ddd;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.02);
  cursor: pointer;
  transition: all 0.2s;
  z-index: 10;
}

.template-slot:hover {
  border-color: #3b82f6;
  background: rgba(59, 130, 246, 0.05);
}

.template-slot.selected {
  border-color: #3b82f6;
  border-width: 3px;
  background: rgba(59, 130, 246, 0.1);
}

.template-slot.has-content {
  border-style: solid;
  border-color: #3b82f6;
  background: transparent;
}

.template-slot-placeholder {
  font-size: 32px;
  color: #999;
  font-weight: 300;
  pointer-events: none;
}

.template-slot.has-content .template-slot-placeholder {
  display: none;
}

/* 모바일 최적화 */
@media (max-width: 480px) {
  .mood-preset-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  
  .mood-preset-preview {
    width: 50px;
    height: 50px;
  }
  
  .align-preset-grid {
    gap: 8px;
  }
  
  .align-preset-btn {
    padding: 12px;
  }
  
  .template-slot-placeholder {
    font-size: 24px;
  }
}
