// 작품 썸네일 편집 초기화
// 프로필 상단 작품 3개 선택 초기화
function initializeFeaturedWorksSelector(creatorId) {
  const editBtn = document.getElementById("profile-works-edit-btn");
  if (!editBtn) return;

  // 편집 모달 생성
  function createEditModal() {
    const modal = document.createElement("div");
    modal.id = "featured-works-modal";
    modal.style.cssText = "position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 10000; display: none; align-items: center; justify-content: center;";
    
    const content = document.createElement("div");
    content.style.cssText = "background: white; padding: 24px; border-radius: 8px; max-width: 600px; width: 90%; max-height: 90vh; overflow-y: auto;";
    
    content.innerHTML = `
      <h3 style="margin: 0 0 16px 0; font-size: 18px; font-weight: 700;">작품 선택 (최대 3개)</h3>
      <div id="featured-works-list" style="display: flex; flex-direction: column; gap: 12px;">
        <!-- 작품 선택 항목들이 여기에 동적으로 추가됩니다 -->
      </div>
      <div style="display: flex; gap: 8px; margin-top: 16px;">
        <button id="featured-works-save-btn" style="flex: 1; padding: 12px; background: #FF5E00; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 14px; font-weight: 600;">저장</button>
        <button id="featured-works-cancel-btn" style="flex: 1; padding: 12px; background: #f0f0f0; color: #333; border: none; border-radius: 4px; cursor: pointer; font-size: 14px;">취소</button>
      </div>
    `;
    
    modal.appendChild(content);
    document.body.appendChild(modal);
    return modal;
  }

  const modal = createEditModal();
  const worksList = document.getElementById("featured-works-list");
  const saveBtn = document.getElementById("featured-works-save-btn");
  const cancelBtn = document.getElementById("featured-works-cancel-btn");

  let selectedWorks = []; // 선택된 작품 ID 배열 (순서 유지)

  // 작품 목록 로드 및 모달에 표시
  async function loadWorksForSelection() {
    waitForSupabase(async () => {
      try {
        // creatorId(firebase_uid)로 creators 테이블에서 id(UUID) 및 기존 선택 조회
        const { data: creator, error: creatorError } = await window.supabase
          .from("creators")
          .select("id, profile_featured_works")
          .eq("firebase_uid", creatorId)
          .limit(1)
          .single();

        if (creatorError || !creator) {
          console.error("[FEATURED_WORKS] 작가 UUID 조회 실패:", creatorError);
          return;
        }

        const creatorUuid = creator.id;
        const existingFeatured = creator.profile_featured_works || [];
        
        console.log("[FEATURED_WORKS][LOAD] 기존 선택:", existingFeatured);

        // works 테이블에서 전체 작품 조회 (limit 없음)
        const { data: works, error } = await window.supabase
          .from("works")
          .select("id, title, thumbnail_url, cover_image_url, is_deleted, is_published")
          .eq("creator_id", creatorUuid)
          .eq("is_deleted", false)
          .eq("is_published", true)
          .order("created_at", { ascending: false });

        if (error) {
          console.error("[FEATURED_WORKS] 작품 조회 실패:", error);
          return;
        }

        if (!works || works.length === 0) {
          worksList.innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">발행된 작품이 없습니다</div>';
          return;
        }

        console.log("[FEATURED_WORKS][LOAD] 전체 작품 수:", works.length);

        // 기존 선택된 작품을 selectedWorks에 복원
        selectedWorks = existingFeatured.filter(id => works.some(w => w.id === id));

        // 작품 목록 렌더링
        worksList.innerHTML = "";
        works.forEach(work => {
          const item = createWorkItem(work);
          worksList.appendChild(item);
        });

      } catch (error) {
        console.error("[FEATURED_WORKS] 작품 로드 예외:", error);
      }
    });
  }

  // 작품 선택 항목 생성
  function createWorkItem(work) {
    const item = document.createElement("div");
    item.className = "featured-work-item";
    item.setAttribute("data-work-id", work.id);
    item.style.cssText = "display: flex; align-items: center; gap: 12px; padding: 12px; border: 2px solid #e0e0e0; border-radius: 8px; cursor: pointer; transition: all 0.2s;";

    const thumbnailUrl = work.thumbnail_url || work.cover_image_url || "";
    const isSelected = selectedWorks.includes(work.id);
    const selectedIndex = selectedWorks.indexOf(work.id);

    if (isSelected) {
      item.style.borderColor = "#FF5E00";
      item.style.background = "#FFF5F0";
    }

    item.innerHTML = `
      <div style="width: 60px; height: 80px; background: #f0f0f0; background-image: url(${thumbnailUrl}); background-size: cover; background-position: center; border-radius: 4px; flex-shrink: 0;"></div>
      <div style="flex: 1;">
        <div style="font-size: 14px; font-weight: 600; margin-bottom: 4px;">${work.title || "제목 없음"}</div>
        <div style="font-size: 12px; color: #999;">ID: ${work.id.substring(0, 8)}...</div>
      </div>
      <div class="selection-badge" style="width: 24px; height: 24px; border-radius: 50%; border: 2px solid ${isSelected ? '#FF5E00' : '#ddd'}; background: ${isSelected ? '#FF5E00' : 'white'}; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: white; flex-shrink: 0;">
        ${isSelected ? (selectedIndex + 1) : ''}
      </div>
    `;

    // 클릭 이벤트
    item.addEventListener("click", () => {
      toggleWorkSelection(work.id, item);
    });

    return item;
  }

  // 작품 선택/해제 토글
  function toggleWorkSelection(workId, itemElement) {
    const index = selectedWorks.indexOf(workId);

    if (index !== -1) {
      // 이미 선택됨 -> 해제
      selectedWorks.splice(index, 1);
      console.log("[FEATURED_WORKS][DESELECT]", workId);
    } else {
      // 선택되지 않음 -> 선택
      if (selectedWorks.length >= 3) {
        alert("최대 3개까지만 선택할 수 있습니다.");
        return;
      }
      selectedWorks.push(workId);
      console.log("[FEATURED_WORKS][SELECT]", workId);
    }

    // 전체 UI 업데이트
    updateAllWorkItems();
  }

  // 전체 작품 항목 UI 업데이트
  function updateAllWorkItems() {
    const items = worksList.querySelectorAll(".featured-work-item");
    items.forEach(item => {
      const workId = item.getAttribute("data-work-id");
      const isSelected = selectedWorks.includes(workId);
      const selectedIndex = selectedWorks.indexOf(workId);
      const badge = item.querySelector(".selection-badge");

      if (isSelected) {
        item.style.borderColor = "#FF5E00";
        item.style.background = "#FFF5F0";
        badge.style.borderColor = "#FF5E00";
        badge.style.background = "#FF5E00";
        badge.textContent = selectedIndex + 1;
      } else {
        item.style.borderColor = "#e0e0e0";
        item.style.background = "white";
        badge.style.borderColor = "#ddd";
        badge.style.background = "white";
        badge.textContent = "";
      }
    });

    console.log("[FEATURED_WORKS][STATE] 현재 선택:", selectedWorks);
  }

  // 저장
  saveBtn.addEventListener("click", async () => {
    console.log("[FEATURED_WORKS][SAVE][START] 선택된 작품:", selectedWorks);

    waitForSupabase(async () => {
      try {
        const { error } = await window.supabase
          .from("creators")
          .update({
            profile_featured_works: selectedWorks
          })
          .eq("firebase_uid", creatorId);

        if (error) {
          console.error("[FEATURED_WORKS][SAVE][FAIL] DB 저장 실패:", error);
          alert("저장에 실패했습니다.");
          return;
        }

        console.log("[FEATURED_WORKS][SAVE][SUCCESS] 저장 완료");
        modal.style.display = "none";
        showToast("작품 선택이 저장되었습니다.");
        
        // 페이지 새로고침하여 반영
        window.location.reload();
      } catch (error) {
        console.error("[FEATURED_WORKS][SAVE][FAIL] 저장 예외:", error);
        alert("저장 중 오류가 발생했습니다.");
      }
    });
  });

  // 취소
  cancelBtn.addEventListener("click", () => {
    modal.style.display = "none";
  });

  // 모달 외부 클릭 시 닫기
  modal.addEventListener("click", (e) => {
    if (e.target === modal) {
      cancelBtn.click();
    }
  });

  // 편집 버튼 클릭
  editBtn.addEventListener("click", () => {
    modal.style.display = "flex";
    loadWorksForSelection();
  });
}
