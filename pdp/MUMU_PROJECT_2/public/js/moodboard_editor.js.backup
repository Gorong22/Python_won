// =========================
// BOTTOM SHEET MANAGER
// =========================

const BottomSheetManager = {
  currentPanel: null,
  swipeStartY: null,
  swipeThreshold: 50,

  init() {
    this.createBottomSheetHTML();
    this.setupEventListeners();
  },

  createBottomSheetHTML() {
    // 기존 바텀시트가 없으면 생성
    let bottomSheet = document.getElementById("bottomSheet");
    if (!bottomSheet) {
      bottomSheet = document.createElement("div");
      bottomSheet.id = "bottomSheet";
      bottomSheet.className = "bottom-sheet";
      bottomSheet.innerHTML = `
        <div class="bottom-sheet-header">
          <div class="bottom-sheet-handle"></div>
        </div>
        <div class="bottom-sheet-content" id="bottomSheetContent"></div>
        <div class="bottom-sheet-actions" id="bottomSheetActions"></div>
      `;
      document.body.appendChild(bottomSheet);
    }

    // 오버레이 생성
    let overlay = document.getElementById("bottomSheetOverlay");
    if (!overlay) {
      overlay = document.createElement("div");
      overlay.id = "bottomSheetOverlay";
      overlay.className = "bottom-sheet-overlay";
      overlay.addEventListener("click", () => this.close());
      document.body.appendChild(overlay);
    }
  },

  setupEventListeners() {
    const bottomSheet = document.getElementById("bottomSheet");
    if (!bottomSheet) return;

    // ESC 키로 닫기
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && this.isOpen()) {
        this.close();
      }
    });

    // Swipe down 제스처
    let touchStartY = 0;
    let touchStartTime = 0;

    bottomSheet.addEventListener(
      "touchstart",
      (e) => {
        touchStartY = e.touches[0].clientY;
        touchStartTime = Date.now();
      },
      { passive: true }
    );

    bottomSheet.addEventListener(
      "touchmove",
      (e) => {
        if (!this.isOpen()) return;

        const touchY = e.touches[0].clientY;
        const deltaY = touchY - touchStartY;

        // 아래로 스와이프 중
        if (deltaY > 0) {
          const header = bottomSheet.querySelector(".bottom-sheet-header");
          if (header && e.target.closest(".bottom-sheet-header")) {
            bottomSheet.style.transform = `translateY(${deltaY}px)`;
          }
        }
      },
      { passive: true }
    );

    bottomSheet.addEventListener(
      "touchend",
      (e) => {
        if (!this.isOpen()) return;

        const touchY = e.changedTouches[0].clientY;
        const deltaY = touchY - touchStartY;
        const deltaTime = Date.now() - touchStartTime;

        // 빠르게 아래로 스와이프하거나 충분히 아래로 드래그한 경우 닫기
        if (deltaY > this.swipeThreshold || (deltaY > 20 && deltaTime < 300)) {
          this.close();
        } else {
          // 원래 위치로 복귀
          bottomSheet.style.transform = "";
        }
      },
      { passive: true }
    );
  },

  open(content, actions = null) {
    const bottomSheet = document.getElementById("bottomSheet");
    const overlay = document.getElementById("bottomSheetOverlay");
    const contentEl = document.getElementById("bottomSheetContent");
    const actionsEl = document.getElementById("bottomSheetActions");

    if (!bottomSheet || !contentEl) return;

    // 내용 설정
    contentEl.innerHTML = content;

    // 액션 버튼 설정
    if (actionsEl) {
      if (actions) {
        actionsEl.innerHTML = actions;
        actionsEl.style.display = "block";
      } else {
        actionsEl.style.display = "none";
      }
    }

    // 열기 애니메이션
    overlay?.classList.add("show");
    bottomSheet.classList.add("open");

    // Safe Area 고려한 위치 조정
    bottomSheet.style.bottom = `env(safe-area-inset-bottom)`;
    bottomSheet.style.paddingBottom = `calc(16px + env(safe-area-inset-bottom))`;
  },

  close() {
    const bottomSheet = document.getElementById("bottomSheet");
    const overlay = document.getElementById("bottomSheetOverlay");

    if (bottomSheet) {
      bottomSheet.classList.remove("open");
      bottomSheet.style.transform = "";
    }
    if (overlay) overlay.classList.remove("show");

    this.currentPanel = null;
  },

  isOpen() {
    const bottomSheet = document.getElementById("bottomSheet");
    return bottomSheet?.classList.contains("open") || false;
  },

  setCurrentPanel(panel) {
    this.currentPanel = panel;
  },

  getCurrentPanel() {
    return this.currentPanel;
  },
};

// =========================
// EFFECT PRESET MANAGER
// =========================

const EffectPresetManager = {
  presets: {
    clean: {
      name: "클린",
      shadow: "0 2px 8px rgba(0, 0, 0, 0.08)",
      borderRadius: 8,
      border: "none",
      backgroundTone: "#FFFFFF",
      texture: null,
      opacity: 1,
    },
    soft_day: {
      name: "부드러운 하루",
      shadow: "0 4px 16px rgba(0, 0, 0, 0.1)",
      borderRadius: 16,
      border: "none",
      backgroundTone: "#F8FAFC",
      texture: null,
      opacity: 1,
    },
    memory: {
      name: "추억",
      shadow: "0 6px 20px rgba(0, 0, 0, 0.12)",
      borderRadius: 20,
      border: "1px solid rgba(0, 0, 0, 0.05)",
      backgroundTone: "#FFFBF0",
      texture: "paper",
      opacity: 0.98,
    },
    focus: {
      name: "집중",
      shadow: "0 8px 24px rgba(0, 0, 0, 0.15)",
      borderRadius: 12,
      border: "none",
      backgroundTone: "#FFFFFF",
      texture: null,
      opacity: 1,
    },
    paper: {
      name: "종이",
      shadow: "0 4px 12px rgba(0, 0, 0, 0.08)",
      borderRadius: 4,
      border: "1px solid rgba(0, 0, 0, 0.08)",
      backgroundTone: "#FAFAFA",
      texture: "paper",
      opacity: 0.95,
    },
    contrast: {
      name: "대비",
      shadow: "0 10px 30px rgba(0, 0, 0, 0.2)",
      borderRadius: 0,
      border: "2px solid rgba(0, 0, 0, 0.1)",
      backgroundTone: "#FFFFFF",
      texture: null,
      opacity: 1,
    },
  },

  applyPreset(blockId, presetId) {
    const block = blocks.find((b) => b.id === blockId);
    if (!block) return;

    const preset = this.presets[presetId];
    if (!preset) return;

    block.style = block.style || {};
    block.style.boxShadow = preset.shadow;
    block.style.borderRadius = `${preset.borderRadius}px`;
    block.style.border = preset.border;
    block.style.opacity = preset.opacity;

    // 텍스처는 CSS 클래스로 적용
    const blockElement = document.querySelector(`[data-id="${blockId}"]`);
    if (blockElement) {
      blockElement.classList.remove("texture-paper");
      if (preset.texture === "paper") {
        blockElement.classList.add("texture-paper");
      }
    }

    // 효과 프리셋 ID 저장
    block.style.effectPreset = presetId;

    renderBlocks();
    selectBlock(blockId);
  },

  getPresetList() {
    return Object.keys(this.presets).map((id) => ({
      id,
      ...this.presets[id],
    }));
  },
};

// =========================
// 하단 툴바 및 바텀 시트 (기존 호환성 유지)
// =========================

let currentToolPanel = null;

function openToolPanel(tool) {
  BottomSheetManager.setCurrentPanel(tool);

  const selectedBlock = selectedBlockId
    ? blocks.find((b) => b.id === selectedBlockId)
    : null;

  // 선택된 블록이 있으면 해당 타입의 패널 표시
  if (
    selectedBlock &&
    tool !== "background" &&
    tool !== "effect" &&
    tool !== "adjust" &&
    tool !== "align" &&
    tool !== "layout"
  ) {
    if (selectedBlock.type === "image" || selectedBlock.type === "cut") {
      tool = "image";
    } else if (selectedBlock.type === "text") {
      tool = "text";
    } else if (selectedBlock.type === "emoji") {
      tool = "sticker";
    }
  }

  // 같은 툴이면 닫기
  if (currentToolPanel === tool && BottomSheetManager.isOpen()) {
    BottomSheetManager.close();
    currentToolPanel = null;
    updateToolbarUI(); // 툴바 UI 업데이트
    return;
  }

  currentToolPanel = tool;

  // 툴바 UI 업데이트 (탭 클릭 시 상태 전환)
  updateToolbarUI();

  let content = "";
  let actions = null;

  switch (tool) {
    case "image":
      content = createImagePanel();
      break;
    case "text":
      content = createTextPanel();
      break;
    case "sticker":
      content = createStickerPanel();
      break;
    case "adjust":
      content = createAdjustPanel();
      break;
    case "align":
      content = createAlignPanel();
      break;
    case "layout":
      content = createLayoutPanel();
      break;
    case "background":
      content = createBackgroundPanel();
      break;
    case "effect":
      content = createEffectPanel();
      break;
  }

  BottomSheetManager.open(content, actions);
}

function closeBottomSheet() {
  BottomSheetManager.close();
  currentToolPanel = null;

  // 툴바 UI 업데이트
  updateToolbarUI();
}

// 툴바 UI 업데이트 함수 (탭 상태 및 레이어 선택 상태 반영)
function updateToolbarUI() {
  const toolbarBtns = document.querySelectorAll(".toolbar-btn");
  const selectedBlock = selectedBlockId
    ? blocks.find((b) => b.id === selectedBlockId)
    : null;

  toolbarBtns.forEach((btn) => {
    const tool = btn.dataset.tool;

    // 현재 활성화된 툴 표시
    if (currentToolPanel === tool && BottomSheetManager.isOpen()) {
      btn.classList.add("active");
    } else {
      btn.classList.remove("active");
    }

    // 편집 관련 툴은 레이어 선택 시에만 활성화
    // (이미지/텍스트/스티커는 항상 활성, 배경은 항상 활성)
    if (
      tool === "adjust" ||
      tool === "align" ||
      tool === "layout" ||
      tool === "effect"
    ) {
      if (!selectedBlock) {
        btn.disabled = true;
        btn.style.opacity = "0.3";
        btn.style.pointerEvents = "none";
      } else {
        btn.disabled = false;
        btn.style.opacity = "1";
        btn.style.pointerEvents = "auto";
      }
    } else {
      // 이미지/텍스트/스티커/배경은 항상 활성
      btn.disabled = false;
      btn.style.opacity = "1";
      btn.style.pointerEvents = "auto";
    }
  });
}

function createBottomSheetOverlay() {
  return document.getElementById("bottomSheetOverlay");
}

// 이미지 패널
function createImagePanel() {
