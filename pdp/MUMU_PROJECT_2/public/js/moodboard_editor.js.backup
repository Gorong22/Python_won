  if (!block) return;

  const style = block.style || {};

  // 확장된 버전으로 교체
  popup.innerHTML = `
    <button class="close-popup-btn" onclick="closeTopStylePopup()">×</button>
    <div class="top-popup-content expanded-popup">
      <div class="top-popup-title">텍스트 스타일</div>
      <div class="text-style-grid">
        <div class="text-style-item">
          <label>크기</label>
          <div class="control-buttons">
            <button class="control-btn" onclick="changeFontSize('${
              block.id
            }', -2)">-</button>
            <span class="control-value" id="fontSizeDisplay">${
              style.fontSize || 16
            }</span>
            <button class="control-btn" onclick="changeFontSize('${
              block.id
            }', 2)">+</button>
          </div>
        </div>
        <div class="text-style-item">
          <label>텍스트 색상</label>
          <div class="text-color-scroll-container">
            <div class="text-color-grid">
              ${getTextColorOptions()
                .map(
                  (color) => `
                <div class="text-color-item" 
                     style="background: ${color};"
                     onclick="selectTextColor('${block.id}', '${color}')">
                </div>
              `
                )
                .join("")}
            </div>
          </div>
          <div class="text-custom-color">
            <label>커스텀 색상</label>
            <input type="color" class="color-picker-round" id="textColor" value="${
              style.color || "#000000"
            }" />
          </div>
        </div>
        <div class="text-style-item">
          <label>배경 색상</label>
          <div class="background-color-scroll-container">
            <div class="background-color-grid-top">
              ${COLORS.map(
                (color) => `
                <div class="background-color-item-top" 
                     style="background: ${color};"
                     onclick="selectTextBackgroundColor('${block.id}', '${color}')">
                </div>
              `
              ).join("")}
            </div>
          </div>
          <div class="text-custom-color">
            <label>커스텀 색상</label>
            <input type="color" class="color-picker-round" id="backgroundColor" value="${
              style.backgroundColor || "#ffffff"
            }" />
          </div>
        </div>
      </div>
    </div>
  `;

  popup.dataset.isExpanded = "true";

  // 색상 변경 이벤트 리스너 다시 연결
