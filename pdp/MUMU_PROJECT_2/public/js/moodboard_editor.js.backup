// =========================
// MOODBOARD EDITOR - COMPLETE VERSION
// =========================

import { getSupabase } from "./supabase-auth.js";

// =========================
// ERROR LOGGING UTILITY
// =========================

function logError(context, error, additionalInfo = {}) {
  const errorInfo = {
    timestamp: new Date().toISOString(),
    context: context,
    error: {
      message: error?.message || String(error),
      stack: error?.stack,
      name: error?.name,
    },
    state: {
      currentMoodboardId,
      currentUserId,
      isReaderMode,
      blocksCount: blocks.length,
      selectedBlockId,
    },
    ...additionalInfo,
  };
  console.error("[Editor Error]", JSON.stringify(errorInfo, null, 2));
  console.error("[Editor Error] Context:", context, "Error:", error);
}

// 전역 에러 핸들러
window.addEventListener("error", (event) => {
  logError("Global Error Handler", event.error, {
    filename: event.filename,
    lineno: event.lineno,
    colno: event.colno,
  });
});

window.addEventListener("unhandledrejection", (event) => {
  // "Asynchronous response message channel error" 같은 브라우저 내부 오류는 무시
  const errorMessage = event.reason?.message || String(event.reason || "");
  if (
    errorMessage.includes("message channel") ||
    errorMessage.includes("channel closed") ||
    errorMessage.includes("Extension context invalidated")
  ) {
    // 브라우저 확장 프로그램이나 내부 채널 오류는 무시
    return;
  }

  logError("Unhandled Promise Rejection", event.reason, {
    promise: event.promise,
  });

  // 기본 동작 방지 (콘솔에만 로그하고 계속 진행)
  event.preventDefault();
});

// =========================
// STATE MANAGEMENT
// =========================

let supabaseClient = null;
let currentMoodboardId = null;
let currentUserId = null;
let blocks = []; // 🔥 단일 소스: 모든 블록 데이터 (레이어로 사용)
let selectedBlockId = null;
let isDragging = false;
let isResizing = false;
let isRotating = false;
let dragStart = { x: 0, y: 0 };
let blockStartPos = { x: 0, y: 0 };
let blockStartSize = { w: 0, h: 0 };
let blockStartRotation = 0;
let touchStartDistance = 0;
let touchStartAngle = 0;
let isReaderMode = false; // Reader 모드 플래그
let editorMode = null; // 'free' or 'template'
let currentTemplate = null; // 선택된 템플릿
let currentSlotId = null; // 템플릿형에서 선택 중인 슬롯 ID

// =========================
// LAYER MANAGER
// =========================

const LayerManager = {
  // 레이어 목록 가져오기 (blocks 배열을 레이어로 사용)
  getLayers() {
    return blocks.filter((b) => !b.id?.startsWith("decoration-"));
  },

  // 레이어 추가
  addLayer(layerData) {
    blocks.push(layerData);
    renderLayers();
  },

  // 레이어 선택
  selectLayer(id) {
    selectBlock(id);
  },

  // 레이어 삭제
  deleteLayer(id) {
    deleteBlock(id);
  },

  // 레이어 업데이트
  updateLayer(id, updates) {
    const layer = blocks.find((b) => b.id === id);
    if (layer) {
      Object.assign(layer, updates);
      renderLayers();
    }
  },
};

// 레이어 렌더링 (기존 renderBlocks와 동일)
function renderLayers() {
  renderBlocks();
}

// 전역 함수로 export
window.LayerManager = LayerManager;
window.renderLayers = renderLayers;

// =========================
// MODE SELECTION
// =========================

// 모드 선택 (자유형 또는 템플릿형)
function selectMode(mode) {
  editorMode = mode;

  if (mode === "free") {
    // 자유형 선택 - 바로 에디터 열기
    openEditor("free");
  } else if (mode === "template") {
    // 템플릿형 선택 - 템플릿 선택 화면 표시
    showTemplateSelector();
  }
}

// 템플릿 선택 화면 표시
function showTemplateSelector() {
  const modeSelector = document.getElementById("modeSelectorScreen");
  const templateSelector = document.getElementById("templateSelectorScreen");
  const templateGrid = document.getElementById("templateGrid");

  if (!modeSelector || !templateSelector || !templateGrid) return;

  modeSelector.classList.add("hidden");
  templateSelector.classList.add("active");

  // 템플릿 목록 렌더링
  const templates = getTemplateList();
  templateGrid.innerHTML = templates
    .map(
      (template) => `
    <div class="template-card" onclick="selectTemplate('${template.id}')">
      <div class="template-card-name">${template.name}</div>
      <div class="template-card-desc">${template.description}</div>
    </div>
  `
    )
    .join("");
}

// 템플릿 선택
function selectTemplate(templateId) {
  const template = getTemplate(templateId);
  if (!template) return;

  currentTemplate = template;
  openEditor("template");
}

// 모드 선택 화면으로 돌아가기
function backToModeSelector() {
  const modeSelector = document.getElementById("modeSelectorScreen");
  const templateSelector = document.getElementById("templateSelectorScreen");

  if (modeSelector) modeSelector.classList.remove("hidden");
  if (templateSelector) templateSelector.classList.remove("active");

  editorMode = null;
  currentTemplate = null;
}

// 에디터 열기
function openEditor(mode) {
  const modeSelector = document.getElementById("modeSelectorScreen");
  const templateSelector = document.getElementById("templateSelectorScreen");
  const editorScreen = document.getElementById("editorScreen");
  const editorTools = document.getElementById("editorTools");

  if (!editorScreen) return;

  // 🚨 템플릿 모드 방어 코드: 템플릿이 선택되지 않았으면 템플릿 선택 화면으로 돌아감
  if (mode === "template" && !currentTemplate) {
    console.warn(
      "[Editor] 템플릿이 선택되지 않았습니다. 템플릿 선택 화면으로 돌아갑니다."
    );
    showTemplateSelector();
    return;
  }

  // 모든 선택 화면 숨기기
  if (modeSelector) modeSelector.classList.add("hidden");
  if (templateSelector) templateSelector.classList.remove("active");

  // 에디터 화면 표시
  editorScreen.classList.add("active");

  // 자유형이면 도구 표시, 템플릿형이면 숨김
  if (editorTools) {
    editorTools.style.display = mode === "free" ? "flex" : "none";
  }

  // Safe Area 적용: 헤더/하단 네비 영역 고려
  const canvas = document.getElementById("canvas");
  if (canvas) {
    // 헤더 높이(약 60px) + 하단 네비 높이(약 80px) 고려하여 padding 적용
    canvas.style.paddingTop = "20px";
    canvas.style.paddingBottom = "20px";
    canvas.style.paddingLeft = "20px";
    canvas.style.paddingRight = "20px";
    canvas.style.overflow = "visible"; // 요소 잘림 방지
  }

  // 에디터 초기화
  initializeEditor();

  // 템플릿 모드인 경우 슬롯 렌더링 보장
  if (mode === "template" && currentTemplate) {
    setTimeout(() => {
      applyTemplate(currentTemplate);
      renderTemplateSlots(currentTemplate);
    }, 100);
  }
}

// =========================
// INITIALIZATION
// =========================

document.addEventListener("DOMContentLoaded", async () => {
  try {
    // 0. BottomSheetManager 초기화
    BottomSheetManager.init();

    // 1. Supabase 초기화 (완료 대기)
    await initializeSupabase();

    // Reader 모드 확인 (URL 파라미터)
    const urlParams = new URLSearchParams(window.location.search);
    const readerParam = urlParams.get("reader");
    isReaderMode = readerParam === "1" || readerParam === "true";

    // Reader 모드가 아니고 Supabase 초기화 실패 시에만 에러
    if (!isReaderMode && !supabaseClient) {
      console.error("[Editor] Supabase 초기화 실패");
      alert("서비스 연결에 실패했습니다. 페이지를 새로고침해주세요.");
      return;
    }

    // 2. 사용자 확인 (필수)
    const user = await getCurrentUser();
    if (!user || !user.uid) {
      console.warn("[Editor] 로그인이 필요합니다");
      alert("로그인이 필요합니다. 로그인 페이지로 이동합니다.");
      window.location.href = "login.html";
      return;
    }

    console.log("[Editor] 사용자 확인 완료:", currentUserId);
    if (isReaderMode) {
      console.log("[Editor] Reader 모드로 실행 중");
    }

    // 3. URL에서 무드보드 ID 확인
    const urlParams2 = new URLSearchParams(window.location.search);
    const id = urlParams2.get("id");
    const isNew = urlParams2.get("new") === "1";

    // 기존 무드보드 편집인 경우 바로 에디터 열기
    if (id && !isNew) {
      await loadMoodboardFromURL();
      // 기존 무드보드는 자유형으로 간주
      editorMode = "free";
      openEditor("free");
      initializeEventListeners();
      if (blocks.length > 0) {
        renderBlocks();
      }
      setTimeout(() => {
        if (typeof editor !== "undefined" && editor.init) {
          editor.init();
        }
      }, 100);
    } else {
      // 새 무드보드인 경우 모드 선택 화면 표시 (자동 진입 방지)
      // 모드 선택 화면은 이미 HTML에 있고, 사용자가 선택할 때까지 대기
      // 아무것도 하지 않음 - 모드 선택 화면이 기본으로 표시됨
    }
  } catch (error) {
    logError("DOMContentLoaded - 초기화", error, {
      step: "전체 초기화 과정",
    });
    alert(
      "에디터를 불러오는 중 오류가 발생했습니다. 페이지를 새로고침해주세요."
    );
  }
});

// 에디터 초기화 (모드 선택 후)
async function initializeEditor() {
  try {
    // 무드보드 생성 또는 로드
    await loadMoodboardFromURL();

    // 템플릿이 없으면 기본 템플릿 자동 적용
    if (!currentTemplate) {
      const defaultTemplate = getTemplate("clean_grid_4"); // 기본 템플릿
      if (defaultTemplate) {
        currentTemplate = defaultTemplate;
        editorMode = "template";
      }
    }

    // 템플릿형인 경우 템플릿 적용
    if (editorMode === "template" && currentTemplate) {
      applyTemplate(currentTemplate);
      // 슬롯 렌더링 보장
      setTimeout(() => {
        renderTemplateSlots(currentTemplate);
      }, 100);
    } else {
      // 템플릿이 없는 경우 placeholder 슬롯 표시
      renderPlaceholderSlot();
    }

    // 이벤트 리스너 초기화
    initializeEventListeners();

    // 블록 렌더링
    renderBlocks();

    // editor 초기화
    setTimeout(() => {
      if (typeof editor !== "undefined" && editor.init) {
        editor.init();
      }
    }, 100);
  } catch (error) {
    logError("initializeEditor", error);
    // 에러 발생 시에도 기본 템플릿 적용 시도
    try {
      const defaultTemplate = getTemplate("clean_grid_4");
      if (defaultTemplate) {
        currentTemplate = defaultTemplate;
        editorMode = "template";
        applyTemplate(defaultTemplate);
        setTimeout(() => {
          renderTemplateSlots(defaultTemplate);
        }, 100);
      }
    } catch (fallbackError) {
      console.error("[Editor] 기본 템플릿 적용 실패:", fallbackError);
    }
  }
}

// Placeholder 슬롯 렌더링 (템플릿이 없을 때)
function renderPlaceholderSlot() {
  const canvas = document.getElementById("canvas");
  if (!canvas) return;

  // 기존 슬롯 제거
  const existingSlots = canvas.querySelectorAll(".template-slot");
  existingSlots.forEach((slot) => slot.remove());

  const canvasRect = canvas.getBoundingClientRect();
  const canvasWidth = canvasRect.width - 40;
  const canvasHeight = canvasRect.height - 40;
  const size = Math.min(canvasWidth, canvasHeight) * 0.5;

  // 중앙에 placeholder 슬롯 생성
  const slotEl = document.createElement("div");
  slotEl.className = "template-slot";
  slotEl.dataset.slotId = "placeholder-main";
  slotEl.style.left = `${(canvasWidth - size) / 2}px`;
  slotEl.style.top = `${(canvasHeight - size) / 2}px`;
  slotEl.style.width = `${size}px`;
  slotEl.style.height = `${size}px`;

  const placeholder = document.createElement("div");
  placeholder.className = "template-slot-placeholder";
  placeholder.textContent = "+";
  slotEl.appendChild(placeholder);

  slotEl.addEventListener("click", (e) => {
    if (!e.target.closest(".slot-cut-block")) {
      currentSlotId = "placeholder-main";
      openImageSelectionModalForSlot("placeholder-main");
    }
  });

  canvas.appendChild(slotEl);
}

async function initializeSupabase() {
  try {
    supabaseClient = getSupabase();
    if (!supabaseClient) {
      logError("initializeSupabase", new Error("Supabase client 초기화 실패"));
    }
  } catch (error) {
    logError("initializeSupabase", error);
  }
}

async function getCurrentUser() {
  try {
    // 방법 1: window.getCurrentFirebaseUser 사용 (reader_auth.js에서 제공)
    if (typeof window.getCurrentFirebaseUser === "function") {
      const user = await window.getCurrentFirebaseUser();
      if (user && user.uid) {
        currentUserId = user.uid;
        console.log("[Editor] 사용자 확인됨:", currentUserId);
        return user;
      }
    }

    // 방법 2: 직접 Firebase Auth 확인 (fallback)
    try {
      const { auth } = await import("/js/firebase_init.js");
      const { onAuthStateChanged } = await import(
        "https://www.gstatic.com/firebasejs/9.23.0/firebase-auth.js"
      );

      const user = await new Promise((resolve) => {
        const unsubscribe = onAuthStateChanged(auth, (user) => {
          unsubscribe();
          resolve(user);
        });
      });

      if (user && user.uid) {
        currentUserId = user.uid;
        console.log("[Editor] Firebase Auth에서 사용자 확인됨:", currentUserId);
        return user;
      }
    } catch (firebaseError) {
      console.warn("[Editor] Firebase 직접 확인 실패:", firebaseError);
    }

    console.warn("[Editor] 사용자를 찾을 수 없습니다");
    return null;
  } catch (error) {
    logError("getCurrentUser", error);
    return null;
  }
}

async function loadMoodboardFromURL() {
  try {
    const urlParams = new URLSearchParams(window.location.search);
    const id = urlParams.get("id");
    const isNew = urlParams.get("new") === "1";
    const isEdit = urlParams.get("edit") === "true";
    const isView = urlParams.get("view") === "true";
    const readerParam = urlParams.get("reader");

    // Reader 모드 확인
    isReaderMode = readerParam === "1" || readerParam === "true";

    if (isNew || !id) {
      // 새 무드보드 생성
      await createNewMoodboard();
      return;
    }

    // Reader 모드 분기
    if (isReaderMode) {
      // Reader 모드: UUID 검증 없이 Firestore로 로드
      currentMoodboardId = id;
      await loadReaderMoodboard(id, isEdit, isView);
      await loadReaderBlocks(id);
      return;
    }

    // Creator 모드: UUID 검증 후 Supabase로 로드
    if (!isValidUUID(id)) {
      logError(
        "loadMoodboardFromURL - UUID 검증 실패",
        new Error("잘못된 ID 형식"),
        { id }
      );
      showInvalidLinkUI();
      return;
    }

    // moodboards.id는 UUID만 허용
    currentMoodboardId = id;
    await loadMoodboard(id, isEdit, isView);
    await loadBlocks(id);
  } catch (error) {
    logError("loadMoodboardFromURL", error, {
      url: window.location.href,
    });
    throw error;
  }
}

// UUID 검증 함수
function isValidUUID(str) {
  const uuidRegex =
    /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  return uuidRegex.test(str);
}

// 잘못된 링크 UI 표시 함수
function showInvalidLinkUI() {
  const canvas = document.getElementById("canvas");
  const titleEl = document.getElementById("editorTitle");

  if (canvas) {
    canvas.innerHTML = `
      <div style="text-align: center; padding: 60px 20px;">
        <div style="font-size: 48px; margin-bottom: 20px;">🔗</div>
        <h2 style="font-size: 20px; font-weight: 600; margin-bottom: 12px; color: #333;">잘못된 링크입니다</h2>
        <p style="font-size: 14px; color: #666; margin-bottom: 24px;">무드보드를 찾을 수 없습니다.</p>
        <button onclick="window.location.href='moodboard_editor.html?new=1'" 
                style="background: #667eea; color: white; border: none; padding: 12px 24px; border-radius: 8px; font-size: 14px; font-weight: 500; cursor: pointer;">
          새로 만들기
        </button>
      </div>
    `;
  }

  if (titleEl) {
    titleEl.textContent = "잘못된 링크";
  }
}

async function createNewMoodboard() {
  try {
    // 사용자 재확인 (타이밍 이슈 대비)
    if (!currentUserId) {
      const user = await getCurrentUser();
      if (!user || !user.uid) {
        alert("로그인이 필요합니다. 로그인 후 다시 시도해주세요.");
        window.location.href = "login.html";
        return;
      }
      currentUserId = user.uid;
    }

    // Supabase Auth 세션 확인 (RLS 에러 방지)
    let hasSupabaseSession = false;
    if (supabaseClient) {
      try {
        const { data: sessionData, error: sessionError } =
          await supabaseClient.auth.getSession();
        if (!sessionError && sessionData?.session) {
          hasSupabaseSession = true;
        }
      } catch (e) {
        console.warn("[Editor] 세션 확인 실패:", e);
      }
    }

    // Reader(Firebase Auth만 있는 경우)는 Firestore로 저장
    if (!hasSupabaseSession) {
      console.log("[Editor] Reader 모드: Firestore로 무드보드 저장");
      isReaderMode = true;

      try {
        // 모듈 방식으로 Firestore 사용
        const { db } = await import("/js/firebase_init.js");
        const { collection, doc, setDoc, serverTimestamp } = await import(
          "https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore.js"
        );

        // Firestore에 저장
        const moodboardRef = doc(collection(db, "reader_moodboards"));
        const moodboardId = moodboardRef.id;

        await setDoc(moodboardRef, {
          owner_id: currentUserId,
          title: "새 무드보드",
          description: null,
          is_public: false,
          created_at: serverTimestamp(),
          updated_at: serverTimestamp(),
        });

        currentMoodboardId = moodboardId;

        // URL에 ID를 쿼리 파라미터로 추가
        window.history.replaceState(
          {},
          "",
          `?id=${moodboardId}&reader=1&edit=true`
        );
        const titleEl = document.getElementById("editorTitle");
        if (titleEl) {
          titleEl.textContent = "새 무드보드";
        }

        // Reader가 만든 무드보드는 커뮤니티에 노출 불가 안내
        console.warn(
          "[Editor] Reader 무드보드는 커뮤니티에 노출되지 않습니다."
        );

        console.log("[Editor] Firestore 무드보드 생성 완료, ID:", moodboardId);
        return;
      } catch (error) {
        logError("createNewMoodboard - Reader 모드", error, {
          mode: "Reader",
          userId: currentUserId,
        });
        alert(
          "무드보드를 생성하는 중 오류가 발생했습니다: " +
            (error.message || "알 수 없는 오류")
        );
        return;
      }
    }

    // Creator(Supabase Auth 세션이 있는 경우)는 Supabase로 저장
    console.log("[Editor] Creator 모드: Supabase로 무드보드 저장");

    if (!supabaseClient) {
      console.error("[Editor] Supabase 클라이언트가 없습니다");
      alert("서비스 연결에 실패했습니다. 페이지를 새로고침해주세요.");
      return;
    }

    console.log("[Editor] 무드보드 생성 시작, userId:", currentUserId);

    // 🔥 moodboards 테이블에 저장 (DB 스키마에 맞게 title만 사용)
    const { data, error } = await supabaseClient
      .from("moodboards")
      .insert([
        {
          owner_id: currentUserId,
          title: "새 무드보드",
          description: null,
          is_public: false, // 기본값은 비공개
        },
      ])
      .select()
      .single();

    if (error) {
      // RLS 에러 처리
      if (
        error.code === "42501" ||
        error.message?.includes("row-level security") ||
        error.message?.includes("RLS")
      ) {
        console.error("[Editor] RLS 에러 발생:", error);
        alert("로그인이 필요합니다. 로그인 후 다시 시도해주세요.");
        return;
      }
      throw error;
    }

    // 생성된 UUID를 무드보드 id로 사용 (Supabase가 자동 생성한 UUID)
    currentMoodboardId = data.id;

    // UUID 검증: 생성된 ID가 UUID인지 확인
    if (!isValidUUID(data.id)) {
      console.error("[Editor] 생성된 ID가 UUID 형식이 아닙니다:", data.id);
      alert("무드보드 생성 중 오류가 발생했습니다.");
      return;
    }

    // URL에 UUID를 쿼리 파라미터로 추가
    window.history.replaceState({}, "", `?id=${data.id}`);
    const titleEl = document.getElementById("editorTitle");
    if (titleEl) {
      titleEl.textContent = data.title || "무드보드 편집";
    }

    console.log("[Editor] 무드보드 생성 완료, UUID:", data.id);
  } catch (error) {
    logError("createNewMoodboard - Creator 모드", error, {
      mode: "Creator",
      userId: currentUserId,
      errorCode: error.code,
    });
    // RLS 에러 처리
    if (
      error.code === "42501" ||
      error.message?.includes("row-level security") ||
      error.message?.includes("RLS")
    ) {
      alert("로그인이 필요합니다. 로그인 후 다시 시도해주세요.");
    } else {
      alert(
        "무드보드를 생성하는 중 오류가 발생했습니다: " +
          (error.message || "알 수 없는 오류")
      );
    }
  }
}

async function loadMoodboard(id, isEdit = true, isView = false) {
  try {
    // UUID 검증: UUID 형식이 아니면 차단
    if (!isValidUUID(id)) {
      console.error("[Editor] 잘못된 ID 형식:", id);
      showInvalidLinkUI();
      return;
    }

    // 🔥 moodboards 테이블에서 무드보드 로드 (UUID만 사용)
    const { data, error } = await supabaseClient
      .from("moodboards")
      .select("*")
      .eq("id", id)
      .single();

    if (error) {
      logError("loadMoodboard - Supabase 쿼리 오류", error, {
        id,
        isEdit,
        isView,
      });
      showInvalidLinkUI();
      return;
    }

    if (!data) {
      logError(
        "loadMoodboard - 데이터 없음",
        new Error("존재하지 않는 무드보드"),
        { id }
      );
      showInvalidLinkUI();
      return;
    }

    // 권한 확인: 편집 모드인데 현재 사용자가 소유자가 아니면 보기 모드로 다운그레이드
    if (isEdit && currentUserId && data.owner_id !== currentUserId) {
      console.warn("[Editor] 권한 없음: 소유자가 아니므로 보기 모드로 전환");
      isEdit = false;
      isView = true;
      // URL도 업데이트
      window.history.replaceState({}, "", `?id=${id}&view=true`);
    }

    // 편집/보기 모드에 따라 UI 조정
    if (isView || !isEdit) {
      // 보기 모드: 툴바/저장 버튼 숨김 또는 비활성화
      const editorTools = document.getElementById("editorTools");
      const saveBtns = document.querySelectorAll(
        ".save-btn, .action-btn.primary"
      );
      const resetBtn = document.querySelector(".reset-btn");

      if (editorTools) editorTools.style.display = "none";
      saveBtns.forEach((btn) => (btn.style.display = "none"));
      if (resetBtn) resetBtn.style.display = "none";

      // 블록 편집 비활성화
      document.body.classList.add("view-mode");
    } else {
      // 편집 모드: 모든 도구 활성화
      const editorTools = document.getElementById("editorTools");
      const saveBtns = document.querySelectorAll(
        ".save-btn, .action-btn.primary"
      );
      const resetBtn = document.querySelector(".reset-btn");

      if (editorTools) editorTools.style.display = "flex";
      saveBtns.forEach((btn) => (btn.style.display = "block"));
      if (resetBtn) resetBtn.style.display = "block";

      document.body.classList.remove("view-mode");
    }

    // 무드보드 정보 설정
    const titleEl = document.getElementById("editorTitle");
    if (titleEl) {
      titleEl.textContent = data.title || "무드보드 편집";
    }

    // blocks는 moodboard_blocks 테이블에서 별도로 로드 (loadBlocks에서 처리)
    blocks = [];
  } catch (error) {
    logError("loadMoodboard", error, { id, isEdit, isView });
    alert(
      "무드보드를 불러오는 중 오류가 발생했습니다: " +
        (error.message || "알 수 없는 오류")
    );
  }
}

async function loadBlocks(moodboardId) {
  try {
    // UUID 검증: UUID가 아니면 쿼리하지 않음
    if (!isValidUUID(moodboardId)) {
      console.error("[Editor] 잘못된 무드보드 ID:", moodboardId);
      blocks = [];
      return;
    }

    // 🔥 moodboard_blocks 테이블에서 blocks 가져오기 (UUID만 사용)
    const { data, error } = await supabaseClient
      .from("moodboard_blocks")
      .select("*")
      .eq("moodboard_id", moodboardId)
      .order("order_index", { ascending: true });

    if (error) throw error;

    if (data && Array.isArray(data)) {
      // moodboard_blocks 테이블 구조에 맞게 변환
      blocks = data.map((block, index) => ({
        id: block.id,
        moodboard_id: block.moodboard_id,
        type: block.block_type, // block_type → type
        cut_id: block.cut_id,
        title: block.title,
        content: block.content || block.title, // content 또는 title
        emoji: block.emoji,
        span: block.span || 6,
        order_index: block.order_index || index,
        // 위치/크기 정보는 meta JSONB에 저장되어 있을 수 있음
        x: block.meta?.x || 0.3,
        y: block.meta?.y || 0.3,
        w: block.meta?.w || 0.3,
        h: block.meta?.h || 0.3,
        z_index: block.order_index || index + 1,
        rotation: block.meta?.rotation || 0,
        style: block.meta?.style || {},
        // 슬롯 내부 조절 속성
        slotId: block.meta?.slotId || null,
        slotOffsetX: block.meta?.slotOffsetX || 0,
        slotOffsetY: block.meta?.slotOffsetY || 0,
        slotScale: block.meta?.slotScale || 1.0,
      }));
    } else {
      blocks = [];
    }

    console.log(`[Editor] ${blocks.length}개의 블록을 로드했습니다`);
  } catch (error) {
    logError("loadBlocks", error, { moodboardId });
    blocks = [];
  }
}

// Reader 모드 무드보드 로드 함수
async function loadReaderMoodboard(id, isEdit = true, isView = false) {
  try {
    const { db } = await import("/js/firebase_init.js");
    const { doc, getDoc } = await import(
      "https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore.js"
    );

    const moodboardRef = doc(db, "reader_moodboards", id);
    const moodboardSnap = await getDoc(moodboardRef);

    if (!moodboardSnap.exists()) {
      logError(
        "loadReaderMoodboard - 문서 없음",
        new Error("존재하지 않는 무드보드"),
        { id }
      );
      showInvalidLinkUI();
      return;
    }

    const data = moodboardSnap.data();

    // 권한 확인: 편집 모드인데 현재 사용자가 소유자가 아니면 보기 모드로 다운그레이드
    if (isEdit && currentUserId && data.owner_id !== currentUserId) {
      console.warn("[Editor] 권한 없음: 소유자가 아니므로 보기 모드로 전환");
      isEdit = false;
      isView = true;
      // URL도 업데이트
      window.history.replaceState({}, "", `?id=${id}&reader=1&view=true`);
    }

    // 편집/보기 모드에 따라 UI 조정
    if (isView || !isEdit) {
      // 보기 모드: 툴바/저장 버튼 숨김 또는 비활성화
      const editorTools = document.getElementById("editorTools");
      const saveBtns = document.querySelectorAll(
        ".save-btn, .action-btn.primary"
      );
      const resetBtn = document.querySelector(".reset-btn");

      if (editorTools) editorTools.style.display = "none";
      saveBtns.forEach((btn) => (btn.style.display = "none"));
      if (resetBtn) resetBtn.style.display = "none";

      // 블록 편집 비활성화
      document.body.classList.add("view-mode");
    } else {
      // 편집 모드: 모든 도구 활성화
      const editorTools = document.getElementById("editorTools");
      const saveBtns = document.querySelectorAll(
        ".save-btn, .action-btn.primary"
      );
      const resetBtn = document.querySelector(".reset-btn");

      if (editorTools) editorTools.style.display = "flex";
      saveBtns.forEach((btn) => (btn.style.display = "block"));
      if (resetBtn) resetBtn.style.display = "block";

      document.body.classList.remove("view-mode");
    }

    // 무드보드 정보 설정
    const titleEl = document.getElementById("editorTitle");
    if (titleEl) {
      titleEl.textContent = data.title || "무드보드 편집";
    }

    // blocks는 별도로 로드 (loadReaderBlocks에서 처리)
    blocks = [];
  } catch (error) {
    console.error("[Editor] Reader 무드보드 로드 오류:", error);
    alert(
      "무드보드를 불러오는 중 오류가 발생했습니다: " +
        (error.message || "알 수 없는 오류")
    );
  }
}

// Reader 모드 블록 로드 함수
async function loadReaderBlocks(moodboardId) {
  try {
    const { db } = await import("/js/firebase_init.js");
    const { collection, getDocs, query, orderBy } = await import(
      "https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore.js"
    );

    const blocksRef = collection(
      db,
      "reader_moodboards",
      moodboardId,
      "blocks"
    );
    const q = query(blocksRef, orderBy("order_index", "asc"));
    const snap = await getDocs(q);

    if (!snap.empty) {
      blocks = snap.docs.map((docSnap, index) => {
        const blockData = docSnap.data();
        return {
          id: docSnap.id,
          moodboard_id: moodboardId,
          type: blockData.block_type || blockData.type,
          cut_id: blockData.cut_id || null,
          title: blockData.title || null,
          content: blockData.content || blockData.title || "",
          emoji: blockData.emoji || null,
          span: blockData.span || 6,
          order_index: blockData.order_index || index,
          // 위치/크기 정보는 meta에 저장되어 있을 수 있음
          x: blockData.meta?.x || blockData.x || 0.3,
          y: blockData.meta?.y || blockData.y || 0.3,
          w: blockData.meta?.w || blockData.w || 0.3,
          h: blockData.meta?.h || blockData.h || 0.3,
          z_index:
            blockData.meta?.z_index || blockData.order_index || index + 1,
          rotation: blockData.meta?.rotation || blockData.rotation || 0,
          style: blockData.meta?.style || blockData.style || {},
        };
      });
    } else {
      blocks = [];
    }

    console.log(
      `[Editor] Reader 모드: ${blocks.length}개의 블록을 로드했습니다`
    );
  } catch (error) {
    logError("loadReaderBlocks", error, { moodboardId });
    blocks = [];
  }
}

// =========================
// RENDERING
// =========================

function renderBlocks() {
  try {
    const canvas = document.getElementById("canvas");
    if (!canvas) {
      logError("renderBlocks", new Error("canvas 요소를 찾을 수 없습니다"));
      return;
    }

    // 템플릿형이 아닌 경우에만 전체 초기화
    if (editorMode !== "template") {
      // 슬롯이 아닌 블록만 제거 (슬롯은 유지)
      const existingBlocks = canvas.querySelectorAll(
        ".canvas-block:not(.template-slot *)"
      );
      existingBlocks.forEach((el) => el.remove());
    }

    const canvasRect = canvas.getBoundingClientRect();
    const canvasWidth = canvasRect.width - 40; // padding 제외
    const canvasHeight = canvasRect.height; // 고정 높이 사용

    blocks.forEach((block) => {
      try {
        // 템플릿형이고 슬롯에 속한 블록인 경우
        if (editorMode === "template" && block.slotId) {
          // 슬롯 내부에 블록 렌더링 (renderBlockInSlot 사용)
          renderBlockInSlot(block.id, block.slotId);
        } else {
          // 자유형 또는 일반 블록
          const blockElement = createBlockElement(
            block,
            canvasWidth,
            canvasHeight
          );
          canvas.appendChild(blockElement);

          // 길게 누르기 이벤트 추가
          setupLongPressActionSheet(block.id);
        }
      } catch (error) {
        logError("renderBlocks - 블록 렌더링", error, {
          blockId: block.id,
          blockType: block.type,
        });
      }
    });

    // Canvas 높이는 절대 변경하지 않음 (고정)
  } catch (error) {
    logError("renderBlocks", error, { blocksCount: blocks.length });
  }
}

function createBlockElement(block, canvasWidth, canvasHeight) {
  const div = document.createElement("div");
  div.className = `canvas-block block-${block.type}`;
  div.dataset.id = block.id;

  // 위치 및 크기 계산 (0~1 비율을 픽셀로 변환)
  const x = block.x * canvasWidth;
  const y = block.y * canvasHeight;
  const w = block.w * canvasWidth;
  const h = block.h * canvasHeight;

  div.style.left = `${x}px`;
  div.style.top = `${y}px`;
  div.style.width = `${w}px`;
  div.style.height = `${h}px`;
  div.style.zIndex = block.z_index || 1;
  div.style.transform = `rotate(${block.rotation || 0}deg)`;

  // Style JSON을 inline style로 변환 (block 객체 전달하여 자동 꾸밈 적용)
  if (block.style && typeof block.style === "object") {
    applyBlockStyle(div, block.style, block);
  } else {
    // style이 없어도 자동 꾸밈 적용
    applyBlockStyle(div, {}, block);
  }

  // 타입별 콘텐츠 렌더링
  renderBlockContent(div, block);

  // 템플릿 고정 데코는 리사이즈/회전 핸들 제거
  const isDecoration = block.id?.startsWith("decoration-");
  const isTemplateFixed = editorMode === "template" && isDecoration;

  // 템플릿 데코 요소 처리: 선택/드래그/삭제 불가
  if (isDecoration) {
    div.classList.add("template-decoration");
    div.style.pointerEvents = "none"; // 선택/드래그 불가
    div.style.opacity = "0.7"; // 시각적으로 구분
    div.style.zIndex = "1"; // 항상 뒤 레이어
    // 삭제 버튼 추가하지 않음
  } else {
    // 일반 블록: 삭제 버튼은 selectBlock에서 동적으로 추가됨
    // 카메라 아이콘, 큰 X 버튼, 설정 버튼 모두 제거 (요구사항)
  }

  // 이벤트 리스너
  attachBlockEventListeners(div, block);

  return div;
}

function applyBlockStyle(element, style, block) {
  if (!style || typeof style !== "object") style = {};

  // 폰트 스타일
  if (style.fontSize) element.style.fontSize = `${style.fontSize}px`;
  if (style.fontWeight) element.style.fontWeight = style.fontWeight;
  if (style.fontFamily) element.style.fontFamily = style.fontFamily;
  if (style.color) element.style.color = style.color;
  if (style.textAlign) element.style.textAlign = style.textAlign;
  if (style.lineHeight) element.style.lineHeight = style.lineHeight;

  // 배경
  if (style.backgroundColor)
    element.style.backgroundColor = style.backgroundColor;
  if (style.backgroundImage)
    element.style.backgroundImage = `url(${style.backgroundImage})`;
  if (style.backgroundSize) element.style.backgroundSize = style.backgroundSize;

  // 테두리
  if (style.borderWidth) element.style.borderWidth = `${style.borderWidth}px`;
  if (style.borderColor) element.style.borderColor = style.borderColor;
  if (style.borderStyle) element.style.borderStyle = style.borderStyle;

  // 꾸밈 자동화: border-radius 통일 (이미지/컷 블록에만)
  if (block && (block.type === "image" || block.type === "cut")) {
    const borderRadius = style.borderRadius || 12; // 기본값 12px
    element.style.borderRadius = `${borderRadius}px`;
  } else if (style.borderRadius) {
    element.style.borderRadius = `${style.borderRadius}px`;
  }

  // 꾸밈 자동화: 자동 그림자 적용 (이미지/컷 블록에만)
  if (block && (block.type === "image" || block.type === "cut")) {
    if (!style.boxShadow) {
      // 기본 그림자: 부드러운 그림자 효과
      element.style.boxShadow =
        "0 4px 12px rgba(0, 0, 0, 0.1), 0 2px 4px rgba(0, 0, 0, 0.06)";
    } else {
      element.style.boxShadow = style.boxShadow;
    }
  } else if (style.boxShadow) {
    element.style.boxShadow = style.boxShadow;
  }

  // 필터
  if (style.filter) element.style.filter = style.filter;
  if (style.opacity !== undefined) element.style.opacity = style.opacity;
}

function renderBlockContent(element, block) {
  switch (block.type) {
    case "image":
    case "cut":
      if (block.style?.imageUrl || block.url) {
        const img = document.createElement("img");
        img.src = block.style?.imageUrl || block.url;
        img.alt = "이미지";
        img.style.width = "100%";
        img.style.height = "100%";
        img.style.objectFit = block.style?.objectFit || "cover";
        img.style.pointerEvents = "none";
        element.appendChild(img);

        // 그림자 효과
        if (block.style?.shadow) {
          element.classList.add("has-shadow");
        }
      } else {
        const placeholder = document.createElement("div");
        placeholder.style.width = "100%";
        placeholder.style.height = "100%";
        placeholder.style.display = "flex";
        placeholder.style.alignItems = "center";
        placeholder.style.justifyContent = "center";
        placeholder.style.background = "#f0f0f0";
        placeholder.style.color = "#999";
        placeholder.textContent = "이미지 없음";
        element.appendChild(placeholder);
      }
      break;

    case "text":
      // 텍스트 블록 컨테이너
      const textContainer = document.createElement("div");
      textContainer.className = "text-block-container";

      const textDiv = document.createElement("div");
      textDiv.className = "block-text";
      const initialText = block.style?.text || block.content || "";
      textDiv.textContent = initialText || "텍스트를 입력하세요";
      textDiv.contentEditable = true;

      // 폰트 크기 적용
      if (block.style?.fontSize) {
        textDiv.style.fontSize = `${block.style.fontSize}px`;
      }
      if (block.style?.fontFamily) {
        textDiv.style.fontFamily = block.style.fontFamily;
      }
      if (block.style?.fontWeight) {
        textDiv.style.fontWeight = block.style.fontWeight;
      }
      if (block.style?.textAlign) {
        textDiv.style.textAlign = block.style.textAlign;
      }

      // 플레이스홀더 스타일 적용
      if (!initialText) {
        textDiv.classList.add("placeholder");
      }

      // 드래그 핸들 영역 (텍스트 영역 외부)
      const dragHandle = document.createElement("div");
      dragHandle.className = "text-drag-handle";
      dragHandle.innerHTML = "⋮⋮";

      // 포커스 시 플레이스홀더 제거
      textDiv.addEventListener("focus", () => {
        if (textDiv.textContent === "텍스트를 입력하세요") {
          textDiv.textContent = "";
          textDiv.classList.remove("placeholder");
        }
      });

      // 블러 시 플레이스홀더 복원
      textDiv.addEventListener("blur", () => {
        const block = blocks.find((b) => b.id === element.dataset.id);
        if (block) {
          const text = textDiv.textContent.trim();
          if (!text) {
            textDiv.textContent = "텍스트를 입력하세요";
            textDiv.classList.add("placeholder");
            block.style = { ...block.style, text: "" };
            block.content = "";
          } else {
            block.style = { ...block.style, text: text };
            block.content = text;
            updateBlockStyle(block.id, { text: text });
          }
        }
      });

      // 텍스트 변경 시 state 업데이트
      textDiv.addEventListener("input", () => {
        const block = blocks.find((b) => b.id === element.dataset.id);
        if (block) {
          const text = textDiv.textContent;
          if (text !== "텍스트를 입력하세요") {
            textDiv.classList.remove("placeholder");
            block.style = { ...block.style, text: text };
            block.content = text;
          }
        }
      });

      textContainer.appendChild(dragHandle);
      textContainer.appendChild(textDiv);
      element.appendChild(textContainer);
      // 텍스트 블록 설정 버튼 제거 (요구사항)
      break;

    case "emoji":
      // canvas-block 클래스 유지하면서 block-emoji 추가
      element.classList.add("block-emoji");
      element.textContent = block.style?.emoji || block.content || "😊";
      element.style.fontSize = `${block.style?.fontSize || 48}px`;
      break;

    case "color":
    case "shape":
      element.className = "block-shape";
      // 색상 블록은 배경색만 있으면 됨
      if (block.style?.backgroundColor || block.style?.background) {
        element.style.background =
          block.style.backgroundColor || block.style.background;
      }
      break;
  }
}

// =========================
// EVENT LISTENERS
// =========================

function attachBlockEventListeners(element, block) {
  // 클릭: 선택
  let lastClickTime = 0;
  element.addEventListener("click", (e) => {
    // 삭제 버튼 클릭은 제외
    if (
      e.target.closest(".block-delete-btn") ||
      e.target.closest(".layer-delete-btn")
    ) {
      return;
    }
    // 텍스트 입력 영역 클릭은 선택만 하고 드래그 방지
    if (
      e.target.isContentEditable ||
      e.target.closest('[contenteditable="true"]')
    ) {
      e.stopPropagation();
      selectBlock(block.id);
      return;
    }
    e.stopPropagation();

    // 더블탭: 이미지 레이어의 경우 꽉 채우기/맞추기 전환
    const currentTime = Date.now();
    if (
      currentTime - lastClickTime < 300 &&
      (block.type === "image" || block.type === "cut")
    ) {
      toggleImageFit(block.id);
      lastClickTime = 0;
    } else {
      lastClickTime = currentTime;
      selectBlock(block.id);
    }
  });

  // 이미지 레이어 핀치 확대/축소
  if (block.type === "image" || block.type === "cut") {
    let touchStartDistance = 0;
    let touchStartScale = 1.0;
    let isPinching = false;

    element.addEventListener("touchstart", (e) => {
      if (e.touches.length === 2) {
        e.preventDefault();
        isPinching = true;
        const touch1 = e.touches[0];
        const touch2 = e.touches[1];
        touchStartDistance = Math.hypot(
          touch2.clientX - touch1.clientX,
          touch2.clientY - touch1.clientY
        );
        touchStartScale = block.scale || 1.0;
      }
    });

    element.addEventListener("touchmove", (e) => {
      if (e.touches.length === 2 && isPinching) {
        e.preventDefault();
        const touch1 = e.touches[0];
        const touch2 = e.touches[1];
        const distance = Math.hypot(
          touch2.clientX - touch1.clientX,
          touch2.clientY - touch1.clientY
        );
        const scaleDelta = distance / touchStartDistance;
        const newScale = Math.max(
          0.5,
          Math.min(2.0, touchStartScale * scaleDelta)
        );

        block.scale = newScale;
        element.style.transform = `rotate(${
          block.rotation || 0
        }deg) scale(${newScale})`;
      }
    });

    element.addEventListener("touchend", () => {
      isPinching = false;
    });
  }

  // 드래그 시작 (Pointer Events 통합)
  element.addEventListener("pointerdown", (e) => {
    // 텍스트 입력 영역은 제외
    if (
      e.target.isContentEditable ||
      e.target.closest('[contenteditable="true"]')
    ) {
      return;
    }
    handleBlockPointerDown(e);
  });

  // 기존 마우스/터치 이벤트도 유지 (호환성)
  element.addEventListener("mousedown", handleBlockMouseDown);
  element.addEventListener("touchstart", handleBlockTouchStart, {
    passive: false,
  });

  // 리사이즈 핸들 (4개 코너)
  const resizeHandles = element.querySelectorAll(".resize-handle");
  resizeHandles.forEach((handle, index) => {
    const positions = ["nw", "ne", "sw", "se"];
    handle.classList.add(positions[index]);

    handle.addEventListener("pointerdown", (e) => {
      e.stopPropagation();
      e.preventDefault();
      startResize(block.id, e, positions[index]);
    });
    handle.addEventListener("mousedown", (e) => {
      e.stopPropagation();
      e.preventDefault();
      startResize(block.id, e, positions[index]);
    });
    handle.addEventListener("touchstart", (e) => {
      e.stopPropagation();
      e.preventDefault();
      startResize(block.id, e.touches[0], positions[index]);
    });
  });

  // 회전 핸들
  const rotateHandle = element.querySelector(".rotate-handle");
  if (rotateHandle) {
    rotateHandle.addEventListener("pointerdown", (e) => {
      e.stopPropagation();
      startRotate(block.id, e);
    });
    rotateHandle.addEventListener("mousedown", (e) => {
      e.stopPropagation();
      startRotate(block.id, e);
    });
    rotateHandle.addEventListener("touchstart", (e) => {
      e.stopPropagation();
      e.preventDefault();
      startRotate(block.id, e.touches[0]);
    });
  }
}

// Pointer Events 통합 핸들러
function handleBlockPointerDown(e) {
  const blockElement = e.target.closest(".canvas-block");
  if (!blockElement) return;

  // 설정 버튼 클릭은 제외
  if (e.target.closest(".block-settings-btn")) {
    return;
  }

  // 삭제 버튼 클릭은 제외
  if (
    e.target.closest(".block-delete-btn") ||
    e.target.closest(".layer-delete-btn")
  ) {
    return;
  }

  // 텍스트 드래그 핸들 클릭 시 드래그 시작
  if (e.target.closest(".text-drag-handle")) {
    e.preventDefault();
    const blockId = blockElement.dataset.id;
    selectBlock(blockId);
    isDragging = true;
    const canvas = document.getElementById("canvas");
    const canvasRect = canvas.getBoundingClientRect();
    dragStart.x = e.clientX - canvasRect.left;
    dragStart.y = e.clientY - canvasRect.top;
    const block = blocks.find((b) => b.id === blockId);
    if (block) {
      const canvasWidth = canvasRect.width - 40;
      const canvasHeight = canvasRect.height;
      blockStartPos.x = block.x * canvasWidth;
      blockStartPos.y = block.y * canvasHeight;
    }
    blockElement.classList.add("dragging");
    blockElement.setPointerCapture(e.pointerId);
    return;
  }

  // 텍스트 입력 영역 클릭은 드래그 방지
  const textDiv = blockElement.querySelector('[contenteditable="true"]');
  if (
    textDiv &&
    textDiv.contains(e.target) &&
    !e.target.closest(".text-drag-handle")
  ) {
    return; // 텍스트 입력만 허용
  }

  e.preventDefault();
  const blockId = blockElement.dataset.id;
  selectBlock(blockId);

  isDragging = true;
  const canvas = document.getElementById("canvas");
  const canvasRect = canvas.getBoundingClientRect();
  dragStart.x = e.clientX - canvasRect.left;
  dragStart.y = e.clientY - canvasRect.top;

  const block = blocks.find((b) => b.id === blockId);
  if (block) {
    const canvasWidth = canvasRect.width - 40;
    const canvasHeight = canvasRect.height;
    blockStartPos.x = block.x * canvasWidth;
    blockStartPos.y = block.y * canvasHeight;
  }

  blockElement.classList.add("dragging");
  blockElement.setPointerCapture(e.pointerId);
}

function initializeEventListeners() {
  // 캔버스 클릭: 선택 해제 또는 드래그앤드롭 배치
  const canvas = document.getElementById("canvas");
  if (canvas) {
    canvas.addEventListener("click", (e) => {
      if (e.target === canvas || e.target.id === "emptyState") {
        // 드래그 모드일 때는 블록 배치
        if (canvas.classList.contains("drag-mode") && pendingBlockForDrag) {
          placeBlockAtPosition(e.clientX, e.clientY);
          return;
        }
        selectBlock(null);
      }
    });

    // 드래그 모드에서 마우스 이동 시 미리보기
    canvas.addEventListener("mousemove", (e) => {
      if (canvas.classList.contains("drag-mode") && pendingBlockForDrag) {
        canvas.style.cursor = "crosshair";
      }
    });
  }

  // 전역 마우스/터치/Pointer 이벤트
  document.addEventListener("mousemove", handleMouseMove);
  document.addEventListener("mouseup", handleMouseUp);
  document.addEventListener("touchmove", handleTouchMove, { passive: false });
  document.addEventListener("touchend", handleTouchEnd);
  // Pointer Events 통합
  document.addEventListener("pointermove", handlePointerMove);
  document.addEventListener("pointerup", handlePointerUp);
}

// 드래그앤드롭으로 블록 배치
function placeBlockAtPosition(clientX, clientY) {
  if (!pendingBlockForDrag) return;

  const canvas = document.getElementById("canvas");
  if (!canvas) return;

  const canvasRect = canvas.getBoundingClientRect();
  const canvasWidth = canvasRect.width - 40;
  const canvasHeight = canvasRect.height;

  // 클릭 위치를 비율로 변환
  const x = (clientX - canvasRect.left - 20) / canvasWidth;
  const y = (clientY - canvasRect.top - 20) / canvasHeight;

  // 기본 크기
  const defaultW = pendingBlockForDrag.type === "image" ? 0.3 : 0.2;
  const defaultH = pendingBlockForDrag.type === "image" ? 0.4 : 0.2;

  const newBlock = {
    ...pendingBlockForDrag,
    x: Math.max(0, Math.min(1 - defaultW, x - defaultW / 2)),
    y: Math.max(0, Math.min(1 - defaultH, y - defaultH / 2)),
    w: defaultW,
    h: defaultH,
    z_index: blocks.length + 1,
    rotation: 0,
    style: {
      ...getDefaultStyle(pendingBlockForDrag.type),
      ...pendingBlockForDrag.style,
    },
  };

  createBlock(newBlock);

  // 드래그 모드 해제
  pendingBlockForDrag = null;
  canvas.classList.remove("drag-mode");
  canvas.style.cursor = "";
}

function handlePointerMove(e) {
  if (isDragging && selectedBlockId) {
    updateBlockPosition(e.clientX, e.clientY);
  } else if (isResizing && selectedBlockId) {
    updateBlockSize(e.clientX, e.clientY);
  } else if (isRotating && selectedBlockId) {
    updateBlockRotation(e.clientX, e.clientY);
  }
}

function handlePointerUp(e) {
  if (isDragging || isResizing || isRotating) {
    const blockElement = document.querySelector(
      `[data-id="${selectedBlockId}"]`
    );
    if (blockElement && selectedBlockId) {
      commitBlockRect(selectedBlockId, blockElement);
      blockElement.classList.remove("dragging", "resizing", "rotating");
      if (blockElement.releasePointerCapture) {
        blockElement.releasePointerCapture(e.pointerId);
      }
    }
  }
  isDragging = false;
  isResizing = false;
  isRotating = false;
}

// =========================
// DRAG & DROP
// =========================

function handleBlockMouseDown(e) {
  const blockElement = e.target.closest(".canvas-block");
  if (!blockElement) return;

  // 설정 버튼 클릭은 제외
  if (e.target.closest(".block-settings-btn")) {
    return;
  }

  // 텍스트 드래그 핸들 클릭 시 드래그 시작
  if (e.target.closest(".text-drag-handle")) {
    e.preventDefault();
    startDragFromElement(blockElement, e);
    return;
  }

  // 텍스트 입력 영역 클릭은 드래그 방지
  const textDiv = blockElement.querySelector('[contenteditable="true"]');
  if (
    textDiv &&
    textDiv.contains(e.target) &&
    !e.target.closest(".text-drag-handle")
  ) {
    return; // 텍스트 입력만 허용
  }

  e.preventDefault();
  startDragFromElement(blockElement, e);
}

function startDragFromElement(blockElement, e) {
  const blockId = blockElement.dataset.id;

  // 템플릿 고정 데코는 이동 불가
  const block = blocks.find((b) => b.id === blockId);
  if (block && block.id?.startsWith("decoration-")) {
    return; // 데코는 이동 불가
  }

  selectBlock(blockId);

  isDragging = true;
  const canvas = document.getElementById("canvas");
  const canvasRect = canvas.getBoundingClientRect();
  dragStart.x = e.clientX - canvasRect.left;
  dragStart.y = e.clientY - canvasRect.top;

  if (block) {
    const canvasWidth = canvasRect.width - 40;
    const canvasHeight = canvasRect.height;
    blockStartPos.x = block.x * canvasWidth;
    blockStartPos.y = block.y * canvasHeight;
  }

  blockElement.classList.add("dragging");
}

function handleBlockTouchStart(e) {
  const blockElement = e.target.closest(".canvas-block");
  if (!blockElement) return;

  // 설정 버튼 클릭은 제외
  if (e.target.closest(".block-settings-btn")) {
    return;
  }

  if (e.touches.length === 1) {
    // 텍스트 편집 중에는 드래그 방지
    const isContentEditable =
      e.target.isContentEditable ||
      e.target.closest('[contenteditable="true"]') ||
      blockElement
        .querySelector('[contenteditable="true"]')
        ?.contains(e.target);

    if (isContentEditable) {
      // 텍스트 입력 모드: 드래그 방지, 포커스 허용
      e.stopPropagation();
      return;
    }

    e.preventDefault();
    const blockId = blockElement.dataset.id;
    selectBlock(blockId);

    isDragging = true;
    const canvas = document.getElementById("canvas");
    const canvasRect = canvas.getBoundingClientRect();
    const touch = e.touches[0];
    dragStart.x = touch.clientX - canvasRect.left;
    dragStart.y = touch.clientY - canvasRect.top;

    const block = blocks.find((b) => b.id === blockId);
    if (block) {
      const canvasWidth = canvasRect.width - 40;
      const canvasHeight = canvasRect.height;
      blockStartPos.x = block.x * canvasWidth;
      blockStartPos.y = block.y * canvasHeight;
    }

    blockElement.classList.add("dragging");
  }
}

function handleMouseMove(e) {
  if (isDragging && selectedBlockId) {
    updateBlockPosition(e.clientX, e.clientY);
  } else if (isResizing && selectedBlockId) {
    updateBlockSize(e.clientX, e.clientY);
  } else if (isRotating && selectedBlockId) {
    updateBlockRotation(e.clientX, e.clientY);
  }
}

function handleTouchMove(e) {
  if (e.touches.length === 1) {
    if (isDragging && selectedBlockId) {
      e.preventDefault();
      const touch = e.touches[0];
      updateBlockPosition(touch.clientX, touch.clientY);
    } else if (isResizing && selectedBlockId) {
      e.preventDefault();
      const touch = e.touches[0];
      updateBlockSize(touch.clientX, touch.clientY);
    } else if (isRotating && selectedBlockId) {
      e.preventDefault();
      const touch = e.touches[0];
      updateBlockRotation(touch.clientX, touch.clientY);
    }
  }
}

function handleMouseUp() {
  if (isDragging || isResizing || isRotating) {
    const blockElement = document.querySelector(
      `[data-id="${selectedBlockId}"]`
    );
    if (blockElement && selectedBlockId) {
      // DOM 변경사항을 state(blocks)에 반영
      commitBlockRect(selectedBlockId, blockElement);
      blockElement.classList.remove("dragging", "resizing", "rotating");
    }
  }
  isDragging = false;
  isResizing = false;
  isRotating = false;
}

function handleTouchEnd() {
  if (isDragging || isResizing || isRotating) {
    const blockElement = document.querySelector(
      `[data-id="${selectedBlockId}"]`
    );
    if (blockElement && selectedBlockId) {
      // DOM 변경사항을 state(blocks)에 반영
      commitBlockRect(selectedBlockId, blockElement);
      blockElement.classList.remove("dragging", "resizing", "rotating");
    }
  }
  isDragging = false;
  isResizing = false;
  isRotating = false;
}

function updateBlockPosition(clientX, clientY) {
  const canvas = document.getElementById("canvas");
  const canvasRect = canvas.getBoundingClientRect();
  const canvasWidth = canvasRect.width - 40;
  const canvasHeight = canvasRect.height;

  const deltaX = clientX - canvasRect.left - dragStart.x;
  const deltaY = clientY - canvasRect.top - dragStart.y;

  const newX = Math.max(0, Math.min(blockStartPos.x + deltaX, canvasWidth));
  const newY = Math.max(0, Math.min(blockStartPos.y + deltaY, canvasHeight));

  const blockElement = document.querySelector(`[data-id="${selectedBlockId}"]`);
  if (blockElement) {
    blockElement.style.left = `${newX}px`;
    blockElement.style.top = `${newY}px`;
  }
}

function updateBlockSize(clientX, clientY) {
  const canvas = document.getElementById("canvas");
  const canvasRect = canvas.getBoundingClientRect();
  const blockElement = document.querySelector(`[data-id="${selectedBlockId}"]`);
  if (!blockElement) return;

  const block = blocks.find((b) => b.id === selectedBlockId);
  if (!block) return;

  const canvasWidth = canvasRect.width - 40;
  const canvasHeight = canvasRect.height;

  const deltaX = clientX - canvasRect.left - dragStart.x;
  const deltaY = clientY - canvasRect.top - dragStart.y;

  let newW = blockStartSize.w;
  let newH = blockStartSize.h;
  let newX = blockStartPos.x;
  let newY = blockStartPos.y;

  // 코너에 따라 크기 조정 방향 결정
  switch (resizeCorner) {
    case "se": // 우하단
      newW = blockStartSize.w + deltaX;
      newH = blockStartSize.h + deltaY;
      break;
    case "sw": // 좌하단
      newW = blockStartSize.w - deltaX;
      newH = blockStartSize.h + deltaY;
      newX = blockStartPos.x + deltaX;
      break;
    case "ne": // 우상단
      newW = blockStartSize.w + deltaX;
      newH = blockStartSize.h - deltaY;
      newY = blockStartPos.y + deltaY;
      break;
    case "nw": // 좌상단
      newW = blockStartSize.w - deltaX;
      newH = blockStartSize.h - deltaY;
      newX = blockStartPos.x + deltaX;
      newY = blockStartPos.y + deltaY;
      break;
  }

  // 모바일 환경을 고려한 최소/최대 크기 제한 (캔버스 크기의 10% ~ 90%)
  const minSize = Math.min(canvasWidth, canvasHeight) * 0.1;
  const maxW = canvasWidth * 0.9;
  const maxH = canvasHeight * 0.9;

  newW = Math.max(minSize, Math.min(newW, maxW));
  newH = Math.max(minSize, Math.min(newH, maxH));

  // 위치 제한
  newX = Math.max(0, Math.min(newX, canvasWidth - newW));
  newY = Math.max(0, Math.min(newY, canvasHeight - newH));

  blockElement.style.width = `${newW}px`;
  blockElement.style.height = `${newH}px`;
  blockElement.style.left = `${newX}px`;
  blockElement.style.top = `${newY}px`;
}

function updateBlockRotation(clientX, clientY) {
  const canvas = document.getElementById("canvas");
  const canvasRect = canvas.getBoundingClientRect();
  const blockElement = document.querySelector(`[data-id="${selectedBlockId}"]`);
  if (!blockElement) return;

  const block = blocks.find((b) => b.id === selectedBlockId);
  if (!block) return;

  const blockRect = blockElement.getBoundingClientRect();
  const centerX = blockRect.left + blockRect.width / 2;
  const centerY = blockRect.top + blockRect.height / 2;

  const angle =
    Math.atan2(clientY - centerY, clientX - centerX) * (180 / Math.PI);
  const rotation = angle + 90; // 0도가 위쪽을 가리키도록 조정

  blockElement.style.transform = `rotate(${rotation}deg)`;
  block.rotation = rotation;
}

// DOM 변경사항을 state(blocks)에 반영하는 함수
function commitBlockRect(blockId, blockElement) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block || !blockElement) return;

  const canvas = document.getElementById("canvas");
  if (!canvas) return;

  const canvasRect = canvas.getBoundingClientRect();
  const canvasWidth = canvasRect.width - 40;
  const canvasHeight = canvasRect.height;

  // DOM에서 현재 위치/크기 가져오기
  const rect = blockElement.getBoundingClientRect();
  const x = (rect.left - canvasRect.left) / canvasWidth;
  const y = (rect.top - canvasRect.top) / canvasHeight;
  const w = rect.width / canvasWidth;
  const h = rect.height / canvasHeight;

  // state 업데이트
  block.x = Math.max(0, Math.min(1, x));
  block.y = Math.max(0, Math.min(1, y));
  block.w = Math.max(0.05, Math.min(1, w));
  block.h = Math.max(0.05, Math.min(1, h));

  // 회전값도 업데이트 (transform에서 추출)
  const transform = blockElement.style.transform;
  if (transform) {
    const match = transform.match(/rotate\(([^)]+)\)/);
    if (match) {
      const rotation = parseFloat(match[1]);
      if (!isNaN(rotation)) {
        block.rotation = rotation;
      }
    }
  }
}

// =========================
// RESIZE & ROTATE
// =========================

let resizeCorner = "se"; // 기본값: 우하단

function startResize(blockId, e, corner = "se") {
  isResizing = true;
  resizeCorner = corner;
  selectedBlockId = blockId;
  selectBlock(blockId);

  const canvas = document.getElementById("canvas");
  const canvasRect = canvas.getBoundingClientRect();
  dragStart.x = e.clientX - canvasRect.left;
  dragStart.y = e.clientY - canvasRect.top;

  const block = blocks.find((b) => b.id === blockId);
  if (block) {
    const canvasWidth = canvasRect.width - 40;
    const canvasHeight = canvasRect.height;
    blockStartSize.w = block.w * canvasWidth;
    blockStartSize.h = block.h * canvasHeight;
    blockStartPos.x = block.x * canvasWidth;
    blockStartPos.y = block.y * canvasHeight;
  }

  const blockElement = document.querySelector(`[data-id="${blockId}"]`);
  if (blockElement) {
    blockElement.classList.add("resizing");
  }
}

function startRotate(blockId, e) {
  // 템플릿형에서는 회전 금지
  if (editorMode === "template") {
    return;
  }

  // 템플릿 고정 데코는 회전 불가
  const block = blocks.find((b) => b.id === blockId);
  if (block && block.id?.startsWith("decoration-")) {
    return;
  }

  isRotating = true;
  selectedBlockId = blockId;
  selectBlock(blockId);

  const canvas = document.getElementById("canvas");
  const canvasRect = canvas.getBoundingClientRect();
  dragStart.x = e.clientX - canvasRect.left;
  dragStart.y = e.clientY - canvasRect.top;

  const blockElement = document.querySelector(`[data-id="${blockId}"]`);
  if (blockElement) {
    blockElement.classList.add("rotating");
  }
}

// =========================
// SELECTION
// =========================

function selectBlock(blockId) {
  // 템플릿 고정 데코는 선택 불가
  if (blockId) {
    const block = blocks.find((b) => b.id === blockId);
    if (block && block.id?.startsWith("decoration-")) {
      return; // 데코는 선택 불가
    }
  }

  selectedBlockId = blockId;

  // 모든 블록의 선택 상태 제거 및 컨트롤 숨김
  document.querySelectorAll(".canvas-block").forEach((el) => {
    el.classList.remove("selected");
    el.style.outline = "none";
    // 삭제 버튼 숨김
    const deleteBtn = el.querySelector(".layer-delete-btn");
    if (deleteBtn) {
      deleteBtn.style.display = "none";
    }
  });

  // 툴바 UI 업데이트 (레이어 선택 상태 변경 반영)
  if (typeof updateToolbarUI === "function") {
    updateToolbarUI();
  }

  if (blockId) {
    const block = blocks.find((b) => b.id === blockId);
    const blockElement = document.querySelector(`[data-id="${blockId}"]`);
    if (blockElement && block) {
      blockElement.classList.add("selected");
      // 얇은 파란색 outline 표시
      blockElement.style.outline = "2px solid #3b82f6";
      blockElement.style.outlineOffset = "0";

      // 이미지/컷 레이어인 경우 교체/삭제 버튼 표시
      if (block.type === "image" || block.type === "cut") {
        // 기존 컨트롤 제거
        const existingControls = blockElement.querySelector(".cut-controls");
        if (existingControls) existingControls.remove();

        // 컷 컨트롤 생성
        const controls = document.createElement("div");
        controls.className = "cut-controls";
        controls.innerHTML = `
          <button class="cut-replace-btn" title="교체" onclick="event.stopPropagation(); replaceCutImage('${blockId}');">
            <span>🔄</span>
          </button>
          <button class="cut-delete-btn" title="삭제" onclick="event.stopPropagation(); removeCutImage('${blockId}');">
            <span>×</span>
          </button>
        `;
        controls.style.cssText = `
          position: absolute;
          top: 8px;
          right: 8px;
          display: flex;
          gap: 4px;
          z-index: 1000;
          pointer-events: auto;
        `;

        // 버튼 스타일
        const style = document.createElement("style");
        style.textContent = `
          .cut-controls button {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: none;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 0.2s;
          }
          .cut-controls button:active {
            background: rgba(0, 0, 0, 0.9);
          }
          .cut-controls button span {
            display: block;
            line-height: 1;
          }
        `;
        if (!document.querySelector("style[data-cut-controls]")) {
          style.setAttribute("data-cut-controls", "true");
          document.head.appendChild(style);
        }

        blockElement.appendChild(controls);
      } else {
        // 다른 타입은 기존 삭제 버튼만 표시
        let deleteBtn = blockElement.querySelector(".layer-delete-btn");
        if (!deleteBtn) {
          deleteBtn = document.createElement("div");
          deleteBtn.className = "layer-delete-btn";
          deleteBtn.innerHTML = "×";
          deleteBtn.title = "삭제";
          deleteBtn.style.pointerEvents = "auto";
          deleteBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            e.preventDefault();
            deleteBlock(blockId);
          });
          blockElement.appendChild(deleteBtn);
        }
        deleteBtn.style.display = "flex";
      }
    }
  } else {
    // 선택 해제 시 바텀 시트 닫기
    // 툴바 UI 업데이트 (레이어 선택 해제 반영)
    if (typeof updateToolbarUI === "function") {
      updateToolbarUI();
    }
    closeBottomSheet();
  }

  updateLayerPanel();
}

// =========================
// DELETE BLOCK
// =========================

async function deleteBlock(blockId) {
  try {
    if (!blockId) {
      console.warn("[Editor] 삭제할 블록 ID가 없습니다");
      return;
    }

    const block = blocks.find((b) => b.id === blockId);
    if (!block) {
      console.warn("[Editor] 삭제할 블록을 찾을 수 없습니다:", blockId);
      return;
    }

    // Reader 모드: Firestore에서 삭제
    if (isReaderMode) {
      try {
        const { db } = await import("/js/firebase_init.js");
        const { doc, collection, deleteDoc } = await import(
          "https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore.js"
        );

        const blockRef = doc(
          db,
          "reader_moodboards",
          currentMoodboardId,
          "blocks",
          blockId
        );

        await deleteDoc(blockRef);
        console.log("[Editor] Reader 모드: 블록 삭제됨:", blockId);
      } catch (error) {
        logError("deleteBlock - Reader 모드", error, {
          blockId,
          moodboardId: currentMoodboardId,
        });
        alert(
          "블록 삭제 중 오류가 발생했습니다: " +
            (error.message || "알 수 없는 오류")
        );
        return;
      }
    } else {
      // Creator 모드: Supabase에서 삭제
      if (!supabaseClient) {
        alert("서비스 연결에 실패했습니다.");
        return;
      }

      if (!isValidUUID(blockId)) {
        console.warn("[Editor] 잘못된 블록 ID:", blockId);
        // 임시 블록인 경우 메모리에서만 삭제
      } else {
        const { error } = await supabaseClient
          .from("moodboard_blocks")
          .delete()
          .eq("id", blockId);

        if (error) {
          logError("deleteBlock - Creator 모드", error, {
            blockId,
            moodboardId: currentMoodboardId,
          });
          alert(
            "블록 삭제 중 오류가 발생했습니다: " +
              (error.message || "알 수 없는 오류")
          );
          return;
        }
        console.log("[Editor] Creator 모드: 블록 삭제됨:", blockId);
      }
    }

    // 메모리에서 블록 제거
    blocks = blocks.filter((b) => b.id !== blockId);

    // 선택 해제
    if (selectedBlockId === blockId) {
      selectedBlockId = null;
    }

    // DOM에서 블록 제거
    const blockElement = document.querySelector(`[data-id="${blockId}"]`);
    if (blockElement) {
      blockElement.remove();
    }

    // 레이어 패널 업데이트
    updateLayerPanel();

    // 빈 상태 표시 업데이트
    const canvas = document.getElementById("canvas");
    const emptyState = document.getElementById("emptyState");
    if (canvas && emptyState) {
      if (blocks.length === 0) {
        emptyState.style.display = "block";
      } else {
        emptyState.style.display = "none";
      }
    }

    console.log("[Editor] 블록 삭제 완료:", blockId);
  } catch (error) {
    logError("deleteBlock", error, { blockId });
    alert(
      "블록 삭제 중 오류가 발생했습니다: " +
        (error.message || "알 수 없는 오류")
    );
  }
}

// =========================
// ADD BLOCKS
// =========================

let pendingBlockForDrag = null; // 드래그앤드롭 대기 중인 블록

function addBlock(type) {
  try {
    if (!currentMoodboardId) {
      logError("addBlock", new Error("무드보드 ID 없음"), { type });
      alert("무드보드를 먼저 생성해주세요.");
      return;
    }

    // 색상 블록은 제거
    if (type === "color") {
      return;
    }

    // 이모지는 편집 요소에서 완전히 제외 (템플릿 데코만 허용)
    if (type === "emoji") {
      return;
    }

    if (type === "image") {
      // 이미지 선택 모달 표시
      openImageSelectionModalForDrag();
      return;
    }

    // 텍스트는 바로 생성
    const canvas = document.getElementById("canvas");
    if (!canvas) {
      logError("addBlock", new Error("canvas 요소 없음"), { type });
      return;
    }

    const canvasRect = canvas.getBoundingClientRect();
    const canvasWidth = canvasRect.width - 40;
    const canvasHeight = canvasRect.height;

    const defaultW = 0.4;
    const defaultH = 0.15;
    const defaultX = 0.5 - defaultW / 2;
    const defaultY = 0.7;

    // 자유형 모드에서만 미세 자동 회전 (±3°)
    const autoRotation =
      editorMode === "free"
        ? (Math.random() - 0.5) * 6 // -3° ~ +3°
        : 0;

    const newBlock = {
      moodboard_id: currentMoodboardId,
      type: type,
      x: defaultX,
      y: defaultY,
      w: defaultW,
      h: defaultH,
      z_index: blocks.length + 1,
      rotation: autoRotation,
      style: getDefaultStyle(type),
    };

    createBlock(newBlock);
  } catch (error) {
    logError("addBlock", error, { type });
  }
}

// 이모지 선택 후 드래그앤드롭 (제거됨 - 스티커 패널로 대체)
function showEmojiSelectionForDrag() {
  // 이모지 팝업 제거 (요구사항)
  openToolPanel("sticker");
}

function selectEmojiForDrag(emoji) {
  closeTopStylePopup();

  // 임시 블록 생성 (아직 캔버스에 추가하지 않음)
  pendingBlockForDrag = {
    moodboard_id: currentMoodboardId,
    type: "emoji",
    emoji: emoji,
    style: {
      emoji: emoji,
      fontSize: 48,
    },
  };

  // 드래그 모드 활성화
  const canvas = document.getElementById("canvas");
  if (canvas) {
    canvas.classList.add("drag-mode");
    canvas.style.cursor = "crosshair";
  }
}

// 이미지 선택 후 드래그앤드롭
function openImageSelectionModalForDrag() {
  const modal = document.getElementById("imageSelectionModal");
  const imageGrid = document.getElementById("imageGrid");
  if (!modal || !imageGrid) return;

  modal.style.display = "flex";
  imageGrid.innerHTML = "";

  loadImages().then((images) => {
    if (images.length === 0) {
      imageGrid.innerHTML =
        '<p style="text-align: center; padding: 20px; color: #999;">이미지가 없습니다</p>';
      return;
    }

    images.forEach((image) => {
      const item = document.createElement("div");
      item.className = "image-item";
      const img = document.createElement("img");
      img.src = image.image_url || image.thumbnail_url || "";
      img.alt = "이미지";
      item.appendChild(img);
      item.addEventListener("click", () => {
        closeImageSelectionModal();

        // 임시 블록 생성
        pendingBlockForDrag = {
          moodboard_id: currentMoodboardId,
          type: "image",
          style: {
            imageUrl: image.image_url || image.thumbnail_url,
          },
        };

        // 드래그 모드 활성화
        const canvas = document.getElementById("canvas");
        if (canvas) {
          canvas.classList.add("drag-mode");
          canvas.style.cursor = "crosshair";
        }
      });
      imageGrid.appendChild(item);
    });
  });
}

// 그림자 프리셋 정의
const SHADOW_PRESETS = {
  "soft-shadow": "0 6px 18px rgba(0, 0, 0, 0.12)",
  "paper-shadow": "0 4px 12px rgba(0, 0, 0, 0.08)",
  "floating-shadow": "0 10px 24px rgba(0, 0, 0, 0.18)",
};

// 템플릿별 그림자 프리셋 매핑
function getShadowPresetForTemplate(templateId) {
  const shadowMap = {
    clean_grid: "soft-shadow",
    diary: "paper-shadow",
    focus: "floating-shadow",
    scrapbook: "paper-shadow",
    vertical_story: "soft-shadow",
  };
  return shadowMap[templateId] || "soft-shadow";
}

function getDefaultStyle(type) {
  // 기본 그림자 프리셋 (자유형은 soft-shadow, 템플릿형은 템플릿별)
  const shadowPreset =
    editorMode === "template" && currentTemplate
      ? getShadowPresetForTemplate(currentTemplate.id)
      : "soft-shadow";
  const defaultShadow = SHADOW_PRESETS[shadowPreset];

  const baseStyle = {
    fontSize: 16,
    fontWeight: "normal",
    color: "#000",
    backgroundColor: "#fff",
    borderRadius: 16, // 둥근 모서리
    boxShadow: defaultShadow, // 자동 그림자 적용
  };

  switch (type) {
    case "text":
      return {
        ...baseStyle,
        text: "텍스트를 입력하세요",
        borderRadius: 16,
        boxShadow: defaultShadow,
      };
    case "emoji":
      return {
        ...baseStyle,
        emoji: "😊",
        fontSize: 48,
        backgroundColor: "transparent",
        borderRadius: 16,
        boxShadow: defaultShadow,
      };
    case "color":
      return {
        ...baseStyle,
        backgroundColor: "#f0f0f0",
        borderRadius: 16,
        boxShadow: defaultShadow,
      };
    case "image":
    case "cut":
      return {
        ...baseStyle,
        imageUrl: null,
        borderRadius: 16,
        boxShadow: defaultShadow,
      };
    default:
      return baseStyle;
  }
}

async function createBlock(blockData) {
  try {
    // 사용자 재확인
    if (!currentUserId) {
      const user = await getCurrentUser();
      if (!user || !user.uid) {
        alert("로그인이 필요합니다.");
        return;
      }
      currentUserId = user.uid;
    }

    if (!currentMoodboardId) {
      alert("무드보드를 먼저 생성해주세요.");
      return;
    }

    // Reader 모드 분기
    if (isReaderMode) {
      try {
        const { db } = await import("/js/firebase_init.js");
        const { collection, addDoc } = await import(
          "https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore.js"
        );

        const blocksRef = collection(
          db,
          "reader_moodboards",
          currentMoodboardId,
          "blocks"
        );

        const blockToSave = {
          block_type: blockData.type,
          order_index: blocks.length,
          span: blockData.span || 6,
          cut_id: blockData.cut_id || null,
          title: blockData.type === "text" ? blockData.content || "" : null,
          content: blockData.content || null,
          emoji: blockData.emoji || null,
          meta: {
            x: blockData.x || 0.3,
            y: blockData.y || 0.3,
            w: blockData.w || 0.3,
            h: blockData.h || 0.3,
            z_index: blockData.z_index || blocks.length + 1,
            rotation: blockData.rotation || 0,
            style: blockData.style || getDefaultStyle(blockData.type),
          },
        };

        const docRef = await addDoc(blocksRef, blockToSave);
        const blockId = docRef.id;

        // 메모리에 추가
        // 그림자 프리셋 자동 적용 (getDefaultStyle에서 이미 적용됨)
        const defaultStyle = blockData.style || getDefaultStyle(blockData.type);
        // boxShadow가 없으면 기본 그림자 적용
        if (!defaultStyle.boxShadow) {
          const shadowPreset =
            editorMode === "template" && currentTemplate
              ? getShadowPresetForTemplate(currentTemplate.id)
              : "soft-shadow";
          defaultStyle.boxShadow = SHADOW_PRESETS[shadowPreset];
        }

        const newBlock = {
          id: blockId,
          moodboard_id: currentMoodboardId,
          type: blockData.type,
          x: blockData.x || 0.3,
          y: blockData.y || 0.3,
          w: blockData.w || 0.3,
          h: blockData.h || 0.3,
          z_index: blockData.z_index || blocks.length + 1,
          rotation: blockData.rotation || 0,
          style: defaultStyle,
        };

        blocks.push(newBlock);
        renderBlocks();
        selectBlock(newBlock.id);
        updateLayerPanel();

        // 길게 누르기 이벤트 추가
        setupLongPressActionSheet(newBlock.id);

        console.log("[Editor] Reader 모드: 블록 추가됨:", blockId);
        return;
      } catch (error) {
        logError("createBlock - Reader 모드", error, {
          blockData,
          moodboardId: currentMoodboardId,
        });
        alert(
          "블록을 추가하는 중 오류가 발생했습니다: " +
            (error.message || "알 수 없는 오류")
        );
        return;
      }
    }

    // Creator 모드: Supabase 사용
    if (!supabaseClient) {
      alert("서비스 연결에 실패했습니다.");
      return;
    }

    // UUID 검증: currentMoodboardId가 UUID인지 확인
    if (!isValidUUID(currentMoodboardId)) {
      console.error("[Editor] 잘못된 무드보드 ID:", currentMoodboardId);
      alert("잘못된 무드보드 ID입니다.");
      return;
    }

    // 그림자 프리셋 자동 적용 (getDefaultStyle에서 이미 적용됨)
    const defaultStyle = blockData.style || getDefaultStyle(blockData.type);
    // boxShadow가 없으면 기본 그림자 적용
    if (!defaultStyle.boxShadow) {
      const shadowPreset =
        editorMode === "template" && currentTemplate
          ? getShadowPresetForTemplate(currentTemplate.id)
          : "soft-shadow";
      defaultStyle.boxShadow = SHADOW_PRESETS[shadowPreset];
    }

    // 🔥 블록을 메모리에 추가 (임시 ID 사용, 저장 시 Supabase가 UUID 생성)
    const newBlock = {
      id: `temp-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`, // 임시 ID
      moodboard_id: currentMoodboardId,
      type: blockData.type,
      x: blockData.x || 0.3,
      y: blockData.y || 0.3,
      w: blockData.w || 0.3,
      h: blockData.h || 0.3,
      z_index: blockData.z_index || blocks.length + 1,
      rotation: blockData.rotation || 0,
      style: defaultStyle,
    };

    blocks.push(newBlock);
    renderBlocks();
    selectBlock(newBlock.id);
    updateLayerPanel();

    // 길게 누르기 이벤트 추가
    setupLongPressActionSheet(newBlock.id);

    // 길게 누르기 이벤트 추가
    setupLongPressActionSheet(newBlock.id);

    console.log("[Editor] 블록 추가됨:", newBlock.id);
  } catch (error) {
    logError("createBlock - Creator 모드", error, {
      blockData,
      moodboardId: currentMoodboardId,
    });
    alert(
      "블록을 추가하는 중 오류가 발생했습니다: " +
        (error.message || "알 수 없는 오류")
    );
  }
}

// =========================
// IMAGE SELECTION
// =========================

function openImageSelectionModal(blockData) {
  const modal = document.getElementById("imageSelectionModal");
  const imageGrid = document.getElementById("imageGrid");
  if (!modal || !imageGrid) return;

  modal.style.display = "flex";
  imageGrid.innerHTML = "";

  loadImages().then((images) => {
    if (images.length === 0) {
      imageGrid.innerHTML =
        '<p style="text-align: center; padding: 20px; color: #999;">이미지가 없습니다</p>';
      return;
    }

    images.forEach((image) => {
      const item = document.createElement("div");
      item.className = "image-item";
      const img = document.createElement("img");
      img.src = image.image_url || image.thumbnail_url || "";
      img.alt = "이미지";
      item.appendChild(img);
      item.addEventListener("click", () => {
        blockData.style = {
          ...blockData.style,
          imageUrl: image.image_url || image.thumbnail_url,
        };
        createBlock(blockData);
        closeImageSelectionModal();
      });
      imageGrid.appendChild(item);
    });
  });
}

function closeImageSelectionModal() {
  const modal = document.getElementById("imageSelectionModal");
  if (modal) {
    modal.style.display = "none";
  }
}

function openImageSelectionModalForBlock(blockId) {
  const modal = document.getElementById("imageSelectionModal");
  const imageGrid = document.getElementById("imageGrid");
  if (!modal || !imageGrid) return;

  modal.style.display = "flex";
  imageGrid.innerHTML = "";

  loadImages().then((images) => {
    if (images.length === 0) {
      imageGrid.innerHTML =
        '<p style="text-align: center; padding: 20px; color: #999;">이미지가 없습니다</p>';
      return;
    }

    images.forEach((image) => {
      const item = document.createElement("div");
      item.className = "image-item";
      const img = document.createElement("img");
      img.src = image.image_url || image.thumbnail_url || "";
      img.alt = "이미지";
      item.appendChild(img);
      item.addEventListener("click", () => {
        const block = blocks.find((b) => b.id === blockId);
        if (block) {
          block.style = {
            ...block.style,
            imageUrl: image.image_url || image.thumbnail_url,
          };
          updateBlockStyle(blockId, {
            imageUrl: image.image_url || image.thumbnail_url,
          });
        }
        closeImageSelectionModal();
        closeStylePanel();
      });
      imageGrid.appendChild(item);
    });
  });
}

async function loadImages() {
  try {
    // 사용자 재확인
    if (!currentUserId) {
      const user = await getCurrentUser();
      if (!user || !user.uid) {
        console.warn("[Editor] 로그인이 필요합니다");
        return [];
      }
      currentUserId = user.uid;
    }

    if (!supabaseClient) {
      console.warn("[Editor] Supabase 클라이언트가 없습니다");
      return [];
    }

    // user_feed_events에서 저장된 컷 가져오기
    const { data: events, error: eventsError } = await supabaseClient
      .from("user_feed_events")
      .select("id, feed_id, metadata, created_at")
      .eq("user_id", currentUserId)
      .eq("event_type", "cut_saved")
      .order("created_at", { ascending: false })
      .limit(100);

    if (eventsError) {
      console.error("[Editor] 이벤트 조회 오류:", eventsError);
      return [];
    }

    if (!events || events.length === 0) {
      return [];
    }

    // feed_id가 있으면 feeds 테이블에서 조회
    const feedIds = events
      .map((event) => event.feed_id)
      .filter((id) => id !== null && id !== undefined);

    let feedItems = [];
    if (feedIds.length > 0) {
      const { data: feedsData, error: feedsError } = await supabaseClient
        .from("feeds")
        .select("id, type, ref_id, thumbnail_url")
        .in("id", feedIds)
        .eq("type", "cut");

      if (!feedsError && feedsData) {
        feedItems = feedsData;
      }
    }

    // feed_id가 없는 이벤트는 metadata에서 cut_id 사용
    const eventsWithoutFeed = events.filter((event) => !event.feed_id);
    const cutIdsFromMetadata = eventsWithoutFeed
      .map((event) => event.metadata?.cut_id)
      .filter((id) => id !== null && id !== undefined);

    // cuts 테이블에서 직접 조회
    let cutsFromMetadata = [];
    if (cutIdsFromMetadata.length > 0) {
      const { data: cutsData, error: cutsError } = await supabaseClient
        .from("cuts")
        .select("id, image_url")
        .in("id", cutIdsFromMetadata);

      if (!cutsError && cutsData) {
        cutsFromMetadata = cutsData;
      }
    }

    // 이미지 목록 구성
    const images = [];

    // feeds에서 가져온 이미지
    feedItems.forEach((feed) => {
      if (feed.thumbnail_url) {
        images.push({
          id: feed.ref_id || feed.id,
          image_url: feed.thumbnail_url,
          thumbnail_url: feed.thumbnail_url,
        });
      }
    });

    // metadata에서 가져온 이미지
    eventsWithoutFeed.forEach((event) => {
      const cutId = event.metadata?.cut_id;
      const imageUrl = event.metadata?.image_url;

      if (cutId && imageUrl) {
        const existing = images.find((img) => img.id === cutId);
        if (!existing) {
          images.push({
            id: cutId,
            image_url: imageUrl,
            thumbnail_url: imageUrl,
          });
        }
      } else if (cutId) {
        const cut = cutsFromMetadata.find((c) => c.id === cutId);
        if (cut && cut.image_url) {
          const existing = images.find((img) => img.id === cutId);
          if (!existing) {
            images.push({
              id: cutId,
              image_url: cut.image_url,
              thumbnail_url: cut.image_url,
            });
          }
        }
      }
    });

    console.log(`[Editor] ${images.length}개의 컷 이미지를 불러왔습니다`);
    return images;
  } catch (error) {
    console.error("[Editor] 이미지 로드 오류:", error);
    return [];
  }
}

// =========================
// STYLE PANEL
// =========================

function showStylePanel(blockId) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) {
    console.warn("[Editor] 블록을 찾을 수 없음, blockId:", blockId);
    return;
  }

  // 상단에 팝업 표시
  const editorTools = document.getElementById("editorTools");
  if (!editorTools) {
    console.warn("[Editor] editorTools 요소를 찾을 수 없음");
    return;
  }

  // 기존 팝업 제거
  const existingPopup = document.querySelector(".top-style-popup");
  if (existingPopup) {
    existingPopup.remove();
  }

  // 새 팝업 생성
  const popup = document.createElement("div");
  popup.className = "top-style-popup";
  popup.dataset.blockId = blockId;

  switch (block.type) {
    case "text":
      renderTextStylePanel(popup, block);
      break;
    case "image":
      renderImageStylePanel(popup, block);
      break;
    case "emoji":
      renderEmojiStylePanel(popup, block);
      break;
  }

  editorTools.appendChild(popup);

  // 애니메이션
  setTimeout(() => {
    popup.classList.add("show");
  }, 10);
}

function renderTextStylePanel(container, block) {
  const style = block.style || {};
  const popupId = `text-style-popup-${block.id}`;

  // 슬라이드 형식으로 색상 선택 (더보기 버튼 없이)
  container.innerHTML = `
    <button class="close-popup-btn" onclick="closeTopStylePopup()">×</button>
    <div class="top-popup-content">
      <div class="top-popup-title">텍스트 스타일</div>
      <div class="text-style-grid">
        <div class="text-style-item">
          <label>크기</label>
          <div class="control-buttons">
            <button class="control-btn" onclick="changeFontSize('${
              block.id
            }', -2)">-</button>
            <span class="control-value" id="fontSizeDisplay">${
              style.fontSize || 16
            }</span>
            <button class="control-btn" onclick="changeFontSize('${
              block.id
            }', 2)">+</button>
          </div>
        </div>
        <div class="text-style-item">
          <label>텍스트 색상</label>
          <div class="text-color-scroll-container">
            <div class="text-color-grid-compact">
              ${getTextColorOptions()
                .map(
                  (color) => `
                <div class="text-color-item-compact" 
                     style="background: ${color};"
                     onclick="selectTextColor('${block.id}', '${color}')">
                </div>
              `
                )
                .join("")}
            </div>
          </div>
          <div class="text-custom-color">
            <label>커스텀 색상</label>
            <input type="color" class="color-picker-round" id="textColor" value="${
              style.color || "#000000"
            }" />
          </div>
        </div>
        <div class="text-style-item">
          <label>배경 색상</label>
          <div class="background-color-scroll-container">
            <div class="background-color-grid-top">
              ${COLORS.map(
                (color) => `
                <div class="background-color-item-top" 
                     style="background: ${color};"
                     onclick="selectTextBackgroundColor('${block.id}', '${color}')">
                </div>
              `
              ).join("")}
            </div>
          </div>
          <div class="text-custom-color">
            <label>커스텀 색상</label>
            <input type="color" class="color-picker-round" id="backgroundColor" value="${
              style.backgroundColor || "#ffffff"
            }" />
          </div>
        </div>
      </div>
    </div>
  `;

  container.dataset.popupId = popupId;

  // 폰트 크기 변경
  const fontSizeDisplay = container.querySelector("#fontSizeDisplay");
  const updateFontSizeDisplay = () => {
    if (fontSizeDisplay) {
      fontSizeDisplay.textContent = style.fontSize || 16;
    }
  };

  // 색상 변경
  const colorInput = container.querySelector("#textColor");
  if (colorInput) {
    colorInput.addEventListener("change", () => {
      selectTextColor(block.id, colorInput.value);
    });
  }

  // 배경색 변경
  const bgColorInput = container.querySelector("#backgroundColor");
  if (bgColorInput) {
    bgColorInput.addEventListener("change", () => {
      selectTextBackgroundColor(block.id, bgColorInput.value);
    });
  }

  updateFontSizeDisplay();
}

// 텍스트 스타일 팝업 확장
