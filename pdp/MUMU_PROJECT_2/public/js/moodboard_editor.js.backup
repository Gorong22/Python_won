// 텍스트 색상 옵션
function getTextColorOptions() {
  return [
    "#000000",
    "#ffffff",
    "#ff5e00",
    "#333333",
    "#666666",
    "#999999",
    "#ff0000",
    "#00ff00",
    "#0000ff",
    "#ffff00",
    "#ff00ff",
    "#00ffff",
    "#8b4513",
    "#ff69b4",
    "#4169e1",
    "#32cd32",
  ];
}

function selectTextColor(blockId, color) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  updateBlockStyle(blockId, { color: color });
}

function selectTextBackgroundColor(blockId, color) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  updateBlockStyle(blockId, { backgroundColor: color });
}

// 폰트 크기 변경 함수
function changeFontSize(blockId, delta) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  const currentSize = parseInt(block.style?.fontSize || 16);
  const newSize = Math.max(8, Math.min(72, currentSize + delta));

  updateBlockStyle(blockId, { fontSize: newSize });

  // 표시 업데이트
  const fontSizeDisplay = document.querySelector(
    `[data-block-id="${blockId}"] #fontSizeDisplay`
  );
  if (fontSizeDisplay) {
    fontSizeDisplay.textContent = newSize;
  }
}

function renderImageStylePanel(container, block) {
  const style = block.style || {};

  const filters = [
    { value: "none", label: "없음" },
    { value: "grayscale(100%)", label: "흑백" },
    { value: "sepia(100%)", label: "세피아" },
    { value: "brightness(1.2)", label: "밝게" },
    { value: "brightness(0.8)", label: "어둡게" },
    { value: "contrast(1.3)", label: "대비" },
    { value: "saturate(1.5)", label: "채도+" },
    { value: "saturate(0.5)", label: "채도-" },
    { value: "blur(2px)", label: "블러" },
    { value: "hue-rotate(90deg)", label: "색조" },
  ];

  container.innerHTML = `
    <button class="close-popup-btn" onclick="closeTopStylePopup()">×</button>
    <div class="top-popup-content">
      <div class="top-popup-title">이미지 설정</div>
      <div class="top-popup-controls">
        <div class="control-item">
          <label>필터</label>
          <select class="filter-select" id="imageFilterSelect" onchange="changeImageFilter('${
            block.id
          }', this.value)">
            ${filters
              .map(
                (filter) => `
              <option value="${filter.value}" ${
                  (style.filter || "none") === filter.value ? "selected" : ""
                }>${filter.label}</option>
            `
              )
              .join("")}
          </select>
        </div>
        <div class="control-item">
          <label>테두리</label>
          <div class="control-buttons">
            <button class="control-btn" onclick="changeImageBorderRadius('${
              block.id
            }', -2)">-</button>
            <span class="control-value" id="borderRadiusDisplay">${
              style.borderRadius || 0
            }</span>
            <button class="control-btn" onclick="changeImageBorderRadius('${
              block.id
            }', 2)">+</button>
          </div>
        </div>
        <div class="control-item">
          <label>불투명도</label>
          <div class="control-buttons">
            <button class="control-btn" onclick="changeImageOpacity('${
              block.id
            }', -0.1)">-</button>
            <span class="control-value" id="opacityDisplay">${Math.round(
              (style.opacity !== undefined ? style.opacity : 1) * 100
            )}%</span>
            <button class="control-btn" onclick="changeImageOpacity('${
              block.id
            }', 0.1)">+</button>
          </div>
        </div>
        <div class="control-item">
          <button class="change-image-btn-round" onclick="openImageSelectionModalForBlock('${
            block.id
          }')">이미지 변경</button>
        </div>
      </div>
    </div>
  `;
}

function changeImageFilter(blockId, filterValue) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  updateBlockStyle(blockId, {
    filter: filterValue === "none" ? null : filterValue,
  });
}

function changeImageBorderRadius(blockId, delta) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  const currentRadius = parseInt(block.style?.borderRadius || 0);
  const newRadius = Math.max(0, Math.min(50, currentRadius + delta));

  updateBlockStyle(blockId, { borderRadius: newRadius });

  const display = document.querySelector(
    `[data-block-id="${blockId}"] #borderRadiusDisplay`
  );
  if (display) {
    display.textContent = newRadius;
  }
}

function changeImageOpacity(blockId, delta) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  const currentOpacity =
    block.style?.opacity !== undefined ? block.style.opacity : 1;
  const newOpacity = Math.max(0, Math.min(1, currentOpacity + delta));

  updateBlockStyle(blockId, { opacity: newOpacity });

  const display = document.querySelector(
    `[data-block-id="${blockId}"] #opacityDisplay`
  );
  if (display) {
    display.textContent = Math.round(newOpacity * 100) + "%";
  }
}

function renderEmojiStylePanel(container, block) {
  // 이모지 선택 팝업만 표시
  container.innerHTML = `
    <button class="close-popup-btn" onclick="closeTopStylePopup()">×</button>
    <div class="top-popup-content">
      <div class="top-popup-title">이모지 선택</div>
      <div class="emoji-grid-top-popup">
        ${EMOJIS.map(
          (emoji) => `
          <div class="emoji-item-top-popup ${
            (block.style?.emoji || block.content || "😊") === emoji
              ? "selected"
              : ""
          }" 
               onclick="selectEmojiForBlock('${block.id}', '${emoji}')">
            ${emoji}
          </div>
        `
        ).join("")}
      </div>
    </div>
  `;
}

// 이모지 선택 함수
function selectEmojiForBlock(blockId, emoji) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  updateBlockStyle(blockId, { emoji: emoji });
  block.content = emoji;

  // 팝업 닫기
  closeTopStylePopup();
}

// 색상 블록 스타일 패널 제거 (색상 블록 자체가 제거됨)

function updateBlockStyleFromPanel(blockId) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  const popup = document.querySelector(
    `.top-style-popup[data-block-id="${blockId}"]`
  );
  const newStyle = { ...block.style };

  switch (block.type) {
    case "text":
      // 폰트 크기, 색상, 배경색 업데이트
      const fontSizeDisplay = popup?.querySelector("#fontSizeDisplay");
      if (fontSizeDisplay) {
        newStyle.fontSize = parseInt(fontSizeDisplay.textContent || 16);
      }
      newStyle.color = popup?.querySelector("#textColor")?.value || "#000000";
      newStyle.backgroundColor =
        popup?.querySelector("#backgroundColor")?.value || "#ffffff";
      break;
    case "image":
      newStyle.borderRadius = parseInt(
        document.getElementById("borderRadius")?.value || 0
      );
      newStyle.opacity = parseFloat(
        document.getElementById("opacity")?.value || 1
      );
      break;
    case "emoji":
      newStyle.emoji = document.getElementById("emoji")?.value || "😊";
      newStyle.fontSize = parseInt(
        document.getElementById("emojiSize")?.value || 48
      );
      break;
    case "color":
      newStyle.backgroundColor =
        document.getElementById("backgroundColor")?.value || "#f0f0f0";
      newStyle.borderRadius = parseInt(
        document.getElementById("borderRadius")?.value || 0
      );
      break;
  }

  updateBlockStyle(blockId, newStyle);
}

function updateBlockStyle(blockId, newStyle) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  block.style = { ...block.style, ...newStyle };
  renderBlocks();
  selectBlock(blockId);
}

// =========================
// LAYER PANEL
// =========================

function updateLayerPanel() {
  const layerPanel = document.getElementById("layerPanel");
  if (!layerPanel) return;

  if (blocks.length === 0) {
    layerPanel.innerHTML = '<p class="layer-hint">레이어가 없습니다</p>';
    return;
  }

  layerPanel.innerHTML = blocks
    .slice()
    .reverse() // 최신이 위로
    .map((block) => {
      const isSelected = block.id === selectedBlockId;
      return `
        <div class="layer-item ${
          isSelected ? "active" : ""
        }" onclick="selectBlock('${block.id}')">
          <div class="layer-item-preview">
            ${getBlockPreviewIcon(block.type)}
          </div>
          <div class="layer-item-info">
            <div class="layer-item-name">${getBlockTypeName(block.type)}</div>
            <div class="layer-item-type">레이어 ${
              blocks.length - blocks.indexOf(block)
            }</div>
          </div>
        </div>
      `;
    })
    .join("");
}

function getBlockPreviewIcon(type) {
  switch (type) {
    case "image":
      return "🖼️";
    case "text":
      return "📝";
    case "emoji":
      return "😊";
    case "color":
      return "🎨";
    default:
      return "📦";
  }
}

function getBlockTypeName(type) {
  switch (type) {
    case "image":
      return "이미지";
    case "text":
      return "텍스트";
    case "emoji":
      return "이모지";
    case "color":
      return "색상";
    default:
      return "블록";
  }
}

// =========================
// SAVE
// =========================

/**
 * 현재 사용자의 닉네임 가져오기 (Firebase Firestore user 문서의 nickname 사용)
 */
async function getCurrentUserNickname() {
  try {
    if (!currentUserId) {
      const user = await getCurrentUser();
      if (!user || !user.uid) return null;
      currentUserId = user.uid;
    }

    // Firebase Firestore user 문서에서 nickname 가져오기
    try {
      if (typeof firebase !== "undefined" && firebase.firestore) {
        const userDoc = await firebase
          .firestore()
          .collection("users")
          .doc(currentUserId)
          .get();
        if (userDoc.exists()) {
          const userData = userDoc.data();
          const nickname = userData.nickname || null;
          if (nickname) return nickname;
        }
      }
    } catch (e) {
      // Firestore 조회 실패 시 다음 방법 시도
    }

    // Fallback: Firebase Auth displayName 사용
    try {
      const user = await getCurrentUser();
      if (user && user.displayName) {
        return user.displayName;
      }
    } catch (e) {
      // 다음 방법 시도
    }

    return null;
  } catch (error) {
    console.error("[Editor] 닉네임 가져오기 오류:", error);
    return null;
  }
}

async function saveMoodboard() {
  if (!currentMoodboardId) {
    alert("저장할 무드보드가 없습니다.");
    return;
  }

  try {
    // 사용자 재확인
    if (!currentUserId) {
      const user = await getCurrentUser();
      if (!user || !user.uid) {
        alert("로그인이 필요합니다.");
        return;
      }
      currentUserId = user.uid;
    }

    // Reader 모드 확인 (전역 변수 사용)
    if (isReaderMode) {
      try {
        const { db } = await import("/js/firebase_init.js");
        const {
          doc,
          updateDoc,
          serverTimestamp,
          collection,
          getDocs,
          deleteDoc,
          addDoc,
        } = await import(
          "https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore.js"
        );

        const moodboardRef = doc(db, "reader_moodboards", currentMoodboardId);

        // 모든 블록의 위치/크기 업데이트 (DOM에서 최신 상태 가져오기)
        const canvas = document.getElementById("canvas");
        if (canvas) {
          const canvasRect = canvas.getBoundingClientRect();
          const canvasWidth = canvasRect.width - 40;
          const canvasHeight = canvasRect.height;

          blocks.forEach((block) => {
            const blockElement = document.querySelector(
              `[data-id="${block.id}"]`
            );
            if (blockElement) {
              // DOM에서 최신 위치/크기 가져오기
              commitBlockRect(block.id, blockElement);

              // 텍스트 블록의 경우 contentEditable 내용도 반영
              if (block.type === "text") {
                const textDiv = blockElement.querySelector(
                  '[contenteditable="true"]'
                );
                if (textDiv) {
                  block.style = { ...block.style, text: textDiv.textContent };
                  block.content = textDiv.textContent;
                }
              }
            }
          });
        }

        // 블록 데이터를 Firestore 형식으로 변환 및 저장
        const blocksRef = collection(
          db,
          "reader_moodboards",
          currentMoodboardId,
          "blocks"
        );

        // 기존 블록 삭제
        const existingBlocks = await getDocs(blocksRef);
        const deletePromises = existingBlocks.docs.map((docSnap) =>
          deleteDoc(docSnap.ref)
        );
        await Promise.all(deletePromises);

        // 새 블록 저장
        const savePromises = blocks.map((block, index) => {
          const blockData = {
            block_type: block.type,
            order_index: index,
            span: block.span || 6,
            cut_id: block.cut_id || null,
            title: block.type === "text" ? block.content || "" : null,
            content: block.content || null,
            emoji: block.emoji || null,
            meta: {
              x: block.x || 0.3,
              y: block.y || 0.3,
              w: block.w || 0.3,
              h: block.h || 0.3,
              z_index: block.z_index || index + 1,
              rotation: block.rotation || 0,
              style: block.style || {},
              // 슬롯 내부 조절 속성
              slotId: block.slotId || null,
              slotOffsetX: block.slotOffsetX || 0,
              slotOffsetY: block.slotOffsetY || 0,
              slotScale: block.slotScale || 1.0,
            },
          };
          return addDoc(blocksRef, blockData);
        });
        await Promise.all(savePromises);

        // 무드보드 업데이트
        await updateDoc(moodboardRef, {
          updated_at: serverTimestamp(),
        });

        // 저장 완료 알림 (대표 무드보드 팝업 스타일로)
        isSaved = true;
        showSaveSuccessPopup();
        console.log(
          "[Editor] Reader 모드: Firestore 무드보드 저장 완료:",
          currentMoodboardId
        );
        return;
      } catch (error) {
        logError("saveMoodboard - Reader 모드", error, {
          moodboardId: currentMoodboardId,
          blocksCount: blocks.length,
        });
        alert(
          "저장 중 오류가 발생했습니다: " + (error.message || "알 수 없는 오류")
        );
        return;
      }
    }

    // Creator 모드: Supabase로 저장
    if (!supabaseClient) {
      alert("서비스 연결에 실패했습니다.");
      return;
    }

    // UUID 검증
    if (!isValidUUID(currentMoodboardId)) {
      alert("잘못된 무드보드 ID입니다.");
      return;
    }

    // Supabase Auth 세션 확인 (쓰기 가드)
    try {
      const { data: sessionData, error: sessionError } =
        await supabaseClient.auth.getSession();
      if (sessionError || !sessionData?.session) {
        console.warn(
          "[Editor] Supabase Auth 세션이 없습니다. Firebase Auth만 사용 중입니다."
        );
        // Firebase Auth만 있어도 계속 진행 (RLS 정책에 따라 실패할 수 있음)
      }
    } catch (e) {
      console.warn("[Editor] 세션 확인 실패:", e);
    }

    // 모든 블록의 위치/크기 업데이트 (DOM에서 최신 상태 가져오기)
    const canvas = document.getElementById("canvas");
    if (canvas) {
      const canvasRect = canvas.getBoundingClientRect();
      const canvasWidth = canvasRect.width - 40;
      const canvasHeight = canvasRect.height;

      blocks.forEach((block) => {
        const blockElement = document.querySelector(`[data-id="${block.id}"]`);
        if (blockElement) {
          // DOM에서 최신 위치/크기 가져오기
          commitBlockRect(block.id, blockElement);

          // 텍스트 블록의 경우 contentEditable 내용도 반영
          if (block.type === "text") {
            const textDiv = blockElement.querySelector(
              '[contenteditable="true"]'
            );
            if (textDiv) {
              block.style = { ...block.style, text: textDiv.textContent };
              block.content = textDiv.textContent;
            }
          }
        }
      });
    }

    // 기존 무드보드 데이터 가져오기
    const { data: existingMoodboard, error: fetchError } = await supabaseClient
      .from("moodboards")
      .select("*")
      .eq("id", currentMoodboardId)
      .single();

    if (fetchError) {
      throw new Error("무드보드를 찾을 수 없습니다: " + fetchError.message);
    }

    // moodboards 테이블 업데이트 (title만 업데이트)
    const { error: updateError } = await supabaseClient
      .from("moodboards")
      .update({
        updated_at: new Date().toISOString(),
        // is_public은 대표 설정 시 별도로 업데이트됨
      })
      .eq("id", currentMoodboardId);

    if (updateError) throw updateError;

    // moodboard_blocks 테이블에 블록 저장
    // 기존 블록 삭제 후 새로 삽입
    const { error: deleteError } = await supabaseClient
      .from("moodboard_blocks")
      .delete()
      .eq("moodboard_id", currentMoodboardId);

    if (deleteError) {
      console.warn("[Editor] 기존 블록 삭제 실패:", deleteError);
      // 계속 진행
    }

    // 새 블록 삽입
    if (blocks.length > 0) {
      const blocksToInsert = blocks.map((block, index) => {
        const blockData = {
          moodboard_id: currentMoodboardId,
          block_type: block.type, // type → block_type
          order_index: index,
          span: block.span || 6,
        };

        // 타입별 필드 추가
        if (block.type === "cut" && block.cut_id) {
          blockData.cut_id = block.cut_id;
        }
        if (block.type === "text" && block.content) {
          blockData.title = block.content;
          blockData.content = block.content;
        }
        if (block.type === "quote" && block.content) {
          blockData.content = block.content;
        }
        if (block.emoji) {
          blockData.emoji = block.emoji;
        }

        // 위치/크기/스타일 정보는 meta JSONB에 저장
        blockData.meta = {
          x: block.x || 0.3,
          y: block.y || 0.3,
          w: block.w || 0.3,
          h: block.h || 0.3,
          z_index: block.z_index || index + 1,
          rotation: block.rotation || 0,
          style: block.style || {},
          // 슬롯 내부 조절 속성
          slotId: block.slotId || null,
          slotOffsetX: block.slotOffsetX || 0,
          slotOffsetY: block.slotOffsetY || 0,
          slotScale: block.slotScale || 1.0,
        };

        return blockData;
      });

      const { error: insertError } = await supabaseClient
        .from("moodboard_blocks")
        .insert(blocksToInsert);

      if (insertError) {
        // AuthSessionMissingError 또는 401/42501 에러 처리
        if (
          insertError.code === "42501" ||
          insertError.message?.includes("AuthSessionMissingError") ||
          insertError.message?.includes("401")
        ) {
          alert("로그인이 필요합니다. 로그인 후 다시 시도해주세요.");
          console.error("[Editor] 인증 오류:", insertError);
          return;
        }
        throw insertError;
      }
    }

    // 저장 완료 알림 (대표 무드보드 팝업 스타일로)
    showSaveSuccessPopup();
  } catch (error) {
    logError("saveMoodboard - Creator 모드", error, {
      moodboardId: currentMoodboardId,
      blocksCount: blocks.length,
      errorCode: error.code,
    });
    if (
      error.code === "42501" ||
      error.message?.includes("AuthSessionMissingError") ||
      error.message?.includes("401")
    ) {
      alert("로그인이 필요합니다.");
    } else {
      alert(
        "저장 중 오류가 발생했습니다: " + (error.message || "알 수 없는 오류")
      );
    }
  }
}

// =========================
// UTILITIES
// =========================

function switchEditorTab(tabName) {
  document.querySelectorAll(".editor-tab").forEach((tab) => {
    tab.classList.remove("active");
    if (tab.dataset.tab === tabName) {
      tab.classList.add("active");
    }
  });

  document.querySelectorAll(".editor-tab-content").forEach((content) => {
    content.classList.remove("active");
    if (
      content.id ===
      `editorTab${tabName.charAt(0).toUpperCase() + tabName.slice(1)}`
    ) {
      content.classList.add("active");
    }
  });
}

function toggleEditorPanel() {
  const panel = document.getElementById("editorPanel");
  if (panel) {
    panel.classList.toggle("open");
  }
}

let isSaved = false; // 저장 여부 추적

function handleBack() {
  // 저장 전: confirm
  if (!isSaved) {
    if (!confirm("저장하지 않고 나갈까요?")) {
      return;
    }
  }

  // 모드 선택 화면으로 돌아가기
  if (editorMode) {
    const editorScreen = document.getElementById("editorScreen");
    const modeSelector = document.getElementById("modeSelectorScreen");

    if (editorScreen) {
      // 페이드 + 축소 애니메이션
      editorScreen.style.transition = "opacity 0.3s ease, transform 0.3s ease";
      editorScreen.style.opacity = "0";
      editorScreen.style.transform = "scale(0.95)";

      setTimeout(() => {
        editorScreen.classList.remove("active");
        if (modeSelector) modeSelector.classList.remove("hidden");

        editorMode = null;
        currentTemplate = null;
        blocks = [];
        renderBlocks();
        isSaved = false;

        // 마이페이지로 이동
        window.location.href = "mypage_reader.html";
      }, 300);
    }
  } else {
    history.back();
  }
}

// =========================
// TEMPLATE FUNCTIONS
// =========================

// 템플릿 적용
function applyTemplate(template) {
  if (!template || template.type !== "template") {
    console.warn("[Editor] 유효하지 않은 템플릿:", template);
    return;
  }

  currentTemplate = template;
  console.log("[Editor] 템플릿 적용:", template.id);

  // 캔버스 설정
  const canvas = document.getElementById("canvas");
  if (!canvas) {
    console.warn(
      "[Editor] canvas 요소를 찾을 수 없습니다. 잠시 후 재시도합니다."
    );
    setTimeout(() => {
      if (template) applyTemplate(template);
    }, 100);
    return;
  }

  const canvasContainer = document.getElementById("canvasContainer");
  if (canvasContainer && template.canvas) {
    // 비율 설정
    if (template.canvas.ratio) {
      const ratio = template.canvas.ratio.split(":");
      const aspectRatio = parseFloat(ratio[1]) / parseFloat(ratio[0]);
      canvasContainer.style.aspectRatio = `${ratio[0]} / ${ratio[1]}`;
    }

    // 배경색 설정
    if (template.canvas.backgroundColor) {
      canvas.style.backgroundColor = template.canvas.backgroundColor;
    } else if (template.defaultBackground) {
      canvas.style.backgroundColor = template.defaultBackground;
    }
  }

  // 슬롯 렌더링 (즉시 실행)
  renderTemplateSlots(template);

  // DOM이 완전히 준비될 때까지 대기 후 재렌더링
  setTimeout(() => {
    renderTemplateSlots(template);
  }, 200);

  // 장식 요소 렌더링
  renderTemplateDecorations(template);

  // main 슬롯 자동 선택
  setTimeout(() => {
    selectMainSlot();
  }, 300);
}

// 템플릿 슬롯 렌더링
function renderTemplateSlots(template) {
  const canvas = document.getElementById("canvas");
  if (!canvas) {
    console.warn("[Editor] canvas 요소를 찾을 수 없습니다");
    // canvas가 없으면 잠시 후 재시도
    setTimeout(() => {
      if (template) renderTemplateSlots(template);
    }, 100);
    return;
  }

  if (!template || !template.slots) {
    console.warn("[Editor] 템플릿 또는 슬롯이 없습니다");
    return;
  }

  // 기존 슬롯 제거
  const existingSlots = canvas.querySelectorAll(".template-slot");
  existingSlots.forEach((slot) => slot.remove());

  // 캔버스 크기 계산 (DOM이 준비될 때까지 대기)
  const canvasRect = canvas.getBoundingClientRect();
  let canvasWidth = canvasRect.width - 40; // padding 제외
  let canvasHeight = canvasRect.height - 40;

  // 캔버스 크기가 0이면 기본값 사용
  if (canvasWidth <= 0 || canvasHeight <= 0) {
    canvasWidth = 300;
    canvasHeight = 300;
  }

  // 슬롯 생성
  template.slots.forEach((slot) => {
    const slotEl = document.createElement("div");
    slotEl.className = "template-slot";
    slotEl.dataset.slotId = slot.id;
    slotEl.dataset.role = slot.role || "sub";

    // size 속성 사용 (1:1 비율 슬롯)
    const size =
      slot.size || (slot.w && slot.h ? Math.min(slot.w, slot.h) : 0.3);
    const slotSize = size * Math.min(canvasWidth, canvasHeight);

    // 퍼센트 좌표를 픽셀 좌표로 변환
    const x = slot.x * canvasWidth;
    const y = slot.y * canvasHeight;

    slotEl.style.position = "absolute";
    slotEl.style.left = `${x}px`;
    slotEl.style.top = `${y}px`;
    slotEl.style.width = `${slotSize}px`;
    slotEl.style.height = `${slotSize}px`;
    slotEl.style.border = "2px dashed #ddd";
    slotEl.style.borderRadius = "8px";
    slotEl.style.display = "flex";
    slotEl.style.alignItems = "center";
    slotEl.style.justifyContent = "center";
    slotEl.style.background = "rgba(0, 0, 0, 0.02)";
    slotEl.style.cursor = "pointer";
    slotEl.style.transition = "all 0.2s";

    // 플레이스홀더
    const placeholder = document.createElement("div");
    placeholder.className = "template-slot-placeholder";
    placeholder.textContent = "+";
    placeholder.style.fontSize = "32px";
    placeholder.style.color = "#999";
    placeholder.style.fontWeight = "300";
    slotEl.appendChild(placeholder);

    // 호버 효과
    slotEl.addEventListener("mouseenter", () => {
      slotEl.style.borderColor = "#3b82f6";
      slotEl.style.background = "rgba(59, 130, 246, 0.05)";
    });
    slotEl.addEventListener("mouseleave", () => {
      slotEl.style.borderColor = "#ddd";
      slotEl.style.background = "rgba(0, 0, 0, 0.02)";
    });

    // 클릭 이벤트 - 컷 선택 모달 열기
    slotEl.addEventListener("click", (e) => {
      e.stopPropagation();
      // 슬롯 내부 컷 블록이 아닌 경우에만 모달 열기
      if (!e.target.closest(".slot-cut-block")) {
        currentSlotId = slot.id;
        selectSlot(slot.id);
        openImageSelectionModalForSlot(slot.id);
      }
    });

    canvas.appendChild(slotEl);
  });

  // 기존 블록이 슬롯에 맞는지 확인하고 표시
  blocks.forEach((block) => {
    if (block.slotId) {
      const slotEl = canvas.querySelector(`[data-slot-id="${block.slotId}"]`);
      if (slotEl) {
        slotEl.classList.add("has-content");
        // placeholder 숨기기 (이미지가 있는 슬롯)
        const placeholder = slotEl.querySelector(".template-slot-placeholder");
        if (placeholder) {
          placeholder.style.display = "none";
        }
        // 블록을 슬롯 위치에 맞춤
        if (typeof renderBlockInSlot === "function") {
          renderBlockInSlot(block.id, block.slotId);
        }
      }
    }
  });

  console.log("[Editor] 템플릿 슬롯 렌더링 완료:", template.slots.length, "개");
}

// 슬롯 선택 함수
function selectSlot(slotId) {
  currentSlotId = slotId;

  // 모든 슬롯의 선택 상태 제거
  document.querySelectorAll(".template-slot").forEach((slot) => {
    slot.classList.remove("selected");
    slot.style.borderColor = "#ddd";
  });

  // 선택된 슬롯 강조
  const selectedSlot = document.querySelector(`[data-slot-id="${slotId}"]`);
  if (selectedSlot) {
    selectedSlot.classList.add("selected");
    selectedSlot.style.borderColor = "#3b82f6";
    selectedSlot.style.borderWidth = "3px";
  }
}

// main 슬롯 자동 선택
function selectMainSlot() {
  if (!currentTemplate || !currentTemplate.slots) return null;

  const mainSlot = currentTemplate.slots.find((slot) => slot.role === "main");
  if (mainSlot) {
    selectSlot(mainSlot.id);
    return mainSlot.id;
  }

  // main 슬롯이 없으면 첫 번째 슬롯 선택
  if (currentTemplate.slots.length > 0) {
    selectSlot(currentTemplate.slots[0].id);
    return currentTemplate.slots[0].id;
  }

  return null;
}

// 템플릿 장식 요소 렌더링 (이모지 제거)
function renderTemplateDecorations(template) {
  if (!template.decorations) return;

  const canvas = document.getElementById("canvas");
  if (!canvas) return;

  // 텍스트만 추가 (이모지는 제거)
  if (template.decorations.text) {
    const text = template.decorations.text;
    const textBlock = {
      id: "decoration-text",
      type: "text",
      content: text.content,
      x: text.x || 0.5,
      y: text.y || 0.9,
      w: 0.4,
      h: 0.1,
      rotation: 0,
      z_index: 1, // 항상 뒤 레이어
      style: {
        fontFamily: text.font || "Pretendard, sans-serif",
        fontSize: text.fontSize || 20,
        color: text.color || "#333",
        textAlign: "center",
      },
    };

    blocks.push(textBlock);
  }

  renderBlocks();
}

// =========================
// LONG PRESS ACTION SHEET
// =========================

let longPressTimer = null;
let longPressBlockId = null;

function setupLongPressActionSheet(blockId) {
  const blockElement = document.querySelector(`[data-id="${blockId}"]`);
  if (!blockElement) return;

  // 템플릿 고정 데코는 길게 누르기 불가
  const block = blocks.find((b) => b.id === blockId);
  if (block && block.id?.startsWith("decoration-")) {
    return;
  }

  // 길게 누르기 시작
  blockElement.addEventListener(
    "touchstart",
    (e) => {
      if (e.touches.length === 1) {
        longPressTimer = setTimeout(() => {
          longPressBlockId = blockId;
          showActionSheet(blockId);
        }, 500); // 500ms 길게 누르기
      }
    },
    { passive: true }
  );

  // 길게 누르기 취소
  blockElement.addEventListener(
    "touchend",
    () => {
      if (longPressTimer) {
        clearTimeout(longPressTimer);
        longPressTimer = null;
      }
    },
    { passive: true }
  );

  blockElement.addEventListener(
    "touchmove",
    () => {
      if (longPressTimer) {
        clearTimeout(longPressTimer);
        longPressTimer = null;
      }
    },
    { passive: true }
  );
}

function showActionSheet(blockId) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  // 기존 액션 시트 제거
  const existingSheet = document.querySelector(".action-sheet");
  if (existingSheet) {
    existingSheet.remove();
  }

  // 액션 시트 생성
  const sheet = document.createElement("div");
  sheet.className = "action-sheet";
  sheet.style.cssText = `
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    border-radius: 20px 20px 0 0;
    padding: 20px;
    z-index: 10001;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
    animation: slideUp 0.3s ease;
  `;

  sheet.innerHTML = `
    <div style="width: 40px; height: 4px; background: #ddd; border-radius: 2px; margin: 0 auto 20px;"></div>
    <button class="action-sheet-item" onclick="bringToFront('${blockId}'); closeActionSheet();" style="
      width: 100%;
      padding: 16px;
      text-align: left;
      border: none;
      background: transparent;
      font-size: 16px;
      color: #333;
      cursor: pointer;
    ">앞으로 가져오기</button>
    <button class="action-sheet-item" onclick="sendToBack('${blockId}'); closeActionSheet();" style="
      width: 100%;
      padding: 16px;
      text-align: left;
      border: none;
      background: transparent;
      font-size: 16px;
      color: #333;
      cursor: pointer;
    ">뒤로 보내기</button>
    <button class="action-sheet-item" onclick="deleteBlock('${blockId}'); closeActionSheet();" style="
      width: 100%;
      padding: 16px;
      text-align: left;
      border: none;
      background: transparent;
      font-size: 16px;
      color: #ff4444;
      cursor: pointer;
    ">삭제</button>
    <button class="action-sheet-item" onclick="closeActionSheet();" style="
      width: 100%;
      padding: 16px;
      text-align: center;
      border: none;
      background: #f5f5f5;
      font-size: 16px;
      color: #666;
      cursor: pointer;
      border-radius: 12px;
      margin-top: 8px;
    ">취소</button>
  `;

  // 배경 오버레이
  const overlay = document.createElement("div");
  overlay.className = "action-sheet-overlay";
  overlay.style.cssText = `
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 10000;
    animation: fadeIn 0.2s ease;
  `;
  overlay.addEventListener("click", closeActionSheet);

  document.body.appendChild(overlay);
  document.body.appendChild(sheet);
}

function closeActionSheet() {
  const sheet = document.querySelector(".action-sheet");
  const overlay = document.querySelector(".action-sheet-overlay");
  if (sheet) sheet.remove();
  if (overlay) overlay.remove();
  longPressBlockId = null;
}

function bringToFront(blockId) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  const maxZ = Math.max(...blocks.map((b) => b.z_index || 1));
  block.z_index = maxZ + 1;
  renderBlocks();
}

function sendToBack(blockId) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  const minZ = Math.min(...blocks.map((b) => b.z_index || 1));
  block.z_index = Math.max(1, minZ - 1);
  renderBlocks();
}

// 슬롯용 컷 선택 모달 열기
function openImageSelectionModalForSlot(slotId) {
  const modal = document.getElementById("imageSelectionModal");
  const imageGrid = document.getElementById("imageGrid");
  if (!modal || !imageGrid) return;

  modal.style.display = "flex";
  imageGrid.innerHTML = "";

  loadImages().then((images) => {
    if (images.length === 0) {
      imageGrid.innerHTML =
        '<p style="text-align: center; padding: 20px; color: #999;">저장된 컷이 없습니다</p>';
      return;
    }

    images.forEach((image) => {
      const item = document.createElement("div");
      item.className = "image-item";
      const img = document.createElement("img");
      img.src = image.image_url || image.thumbnail_url || "";
      img.alt = "이미지";
      item.appendChild(img);
      item.addEventListener("click", () => {
        addCutToSlot(slotId, image);
        closeImageSelectionModal();
      });
      imageGrid.appendChild(item);
    });
  });
}

// 슬롯에 컷 추가
function addCutToSlot(slotId, imageData) {
  if (!currentTemplate || !currentTemplate.slots) return;

  const slot = currentTemplate.slots.find((s) => s.id === slotId);
  if (!slot) return;

  // 기존 블록 제거 (같은 슬롯에 있는 경우)
  blocks = blocks.filter((b) => b.slotId !== slotId);

  // 새 블록 생성 (슬롯 내부 조절 속성 포함)
  const block = {
    id: `block-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,
    moodboard_id: currentMoodboardId,
    type: "cut",
    cut_id: imageData.id,
    slotId: slotId,
    x: slot.x,
    y: slot.y,
    w: slot.size || 0.3,
    h: slot.size || 0.3,
    rotation: 0, // 회전 금지
    z_index: blocks.length + 1,
    // 슬롯 내부 조절 속성
    slotOffsetX: 0, // 슬롯 내부 X 오프셋 (-0.1 ~ 0.1)
    slotOffsetY: 0, // 슬롯 내부 Y 오프셋 (-0.1 ~ 0.1)
    slotScale: 1.0, // 슬롯 내부 확대 (1.0 ~ 1.2)
    style: {
      imageUrl: imageData.image_url || imageData.thumbnail_url,
    },
  };

  blocks.push(block);

  // 슬롯 UI 업데이트
  renderBlockInSlot(block.id, slotId);
}

// 슬롯 내부에 블록 렌더링 (조절 가능)
function renderBlockInSlot(blockId, slotId) {
  if (!currentTemplate || !currentTemplate.slots) return;

  const slot = currentTemplate.slots.find((s) => s.id === slotId);
  if (!slot) return;

  const block = blocks.find((b) => b.id === blockId);
  if (!block || !block.slotId) return;

  const slotEl = document.querySelector(`[data-slot-id="${slotId}"]`);
  if (!slotEl) return;

  slotEl.classList.add("has-content");

  // placeholder 숨기기 (이미지가 있는 슬롯)
  const placeholder = slotEl.querySelector(".template-slot-placeholder");
  if (placeholder) {
    placeholder.style.display = "none";
  }

  // 기존 컷 블록 제거
  const existingCut = slotEl.querySelector(".slot-cut-block");
  if (existingCut) existingCut.remove();

  // 슬롯 크기 계산
  const canvas = document.getElementById("canvas");
  if (!canvas) return;
  const canvasRect = canvas.getBoundingClientRect();
  const canvasWidth = canvasRect.width - 40;
  const canvasHeight = canvasRect.height - 40;
  const slotSize = (slot.size || 0.3) * Math.min(canvasWidth, canvasHeight);

  // 컷 블록 생성
  const cutBlock = document.createElement("div");
  cutBlock.className = "slot-cut-block";
  cutBlock.dataset.blockId = blockId;

  // 조절 값 적용
  const offsetX = (block.slotOffsetX || 0) * slotSize;
  const offsetY = (block.slotOffsetY || 0) * slotSize;
  const scale = Math.max(1.0, Math.min(1.2, block.slotScale || 1.0));

  cutBlock.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${scale})`;
  cutBlock.style.transformOrigin = "center center";

  // 이미지 추가
  const img = document.createElement("img");
  img.src = block.style?.imageUrl || "";
  img.style.width = "100%";
  img.style.height = "100%";
  img.style.objectFit = "cover";
  cutBlock.appendChild(img);

  // 드래그 이벤트 (슬롯 내부에서만 이동) - 마우스
  let isDragging = false;
  let dragStart = { x: 0, y: 0 };
  let startOffset = { x: 0, y: 0 };

  cutBlock.addEventListener("mousedown", (e) => {
    e.stopPropagation();
    isDragging = true;
    dragStart = { x: e.clientX, y: e.clientY };
    startOffset = { x: block.slotOffsetX || 0, y: block.slotOffsetY || 0 };
    cutBlock.style.cursor = "grabbing";
  });

  document.addEventListener("mousemove", (e) => {
    if (!isDragging) return;
    e.preventDefault();

    const deltaX = (e.clientX - dragStart.x) / slotSize;
    const deltaY = (e.clientY - dragStart.y) / slotSize;

    // 슬롯 내부 범위 제한 (-0.1 ~ 0.1)
    block.slotOffsetX = Math.max(-0.1, Math.min(0.1, startOffset.x + deltaX));
    block.slotOffsetY = Math.max(-0.1, Math.min(0.1, startOffset.y + deltaY));

    renderBlockInSlot(blockId, slotId);
  });

  document.addEventListener("mouseup", () => {
    if (isDragging) {
      isDragging = false;
      cutBlock.style.cursor = "move";
    }
  });

  // 터치 이벤트 (이동 및 핀치 줌)
  let touchStartDistance = 0;
  let touchStartScale = 1.0;
  let touchStartPos = { x: 0, y: 0 };
  let touchStartOffset = { x: 0, y: 0 };
  let isTouchDragging = false;
  let isPinching = false;

  cutBlock.addEventListener("touchstart", (e) => {
    e.stopPropagation();
    if (e.touches.length === 1) {
      // 단일 터치: 이동
      isTouchDragging = true;
      touchStartPos = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      touchStartOffset = {
        x: block.slotOffsetX || 0,
        y: block.slotOffsetY || 0,
      };
    } else if (e.touches.length === 2) {
      // 두 손가락: 핀치 줌
      e.preventDefault();
      isPinching = true;
      const touch1 = e.touches[0];
      const touch2 = e.touches[1];
      touchStartDistance = Math.hypot(
        touch2.clientX - touch1.clientX,
        touch2.clientY - touch1.clientY
      );
      touchStartScale = block.slotScale || 1.0;
    }
  });

  cutBlock.addEventListener("touchmove", (e) => {
    e.stopPropagation();
    if (e.touches.length === 1 && isTouchDragging && !isPinching) {
      // 단일 터치 이동
      e.preventDefault();
      const deltaX = (e.touches[0].clientX - touchStartPos.x) / slotSize;
      const deltaY = (e.touches[0].clientY - touchStartPos.y) / slotSize;

      // 슬롯 내부 범위 제한 (-0.1 ~ 0.1)
      block.slotOffsetX = Math.max(
        -0.1,
        Math.min(0.1, touchStartOffset.x + deltaX)
      );
      block.slotOffsetY = Math.max(
        -0.1,
        Math.min(0.1, touchStartOffset.y + deltaY)
      );

      renderBlockInSlot(blockId, slotId);
    } else if (e.touches.length === 2 && isPinching) {
      // 핀치 줌
      e.preventDefault();
      const touch1 = e.touches[0];
      const touch2 = e.touches[1];
      const distance = Math.hypot(
        touch2.clientX - touch1.clientX,
        touch2.clientY - touch1.clientY
      );
      const scaleDelta = distance / touchStartDistance;
      const newScale = touchStartScale * scaleDelta;

      // 확대 범위 제한 (1.0 ~ 1.2)
      block.slotScale = Math.max(1.0, Math.min(1.2, newScale));
      renderBlockInSlot(blockId, slotId);
    }
  });

  cutBlock.addEventListener("touchend", (e) => {
    if (e.touches.length === 0) {
      isTouchDragging = false;
      isPinching = false;
    } else if (e.touches.length === 1 && isPinching) {
      // 핀치에서 단일 터치로 전환
      isPinching = false;
      isTouchDragging = true;
      touchStartPos = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      touchStartOffset = {
        x: block.slotOffsetX || 0,
        y: block.slotOffsetY || 0,
      };
    }
  });

  slotEl.appendChild(cutBlock);
}

// 슬롯 위치에 맞춰 블록 위치 업데이트 (레거시 호환)
function updateBlockPositionForSlot(blockId, slotId) {
  renderBlockInSlot(blockId, slotId);
}

// =========================
// PROVIDED CODE INTEGRATION
// =========================

// 이모지 목록 (제공된 코드에서)
const EMOJIS = [
  "💖",
  "✨",
  "🌙",
  "⭐",
  "💫",
  "🌸",
  "🌺",
  "🌼",
  "🦋",
  "🎀",
  "💝",
  "🌈",
  "☁️",
  "💭",
  "🎵",
  "🎨",
  "📷",
  "🎬",
  "💌",
  "🔮",
];

// 색상 목록 (제공된 코드에서)
const COLORS = [
  "#FFE5E5",
  "#FFF4E5",
  "#FFFBE5",
  "#E5FFE5",
  "#E5F4FF",
  "#F0E5FF",
  "#FFE5F0",
  "#E5E5E5",
  "#FFC1CC",
  "#FFD4A3",
  "#FFFACD",
  "#C1FFC1",
  "#C1E7FF",
  "#E0C1FF",
  "#FFC1E0",
  "#D0D0D0",
];

// 제공된 코드의 editor 객체 통합
const editor = {
  init() {
    try {
      this.renderSources();
      this.setupCanvasEvents();
      this.render();
    } catch (error) {
      logError("editor.init", error);
    }
  },

  async renderSources() {
    try {
      // 컷 이미지 로드 (실제 DB에서)
      const cutsGrid = document.getElementById("cutsGrid");
      if (cutsGrid) {
        const images = await loadImages();
        if (images.length === 0) {
          cutsGrid.innerHTML =
            '<p style="text-align: center; padding: 20px; color: #999; font-size: 12px;">저장된 컷이 없습니다</p>';
        } else {
          cutsGrid.innerHTML = images
            .map(
              (image, i) => `
                    <div class="cut-item" draggable="true" data-type="image" data-url="${
                      image.image_url || image.thumbnail_url
                    }">
                        <img src="${
                          image.image_url || image.thumbnail_url
                        }" alt="Cut ${i + 1}" loading="lazy">
                    </div>
                `
            )
            .join("");

          // 드래그 이벤트 설정
          document
            .querySelectorAll('#cutsGrid [draggable="true"]')
            .forEach((el) => {
              el.addEventListener("dragstart", (e) => {
                e.dataTransfer.setData("type", el.dataset.type);
                e.dataTransfer.setData("url", el.dataset.url || "");
              });
            });
        }
      }

      // 이모지 그리드
      const emojiGrid = document.getElementById("emojiGrid");
      if (emojiGrid) {
        emojiGrid.innerHTML = EMOJIS.map(
          (emoji) => `
                <div class="emoji-item" data-type="emoji" data-content="${emoji}">${emoji}</div>
            `
        ).join("");

        // 이모지 클릭 이벤트
        document.querySelectorAll(".emoji-item").forEach((el) => {
          el.addEventListener("click", () => {
            this.addBlock({
              type: "emoji",
              content: el.dataset.content,
              x: 0.3 + Math.random() * 0.2,
              y: 0.3 + Math.random() * 0.2,
              w: 0.15,
              h: 0.15,
              style: {
                fontSize: 48,
                rotate: (Math.random() - 0.5) * 20,
                emoji: el.dataset.content,
              },
            });
          });
        });
      }

      // 색상 그리드
      const colorGrid = document.getElementById("colorGrid");
      if (colorGrid) {
        colorGrid.innerHTML = COLORS.map(
          (color) => `
                <div class="color-item" data-type="shape" data-color="${color}" 
                     style="background: ${color};"></div>
            `
        ).join("");

        // 색상 클릭 이벤트
        document.querySelectorAll(".color-item").forEach((el) => {
          el.addEventListener("click", () => {
            this.addBlock({
              type: "color",
              x: 0.1 + Math.random() * 0.2,
              y: 0.1 + Math.random() * 0.2,
              w: 0.4,
              h: 0.3,
              style: {
                background: el.dataset.color,
                opacity: 0.7,
                borderRadius: 12,
                backgroundColor: el.dataset.color,
              },
            });
          });
        });
      }
    } catch (error) {
      logError("editor.renderSources", error);
    }
  },

  setupCanvasEvents() {
    try {
      const canvas = document.getElementById("canvas");
      if (!canvas) return;

      // Drop event
      canvas.addEventListener("dragover", (e) => e.preventDefault());
      canvas.addEventListener("drop", (e) => {
        e.preventDefault();
        const type = e.dataTransfer.getData("type");
        const url = e.dataTransfer.getData("url");

        if (type === "image") {
          const rect = canvas.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.15;
          const y = (e.clientY - rect.top) / rect.height - 0.2;

          this.addBlock({
            type: "image",
            url: url,
            x: Math.max(0, Math.min(0.7, x)),
            y: Math.max(0, Math.min(0.7, y)),
            w: 0.3,
            h: 0.4,
            style: {
              borderRadius: 12,
              shadow: true,
              rotate: (Math.random() - 0.5) * 10,
              imageUrl: url,
            },
          });
        }
      });

      // Click to deselect
      canvas.addEventListener("click", (e) => {
        if (e.target === canvas || e.target.id === "emptyState") {
          selectBlock(null);
        }
      });
    } catch (error) {
      logError("editor.setupCanvasEvents", error);
    }
  },

  addBlock(blockData) {
    try {
      if (!currentMoodboardId) {
        logError("editor.addBlock", new Error("무드보드 ID 없음"), {
          blockData,
        });
        alert("무드보드를 먼저 생성해주세요.");
        return;
      }

      const newBlock = {
        moodboard_id: currentMoodboardId,
        type: blockData.type,
        x: blockData.x || 0.3,
        y: blockData.y || 0.3,
        w: blockData.w || 0.3,
        h: blockData.h || 0.3,
        z_index: blocks.length + 1,
        rotation: blockData.style?.rotate || 0,
        style: {
          ...getDefaultStyle(blockData.type),
          ...blockData.style,
        },
      };

      if (blockData.type === "image" && !blockData.url) {
        openImageSelectionModal(newBlock);
      } else {
        createBlock(newBlock);
      }
    } catch (error) {
      logError("editor.addBlock", error, { blockData });
    }
  },

  addTextBlock() {
    const text = prompt("텍스트를 입력하세요:", "감정을 남겨보세요");
    if (!text) return;

    this.addBlock({
      type: "text",
      content: text,
      x: 0.25 + Math.random() * 0.2,
      y: 0.3 + Math.random() * 0.2,
      w: 0.35,
      h: 0.15,
      style: {
        fontSize: 18,
        color: "#1f2937",
        background: "#fff",
        textAlign: "center",
        borderRadius: 12,
        rotate: (Math.random() - 0.5) * 5,
        text: text,
      },
    });
  },

  render() {
    renderBlocks();
  },

  async save() {
    try {
      await saveMoodboard();
    } catch (error) {
      logError("editor.save", error);
    }
  },

  reset() {
    try {
      if (!confirm("정말 새로 시작하시겠어요?")) return;
      blocks = [];
      selectedBlockId = null;
      renderBlocks();
      updateLayerPanel();
      const toolPanel = document.getElementById("toolPanel");
      if (toolPanel) {
        toolPanel.innerHTML = "";
        toolPanel.style.display = "none";
      }
    } catch (error) {
      logError("editor.reset", error);
    }
  },
};

// 툴바 버튼 함수들
function openBackgroundPicker() {
  try {
    // 상단에 배경색 선택 팝업 표시
    const editorTools = document.getElementById("editorTools");
    if (!editorTools) return;

    // 기존 팝업 제거
    const existingPopup = document.querySelector(".top-style-popup");
    if (existingPopup) {
      existingPopup.remove();
    }

    // 새 팝업 생성
    const popup = document.createElement("div");
    popup.className = "top-style-popup";

    popup.innerHTML = `
      <button class="close-popup-btn" onclick="closeTopStylePopup()">×</button>
      <div class="top-popup-content">
        <div class="top-popup-title">배경색 선택</div>
        <div class="background-color-grid-top">
          ${COLORS.map(
            (color) => `
            <div class="background-color-item-top" 
                 style="background: ${color};"
                 onclick="selectBackgroundColor('${color}')">
            </div>
          `
          ).join("")}
        </div>
        <div class="background-custom-color-top">
          <label>커스텀 색상</label>
          <input type="color" class="color-picker-round" id="customBackgroundColor" value="#ffffff" />
        </div>
      </div>
    `;

    editorTools.appendChild(popup);

    // 애니메이션
    setTimeout(() => {
      popup.classList.add("show");
    }, 10);

    const customColorInput = popup.querySelector("#customBackgroundColor");
    if (customColorInput) {
      customColorInput.addEventListener("change", (e) => {
        selectBackgroundColor(e.target.value);
      });
    }
  } catch (error) {
    logError("openBackgroundPicker", error);
  }
}

function selectBackgroundColor(color) {
  const canvas = document.getElementById("canvas");
  if (canvas) {
    canvas.style.backgroundColor = color;
  }
  closeTopStylePopup();
}

// 폰트 설정 및 비율 설정 함수 제거 (더 이상 필요 없음)

function openFeaturedSettings() {
  try {
    // 상단에 대표 무드보드 설정 팝업 표시
    const editorTools = document.getElementById("editorTools");
    if (!editorTools) return;

    const existingPopup = document.querySelector(".top-style-popup");
    if (existingPopup) {
      existingPopup.remove();
    }

    const popup = document.createElement("div");
    popup.className = "top-style-popup featured-popup";

    popup.innerHTML = `
      <button class="close-popup-btn" onclick="closeTopStylePopup()">×</button>
      <div class="top-popup-content">
        <div class="top-popup-title">대표 무드보드 설정</div>
        <div class="featured-setting-content">
          <p style="font-size: 13px; color: #666; text-align: center; margin-bottom: 16px;">
            대표 무드보드는 커뮤니티에 노출됩니다
          </p>
          <button class="featured-confirm-btn" onclick="setAsFeaturedMoodboard()">
            대표 무드보드로 설정
          </button>
        </div>
      </div>
    `;

    editorTools.appendChild(popup);
    setTimeout(() => {
      popup.classList.add("show");
    }, 10);
  } catch (error) {
    logError("openFeaturedSettings", error);
  }
}

// 저장 완료 팝업 표시 (필수 선택)
function showSaveSuccessPopup() {
  const editorScreen = document.getElementById("editorScreen");
  if (!editorScreen) return;

  // 기존 팝업 제거
  const existingPopup = document.querySelector(".save-success-modal");
  if (existingPopup) {
    existingPopup.remove();
  }

  // 모달 오버레이 생성
  const modal = document.createElement("div");
  modal.className = "save-success-modal";
  modal.style.cssText = `
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    animation: fadeIn 0.2s ease;
  `;

  const popup = document.createElement("div");
  popup.className = "save-success-popup-content";
  popup.style.cssText = `
    background: white;
    border-radius: 20px;
    padding: 32px 24px;
    max-width: 400px;
    width: 100%;
    text-align: center;
    animation: slideUp 0.3s ease;
  `;

  popup.innerHTML = `
    <div style="font-size: 48px; margin-bottom: 16px;">🎉</div>
    <h2 style="font-size: 20px; font-weight: 700; color: #333; margin-bottom: 8px;">
      저장되었습니다
    </h2>
    <p style="font-size: 14px; color: #666; margin-bottom: 24px;">
      이 무드보드를 어떻게 할까요?
    </p>
    <div style="display: flex; flex-direction: column; gap: 12px;">
      <button 
        class="save-success-btn-primary" 
        onclick="handleSetAsFeatured()"
        style="
          width: 100%;
          padding: 16px;
          background: #667eea;
          color: white;
          border: none;
          border-radius: 12px;
          font-size: 16px;
          font-weight: 600;
          cursor: pointer;
        ">
        대표 무드보드로 설정하기
      </button>
      <button 
        class="save-success-btn-secondary" 
        onclick="handleGoToMyPage()"
        style="
          width: 100%;
          padding: 16px;
          background: #f5f5f5;
          color: #333;
          border: none;
          border-radius: 12px;
          font-size: 16px;
          font-weight: 600;
          cursor: pointer;
        ">
        나가기
      </button>
    </div>
  `;

  modal.appendChild(popup);
  document.body.appendChild(modal);

  // 애니메이션 스타일 추가
  if (!document.getElementById("save-success-animations")) {
    const style = document.createElement("style");
    style.id = "save-success-animations";
    style.textContent = `
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @keyframes slideUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }
    `;
    document.head.appendChild(style);
  }
}

// 대표 무드보드로 설정하고 마이페이지로 이동
async function handleSetAsFeatured() {
  try {
    await setAsFeaturedMoodboard();
    // 모달 제거
    const modal = document.querySelector(".save-success-modal");
    if (modal) modal.remove();
    // 마이페이지로 이동
    handleGoToMyPage();
  } catch (error) {
    logError("handleSetAsFeatured", error);
    alert("대표 무드보드 설정 중 오류가 발생했습니다.");
  }
}

// 마이페이지로 이동
function handleGoToMyPage() {
  // 모달 제거
  const modal = document.querySelector(".save-success-modal");
  if (modal) modal.remove();

  // 페이드 + 축소 애니메이션 후 이동
  const editorScreen = document.getElementById("editorScreen");
  if (editorScreen) {
    editorScreen.style.transition = "opacity 0.3s ease, transform 0.3s ease";
    editorScreen.style.opacity = "0";
    editorScreen.style.transform = "scale(0.95)";

    setTimeout(() => {
      window.location.href = "mypage_reader.html";
    }, 300);
  } else {
    window.location.href = "mypage_reader.html";
  }
}

// 대표 무드보드 설정 확인 팝업
function showFeaturedConfirmPopup() {
  const editorTools = document.getElementById("editorTools");
  if (!editorTools) return;

  const existingPopup = document.querySelector(".top-style-popup");
  if (existingPopup) {
