      <button class="panel-btn primary" onclick="addImageLayer()">이미지 선택</button>
    </div>
  `;
}

// 텍스트 패널
function createTextPanel() {
  const fontPresets = [
    { name: "기본", family: "Pretendard, sans-serif", size: 16 },
    {
      name: "제목",
      family: "Pretendard, sans-serif",
      size: 24,
      weight: "bold",
    },
    { name: "손글씨", family: "Nanum Pen Script, cursive", size: 20 },
    { name: "모노", family: "Courier New, monospace", size: 14 },
  ];

  const sizePresets = [
    { label: "작게", size: 12 },
    { label: "보통", size: 16 },
    { label: "크게", size: 24 },
    { label: "아주 크게", size: 32 },
  ];

  const selectedBlock = selectedBlockId
    ? blocks.find((b) => b.id === selectedBlockId)
    : null;
  const isTextBlock = selectedBlock && selectedBlock.type === "text";

  return `
    <div class="panel-section">
      <h3 class="panel-title">텍스트 추가</h3>
      <button class="panel-btn primary" onclick="addTextLayer()">텍스트 추가</button>
      ${
        isTextBlock
          ? `
        <div class="panel-section">
          <h4 class="panel-subtitle">폰트 프리셋</h4>
          <div class="preset-grid">
            ${fontPresets
              .map(
                (preset, i) => `
              <button class="preset-btn" onclick="applyTextPreset(${i})">
                <span style="font-family: ${preset.family}; font-size: ${
                  preset.size
                }px; font-weight: ${preset.weight || "normal"}">Aa</span>
                <span>${preset.name}</span>
              </button>
            `
              )
              .join("")}
          </div>
        </div>
        <div class="panel-section">
          <h4 class="panel-subtitle">크기</h4>
          <div class="preset-grid">
            ${sizePresets
              .map(
                (preset, i) => `
              <button class="preset-btn" onclick="applyTextSize(${preset.size})">
                <span style="font-size: ${preset.size}px">Aa</span>
                <span>${preset.label}</span>
              </button>
            `
              )
              .join("")}
          </div>
        </div>
        <div class="panel-section">
          <h4 class="panel-subtitle">정렬</h4>
          <div class="align-buttons">
            <button class="align-btn" onclick="applyTextAlign('left')">좌</button>
            <button class="align-btn" onclick="applyTextAlign('center')">중앙</button>
          </div>
        </div>
      `
          : ""
      }
    </div>
  `;
}

// 스티커 패널
function createStickerPanel() {
  const stickers = EMOJIS || ["💖", "✨", "🌙", "⭐", "🌸", "🎀", "💕", "💝"];

  const selectedBlock = selectedBlockId
    ? blocks.find((b) => b.id === selectedBlockId)
    : null;
  const isStickerBlock = selectedBlock && selectedBlock.type === "emoji";

  return `
    <div class="panel-section">
      <h3 class="panel-title">스티커 추가</h3>
      <div class="sticker-grid">
        ${stickers
          .map(
            (emoji) => `
          <button class="sticker-btn" onclick="addStickerLayer('${emoji}')">${emoji}</button>
        `
          )
          .join("")}
      </div>
      ${
        isStickerBlock
          ? `
        <div class="panel-section">
          <h4 class="panel-subtitle">회전</h4>
          <div class="align-buttons">
            <button class="align-btn" onclick="rotateSticker(-15)">↺ -15°</button>
            <button class="align-btn" onclick="rotateSticker(15)">↻ +15°</button>
            <button class="align-btn" onclick="rotateSticker(-90)">↺ -90°</button>
            <button class="align-btn" onclick="rotateSticker(90)">↻ +90°</button>
          </div>
        </div>
      `
          : ""
      }
    </div>
  `;
}

// 배경 패널
function createBackgroundPanel() {
  const colors = [
    "#FFFFFF",
    "#F8FAFC",
    "#F1F5F9",
    "#E2E8F0",
    "#FEF3C7",
    "#FDE68A",
    "#FCD34D",
    "#FBBF24",
    "#DBEAFE",
    "#BFDBFE",
    "#93C5FD",
    "#60A5FA",
    "#E9D5FF",
    "#DDD6FE",
    "#C4B5FD",
    "#A78BFA",
  ];

  return `
    <div class="panel-section">
      <h3 class="panel-title">배경 색상</h3>
      <div class="color-grid">
        ${colors
          .map(
            (color) => `
          <button class="color-btn" style="background: ${color}" onclick="setBackgroundColor('${color}')"></button>
        `
          )
          .join("")}
      </div>
    </div>
  `;
}

// 효과 패널 (무드 프리셋 방식)
function createEffectPanel() {
  const presets = EffectPresetManager.getPresetList();
  const selectedBlock = selectedBlockId
    ? blocks.find((b) => b.id === selectedBlockId)
    : null;
  const currentPreset = selectedBlock?.style?.effectPreset || null;

  return `
    <div class="panel-section">
      <h3 class="panel-title">무드 프리셋</h3>
      <div class="mood-preset-grid">
        ${presets
          .map(
            (preset) => `
          <button 
            class="mood-preset-btn ${
              currentPreset === preset.id ? "active" : ""
            }"
            onclick="EffectPresetManager.applyPreset('${
              selectedBlockId || ""
            }', '${preset.id}'); closeBottomSheet();"
            ${!selectedBlockId ? "disabled" : ""}
          >
            <div class="mood-preset-preview" style="
              background: ${preset.backgroundTone};
              border-radius: ${preset.borderRadius}px;
              box-shadow: ${preset.shadow};
              border: ${preset.border};
              opacity: ${preset.opacity};
              width: 60px;
              height: 60px;
              margin: 0 auto 8px;
            "></div>
            <span class="mood-preset-name">${preset.name}</span>
          </button>
        `
          )
          .join("")}
      </div>
      ${
        !selectedBlockId
          ? '<p class="panel-hint">요소를 선택하면 무드를 적용할 수 있습니다</p>'
          : ""
      }
    </div>
  `;
}

// 편집(Adjust) 패널
function createAdjustPanel() {
  const selectedBlock = selectedBlockId
    ? blocks.find((b) => b.id === selectedBlockId)
    : null;

  if (!selectedBlock) {
    return `
      <div class="panel-section">
        <h3 class="panel-title">조정</h3>
        <p class="panel-hint">요소를 선택하면 조정할 수 있습니다</p>
      </div>
    `;
  }

  const isImage =
    selectedBlock.type === "image" || selectedBlock.type === "cut";
  const currentFit = selectedBlock.style?.objectFit || "cover";

  return `
    <div class="panel-section">
      <h3 class="panel-title">조정</h3>
      ${
        isImage
          ? `
        <div class="adjust-group">
          <label>맞추기</label>
          <div class="adjust-buttons">
            <button 
              class="adjust-btn ${currentFit === "cover" ? "active" : ""}"
              onclick="adjustImageFit('${selectedBlock.id}', 'cover')"
            >
              꽉 채우기
            </button>
            <button 
              class="adjust-btn ${currentFit === "contain" ? "active" : ""}"
              onclick="adjustImageFit('${selectedBlock.id}', 'contain')"
            >
              맞추기
            </button>
          </div>
        </div>
        <div class="adjust-group">
          <label>위치</label>
          <div class="adjust-buttons">
            <button class="adjust-btn" onclick="centerSelectedBlock('${
              selectedBlock.id
            }')">
              중앙 정렬
            </button>
          </div>
        </div>
      `
          : `
        <div class="adjust-group">
          <label>위치</label>
          <div class="adjust-buttons">
            <button class="adjust-btn" onclick="centerSelectedBlock('${selectedBlock.id}')">
              중앙 정렬
            </button>
          </div>
        </div>
      `
      }
      <div class="panel-hint">
        드래그로 위치 이동, 핀치로 크기 조절이 가능합니다
      </div>
    </div>
  `;
}

// 정렬(Align) 패널
function createAlignPanel() {
  const selectedBlock = selectedBlockId
    ? blocks.find((b) => b.id === selectedBlockId)
    : null;

  if (!selectedBlock) {
    return `
      <div class="panel-section">
        <h3 class="panel-title">정렬</h3>
        <p class="panel-hint">요소를 선택하면 정렬할 수 있습니다</p>
      </div>
    `;
  }

  return `
    <div class="panel-section">
      <h3 class="panel-title">정렬</h3>
      <div class="align-preset-grid">
        <button class="align-preset-btn" onclick="alignBlock('${selectedBlock.id}', 'left-top')">
          <span>↖</span>
          <span>좌상</span>
        </button>
        <button class="align-preset-btn" onclick="alignBlock('${selectedBlock.id}', 'center-top')">
          <span>↑</span>
          <span>상단</span>
        </button>
        <button class="align-preset-btn" onclick="alignBlock('${selectedBlock.id}', 'right-top')">
          <span>↗</span>
          <span>우상</span>
        </button>
        <button class="align-preset-btn" onclick="alignBlock('${selectedBlock.id}', 'left-center')">
          <span>←</span>
          <span>좌측</span>
        </button>
        <button class="align-preset-btn active" onclick="alignBlock('${selectedBlock.id}', 'center-center')">
          <span>⊙</span>
          <span>중앙</span>
        </button>
        <button class="align-preset-btn" onclick="alignBlock('${selectedBlock.id}', 'right-center')">
          <span>→</span>
          <span>우측</span>
        </button>
        <button class="align-preset-btn" onclick="alignBlock('${selectedBlock.id}', 'left-bottom')">
          <span>↙</span>
          <span>좌하</span>
        </button>
        <button class="align-preset-btn" onclick="alignBlock('${selectedBlock.id}', 'center-bottom')">
          <span>↓</span>
          <span>하단</span>
        </button>
        <button class="align-preset-btn" onclick="alignBlock('${selectedBlock.id}', 'right-bottom')">
          <span>↘</span>
          <span>우하</span>
        </button>
      </div>
    </div>
  `;
}

// 레이아웃 패널
function createLayoutPanel() {
  return `
    <div class="panel-section">
      <h3 class="panel-title">레이아웃</h3>
      <p class="panel-hint">템플릿을 변경하려면 상단 메뉴를 사용하세요</p>
    </div>
  `;
}

// 레이어 추가 함수들
function addImageLayer() {
  closeBottomSheet();

  // 템플릿 모드이고 슬롯이 선택되지 않았으면 main 슬롯 자동 선택
  if (editorMode === "template" && !currentSlotId) {
    const mainSlotId = selectMainSlot();
    if (mainSlotId) {
      openImageSelectionModalForSlot(mainSlotId);
      return;
    }
  }

  // 슬롯이 선택된 경우 해당 슬롯에 이미지 추가
  if (currentSlotId) {
    openImageSelectionModalForSlot(currentSlotId);
  } else {
    // 자유형 모드 또는 슬롯이 없는 경우
    openImageSelectionModalForDrag();
  }
}

function addTextLayer() {
  closeBottomSheet();

  // 템플릿 모드에서는 텍스트를 자유형으로 추가
  if (editorMode === "template") {
    // 템플릿 모드에서는 텍스트를 중앙에 추가
    const canvas = document.getElementById("canvas");
    if (canvas) {
      const canvasRect = canvas.getBoundingClientRect();
      const canvasWidth = canvasRect.width - 40;
      const canvasHeight = canvasRect.height - 40;

      const newBlock = {
        moodboard_id: currentMoodboardId,
        type: "text",
        x: 0.3,
        y: 0.45,
        w: 0.4,
        h: 0.1,
        z_index: blocks.length + 1,
        rotation: 0,
        style: {
          text: "텍스트를 입력하세요",
          fontSize: 16,
        },
      };

      createBlock(newBlock);
    }
  } else {
    addBlock("text");
  }
}

function addStickerLayer(emoji) {
  closeBottomSheet();

  const canvas = document.getElementById("canvas");
  if (!canvas) return;

  const canvasRect = canvas.getBoundingClientRect();
  const canvasWidth = canvasRect.width - 40;
  const canvasHeight = canvasRect.height - 40;

  // 템플릿 모드에서는 중앙에 추가
  let x = 0.4;
  let y = 0.4;

  if (editorMode === "template" && currentSlotId) {
    // 선택된 슬롯 위치에 추가
    const slot = currentTemplate?.slots?.find((s) => s.id === currentSlotId);
    if (slot) {
      x = slot.x + slot.size / 2 - 0.075;
      y = slot.y + slot.size / 2 - 0.075;
    }
  }

  const newBlock = {
    moodboard_id: currentMoodboardId,
    type: "emoji",
    emoji: emoji,
    x: x,
    y: y,
    w: 0.15,
    h: 0.15,
    z_index: blocks.length + 1,
    rotation: 0,
    style: {
      emoji: emoji,
      fontSize: 48,
    },
  };

  createBlock(newBlock);
}

function setBackgroundColor(color) {
  const canvas = document.getElementById("canvas");
  if (canvas) {
    canvas.style.backgroundColor = color;
  }
  closeBottomSheet();
}

function applyPreset(type, value) {
  if (!selectedBlockId) return;

  const block = blocks.find((b) => b.id === selectedBlockId);
  if (!block) return;

  switch (type) {
    case "shadow":
      if (value === "none") {
        block.style.boxShadow = "none";
      } else if (value === "soft") {
        block.style.boxShadow = "0 4px 12px rgba(0, 0, 0, 0.1)";
      }
      break;
    case "border":
      if (value === "on") {
        block.style.borderWidth = "2px";
        block.style.borderColor = "#e5e7eb";
        block.style.borderStyle = "solid";
      } else {
        block.style.borderWidth = "0";
      }
      break;
    case "round":
      if (value === "small") {
        block.style.borderRadius = "8px";
      } else if (value === "medium") {
        block.style.borderRadius = "16px";
      }
      break;
    case "effect":
      if (value === "sparkle") {
        block.style.filter = "drop-shadow(0 0 4px rgba(255, 255, 255, 0.8))";
      } else if (value === "paper") {
        block.style.opacity = "0.95";
        block.style.filter = "contrast(1.1)";
      }
      break;
  }

  renderBlocks();
}

function applyTextPreset(index) {
  if (!selectedBlockId) return;
  const block = blocks.find((b) => b.id === selectedBlockId);
  if (!block || block.type !== "text") return;

  const fontPresets = [
    { family: "Pretendard, sans-serif", size: 16 },
    { family: "Pretendard, sans-serif", size: 24, weight: "bold" },
    { family: "Nanum Pen Script, cursive", size: 20 },
    { family: "Courier New, monospace", size: 14 },
  ];

  const preset = fontPresets[index];
  if (preset) {
    block.style = block.style || {};
    block.style.fontFamily = preset.family;
    block.style.fontSize = preset.size;
    if (preset.weight) block.style.fontWeight = preset.weight;
    renderBlocks();
  }
}

function applyTextSize(size) {
  if (!selectedBlockId) return;
  const block = blocks.find((b) => b.id === selectedBlockId);
  if (block && block.type === "text") {
    block.style = block.style || {};
    block.style.fontSize = size;
    renderBlocks();
  }
}

function rotateSticker(angle) {
  if (!selectedBlockId) return;
  const block = blocks.find((b) => b.id === selectedBlockId);
  if (block && block.type === "emoji") {
    block.rotation = (block.rotation || 0) + angle;
    renderBlocks();
  }
}

function applyTextAlign(align) {
  if (!selectedBlockId) return;
  const block = blocks.find((b) => b.id === selectedBlockId);
  if (block && block.type === "text") {
    block.style.textAlign = align;
    renderBlocks();
  }
}

// 전역 함수로 export
window.openToolPanel = openToolPanel;
window.closeBottomSheet = closeBottomSheet;
window.updateToolbarUI = updateToolbarUI;
window.addImageLayer = addImageLayer;
window.addTextLayer = addTextLayer;
window.addStickerLayer = addStickerLayer;
window.setBackgroundColor = setBackgroundColor;
window.applyPreset = applyPreset;
window.applyTextPreset = applyTextPreset;
window.applyTextAlign = applyTextAlign;
window.applyTextSize = applyTextSize;
window.rotateSticker = rotateSticker;
window.adjustImageFit = adjustImageFit;
window.centerSelectedBlock = centerSelectedBlock;
window.alignBlock = alignBlock;
window.replaceCutImage = replaceCutImage;
window.removeCutImage = removeCutImage;
window.EffectPresetManager = EffectPresetManager;
window.BottomSheetManager = BottomSheetManager;
window.selectSlot = selectSlot;
window.selectMainSlot = selectMainSlot;

// 이미지 fit 조정
function adjustImageFit(blockId, fit) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block || (block.type !== "image" && block.type !== "cut")) return;

  const blockElement = document.querySelector(`[data-id="${blockId}"]`);
  if (!blockElement) return;

  const img = blockElement.querySelector("img");
  if (!img) return;

  img.style.objectFit = fit;
  block.style = block.style || {};
  block.style.objectFit = fit;

  renderBlocks();
}

// 이미지 fit 토글 (꽉 채우기/맞추기) - 하위 호환성
function toggleImageFit(blockId) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block || (block.type !== "image" && block.type !== "cut")) return;

  const currentFit = block.style?.objectFit || "cover";
  const newFit = currentFit === "cover" ? "contain" : "cover";
  adjustImageFit(blockId, newFit);
}

// 선택된 블록 중앙 정렬
function centerSelectedBlock(blockId) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  const canvas = document.getElementById("canvas");
  if (!canvas) return;

  const canvasRect = canvas.getBoundingClientRect();
  const canvasWidth = canvasRect.width - 40;
  const canvasHeight = canvasRect.height - 40;

  // 중앙 위치 계산
  block.x = (1 - block.w) / 2;
  block.y = (1 - block.h) / 2;

  renderBlocks();
  selectBlock(blockId);
}

// 블록 정렬
function alignBlock(blockId, position) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block) return;

  const canvas = document.getElementById("canvas");
  if (!canvas) return;

  const canvasRect = canvas.getBoundingClientRect();
  const canvasWidth = canvasRect.width - 40;
  const canvasHeight = canvasRect.height - 40;

  const [hAlign, vAlign] = position.split("-");

  // 수평 정렬
  if (hAlign === "left") {
    block.x = 0.05;
  } else if (hAlign === "center") {
    block.x = (1 - block.w) / 2;
  } else if (hAlign === "right") {
    block.x = 0.95 - block.w;
  }

  // 수직 정렬
  if (vAlign === "top") {
    block.y = 0.05;
  } else if (vAlign === "center") {
    block.y = (1 - block.h) / 2;
  } else if (vAlign === "bottom") {
    block.y = 0.95 - block.h;
  }

  renderBlocks();
  selectBlock(blockId);
}

// 컷 교체
function replaceCutImage(blockId) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block || (block.type !== "image" && block.type !== "cut")) return;

  closeBottomSheet();

  // 슬롯에 속한 경우
  if (block.slotId) {
    openImageSelectionModalForSlot(block.slotId);
  } else {
    openImageSelectionModalForBlock(blockId);
  }
}

// 컷 삭제
function removeCutImage(blockId) {
  const block = blocks.find((b) => b.id === blockId);
  if (!block || (block.type !== "image" && block.type !== "cut")) return;

  if (!confirm("이 컷을 삭제하시겠습니까?")) return;

  // 이미지 소스만 제거 (레이어는 유지)
  block.style = block.style || {};
  block.style.imageUrl = null;
  block.url = null;

  renderBlocks();
  selectBlock(null);
}
