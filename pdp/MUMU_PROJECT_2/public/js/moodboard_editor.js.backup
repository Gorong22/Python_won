      <div class="featured-setting-content">
        <p style="font-size: 13px; color: #666; text-align: center; margin-bottom: 16px;">
          대표 무드보드는 커뮤니티에 노출됩니다
        </p>
        <button class="featured-confirm-btn" onclick="setAsFeaturedMoodboard()">
          대표 무드보드로 설정
        </button>
        <button class="featured-cancel-btn" onclick="closeTopStylePopup()">
          취소
        </button>
      </div>
    </div>
  `;

  editorTools.appendChild(popup);
  setTimeout(() => {
    popup.classList.add("show");
  }, 10);
}

// 대표 무드보드로 설정
async function setAsFeaturedMoodboard() {
  try {
    if (!currentMoodboardId) {
      alert("무드보드가 없습니다.");
      return;
    }

    // 사용자 확인
    const user = await getCurrentUser();
    if (!user || !user.uid) {
      alert("로그인이 필요합니다.");
      return;
    }

    if (!supabaseClient) {
      alert("서비스 연결에 실패했습니다.");
      return;
    }

    // 1. 기존 대표 무드보드 찾아서 is_featured = false 처리
    const { data: existingEvents } = await supabaseClient
      .from("user_feed_events")
      .select("id, metadata")
      .eq("user_id", user.uid)
      .eq("event_type", "moodboard_created");

    if (existingEvents && existingEvents.length > 0) {
      // 기존 대표 무드보드 찾기
      const featuredEvents = existingEvents.filter(
        (e) =>
          e.metadata?.is_featured === true ||
          e.metadata?.moodboard_data?.is_featured === true
      );

      // 기존 대표 무드보드들 is_featured = false 처리
      for (const event of featuredEvents) {
        const updatedMetadata = {
          ...event.metadata,
          is_featured: false,
        };
        if (updatedMetadata.moodboard_data) {
          updatedMetadata.moodboard_data.is_featured = false;
        }

        await supabaseClient
          .from("user_feed_events")
          .update({ metadata: updatedMetadata })
          .eq("id", event.id);
      }
    }

    // 2. 현재 무드보드의 user_feed_events 찾아서 is_featured = true 설정
    const { data: currentEvents } = await supabaseClient
      .from("user_feed_events")
      .select("id, metadata")
      .eq("user_id", user.uid)
      .eq("event_type", "moodboard_created");

    if (currentEvents && currentEvents.length > 0) {
      const currentEvent = currentEvents.find(
        (e) => e.metadata?.moodboard_id === currentMoodboardId
      );

      if (currentEvent) {
        const updatedMetadata = {
          ...currentEvent.metadata,
          is_featured: true,
        };
        if (updatedMetadata.moodboard_data) {
          updatedMetadata.moodboard_data.is_featured = true;
        }

        const { error: updateError } = await supabaseClient
          .from("user_feed_events")
          .update({ metadata: updatedMetadata })
          .eq("id", currentEvent.id);

        if (updateError) {
          throw updateError;
        }
      }
    }

    console.log("[대표 무드보드] 설정 완료:", currentMoodboardId);
  } catch (error) {
    logError("setAsFeaturedMoodboard", error);
    alert(
      "설정 중 오류가 발생했습니다: " + (error.message || "알 수 없는 오류")
    );
    throw error;
  }
}

