/**
 * Supabase readers 테이블에서 독자 닉네임 가져오기
 * @param {string} firebaseUid - Firebase UID
 * @returns {Promise<string|null>} 닉네임 또는 null
 */
async function getReaderNickname(firebaseUid) {
  if (!firebaseUid) return null;

  // 캐시 확인 (null은 캐시하지 않음 - 다음에 다시 시도 가능하도록)
  if (nicknameCache.has(firebaseUid)) {
    const cached = nicknameCache.get(firebaseUid);
    return cached === "__NULL__" ? null : cached;
  }

  try {
    const supabaseClient = await loadSupabaseClient();
    if (!supabaseClient) return null;

    const { data: readerData, error } = await supabaseClient
      .from("readers")
      .select("nickname")
      .eq("firebase_uid", firebaseUid)
      .maybeSingle();

    if (!error && readerData && readerData.nickname) {
      nicknameCache.set(firebaseUid, readerData.nickname);
      return readerData.nickname;
    }
  } catch (e) {
    console.warn("[Mypage] 닉네임 조회 실패:", e);
  }

  // null은 캐시하지 않음 (다음에 다시 시도 가능하도록)
  return null;
}

/**
 * 안전하게 닉네임을 표시하는 유틸 함수
 * @param {HTMLElement} el - 표시할 DOM 요소
 * @param {string|null} name - 닉네임 (null 가능)
 * @param {string} fallbackUid - fallback으로 사용할 UID
 */
function setDisplayNameSafely(el, name, fallbackUid) {
  if (!el) return;
  if (name && name.trim()) {
    el.textContent = name;
  } else if (fallbackUid) {
    el.textContent = `@${fallbackUid.substring(0, 6)}`;
  } else {
    el.textContent = "@unknown";
  }
}

/**
 * 닉네임을 렌더링하는 단일 함수 (리더 전용)
 * @param {string} elementId - DOM 요소 ID
 * @param {string} firebaseUid - Firebase UID
 * @param {string} prefix - 접두사 (예: "@", 기본값: "")
 */
async function renderNickname(elementId, firebaseUid, prefix = "") {
  const el = document.getElementById(elementId);
  if (!el || el.dataset.nicknameSet === "true") return; // 이미 설정됨

  // Supabase readers 테이블에서 닉네임 가져오기 (리더 전용)
  const displayName = await getReaderNickname(firebaseUid);

  // 최종 렌더링 (fallback 포함)
  if (displayName && displayName.trim()) {
    el.textContent = prefix ? `${prefix}${displayName}` : displayName;
  } else {
    el.textContent = prefix
      ? `${prefix}${firebaseUid.substring(0, 6)}`
      : `@${firebaseUid.substring(0, 6)}`;
  }

  el.dataset.nicknameSet = "true"; // 중복 설정 방지 플래그
}

