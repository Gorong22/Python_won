    const links = lines.slice(1).join("\n") || "";

    // Supabase readers 테이블에 프로필 정보 저장/업데이트
    const { error } = await supabaseClient.from("readers").upsert(
      {
        firebase_uid: firebaseUser.uid,
        nickname: nickname,
        bio: bio,
        links: links,
        updated_at: new Date().toISOString(),
      },
      {
        onConflict: "firebase_uid",
      }
    );

    if (error) {
      throw error;
    }

    console.log("[설정] 프로필 저장 완료");
