// 드래그 핸들러 설정 (interact.js 사용)
function setupCanvasDragHandlers() {
  const canvas = document.getElementById("step3-canvas");
  if (!canvas || typeof interact === "undefined") {
    // interact.js가 없으면 기본 드래그 사용
    setupBasicDragHandlers();
    return;
  }

  // interact.js로 드래그/리사이즈/회전 설정
  interact(".canvas-item")
    .draggable({
      listeners: {
        start(event) {
          const itemId = event.target.dataset.itemId;
          selectCanvasItem(itemId);
        },
        move(event) {
          const item = step3CanvasItems.find(
            (i) => i.id === event.target.dataset.itemId
          );
          if (!item) return;

          const canvasRect = canvas.getBoundingClientRect();
          let newX = item.x + event.dx;
          let newY = item.y + event.dy;

          // 8px 스냅
          newX = Math.round(newX / 8) * 8;
          newY = Math.round(newY / 8) * 8;

          // 경계 체크
          newX = Math.max(
            0,
            Math.min(newX, canvasRect.width - (item.width || 100))
          );
          newY = Math.max(
            0,
            Math.min(newY, canvasRect.height - (item.height || 50))
          );

          item.x = newX;
          item.y = newY;

          event.target.style.transform = `translate(${newX - item.x}px, ${
            newY - item.y
          }px)`;
        },
        end(event) {
          const item = step3CanvasItems.find(
            (i) => i.id === event.target.dataset.itemId
          );
          if (item) {
            event.target.style.transform = "";
            renderStep3Canvas();
          }
        },
      },
      modifiers: [
        interact.modifiers.restrict({
          restriction: canvas,
          endOnly: true,
        }),
      ],
    })
    .resizable({
      edges: { left: true, right: true, top: true, bottom: true },
      listeners: {
        start(event) {
          const itemId = event.target.dataset.itemId;
          selectCanvasItem(itemId);
        },
        move(event) {
          const item = step3CanvasItems.find(
            (i) => i.id === event.target.dataset.itemId
          );
          if (!item) return;

          let width = event.rect.width;
          let height = event.rect.height;

          // 최소 크기
          width = Math.max(50, width);
          height = Math.max(50, height);

          // 8px 스냅
          width = Math.round(width / 8) * 8;
          height = Math.round(height / 8) * 8;

          item.width = width;
          item.height = height;

          // 위치 조정 (리사이즈 핸들 위치에 따라)
          if (event.edges.left) {
            item.x += event.deltaRect.left;
          }
          if (event.edges.top) {
            item.y += event.deltaRect.top;
          }

          event.target.style.width = width + "px";
          event.target.style.height = height + "px";
        },
        end(event) {
          renderStep3Canvas();
        },
      },
      modifiers: [
        interact.modifiers.restrictSize({
          min: { width: 50, height: 50 },
        }),
      ],
    })
    .gesturable({
      listeners: {
        start(event) {
          const itemId = event.target.dataset.itemId;
          selectCanvasItem(itemId);
        },
        move(event) {
          const item = step3CanvasItems.find(
            (i) => i.id === event.target.dataset.itemId
          );
          if (!item) return;

          // 회전 각도 저장 (도 단위)
          item.rotation = (item.rotation || 0) + event.da;
          event.target.style.transform = `rotate(${item.rotation}deg)`;
        },
        end(event) {
          renderStep3Canvas();
        },
      },
    });
}

// 기본 드래그 핸들러 (interact.js 없을 때)
function setupBasicDragHandlers() {
  const canvas = document.getElementById("step3-canvas");
  if (!canvas) return;

  let dragItem = null;
  let dragOffset = { x: 0, y: 0 };

  canvas.addEventListener("pointerdown", (e) => {
    const item = e.target.closest(".canvas-item");
    if (!item) {
      selectedItemId = null;
      renderStep3Canvas();
      return;
    }

    const itemId = item.dataset.itemId;
    selectCanvasItem(itemId);

    // 텍스트 편집 중이면 드래그 시작하지 않음
    if (e.target.classList.contains("canvas-text-content")) {
      return;
    }

    dragItem = step3CanvasItems.find((i) => i.id === itemId);
    if (!dragItem) return;

    const rect = item.getBoundingClientRect();
    const canvasRect = canvas.getBoundingClientRect();
    dragOffset.x = e.clientX - rect.left;
    dragOffset.y = e.clientY - rect.top;

    isDragging = true;
    item.style.transition = "none";
    e.preventDefault();
  });

  canvas.addEventListener("pointermove", (e) => {
    if (!isDragging || !dragItem) return;

    const canvas = document.getElementById("step3-canvas");
    const canvasRect = canvas.getBoundingClientRect();

    const newX = e.clientX - canvasRect.left - dragOffset.x;
    const newY = e.clientY - canvasRect.top - dragOffset.y;

    dragItem.x = Math.max(
      0,
      Math.min(newX, canvasRect.width - (dragItem.width || 100))
    );
    dragItem.y = Math.max(
      0,
      Math.min(newY, canvasRect.height - (dragItem.height || 50))
    );

    renderStep3Canvas();
    e.preventDefault();
  });

  canvas.addEventListener("pointerup", () => {
    if (isDragging && dragItem) {
      const item = document.querySelector(`[data-item-id="${dragItem.id}"]`);
      if (item) {
        item.style.transition = "";
      }
    }
    isDragging = false;
    dragItem = null;
  });
}

