async function openSettingsModal() {
  // 설정 모달 열 때 현재 프로필 정보 로드
  const firebaseUser = await ensureFirebaseUser();
  if (firebaseUser) {
    try {
      const supabaseClient = await loadSupabaseClient();
      if (supabaseClient) {
        // Supabase readers 테이블에서 프로필 정보 가져오기
        const { data: readerData, error } = await supabaseClient
          .from("readers")
          .select("nickname, bio, links")
          .eq("firebase_uid", firebaseUser.uid)
          .maybeSingle();

        if (!error && readerData) {
        // 설정 모달의 입력 필드에 현재 값 설정
        const nameInput = document.getElementById("profileNameInput");
        const bioInput = document.getElementById("profileBioInput");

        if (nameInput) {
            nameInput.value = readerData.nickname || "";
        }
        if (bioInput) {
            const bio = readerData.bio || "";
            const links = readerData.links || "";
          bioInput.value = bio ? `${bio}${links ? `\n${links}` : ""}` : links;
          }
        }
      }
    } catch (error) {
      console.error("[설정] 프로필 정보 로드 오류:", error);
    }
  }

  // 설정 모달 표시
  const modal = document.getElementById("settingsModal");
  if (modal) {
    modal.classList.add("active");
  }
}

