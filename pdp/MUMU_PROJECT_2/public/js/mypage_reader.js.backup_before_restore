            .slice(0, 3)
            .map((genre) => `<span class="tag">${genre}</span>`)
            .join("");
        } else {
          // 장르가 없으면 빈 상태
          tagListEl.innerHTML = "";
        }
      }
    } else {
      console.log(
        "[프로필] 리더 정보를 찾을 수 없습니다. Supabase에 데이터가 없습니다."
      );
