function initializeStep3React() {
  const previewCanvas = document.getElementById("step3-preview-canvas-react");
  if (!previewCanvas) return;

  // 선택된 컷들을 레이아웃에 맞게 배치
  renderStep3Preview();
}

function renderStep3Preview() {
  const previewCanvas = document.getElementById("step3-preview-canvas-react");
  if (!previewCanvas || selectedCutsForMoodboardReact.length === 0) return;

  // 레이아웃에 따라 미리보기 렌더링
  let previewHTML = "";

  switch (selectedLayoutReact) {
    case "clean-grid":
      previewHTML = renderCleanGridLayout();
      break;
    case "diary":
      previewHTML = renderDiaryLayout();
      break;
    case "collage":
      previewHTML = renderCollageLayout();
      break;
    case "vertical":
      previewHTML = renderVerticalLayout();
      break;
    case "chaos":
      previewHTML = renderChaosLayout();
      break;
    default:
      previewHTML = renderCleanGridLayout();
  }

  previewCanvas.innerHTML = previewHTML;
}

function renderCleanGridLayout() {
  const cols = Math.ceil(Math.sqrt(selectedCutsForMoodboardReact.length));
  return `
    <div style="display: grid; grid-template-columns: repeat(${cols}, 1fr); gap: 12px; padding: 16px;">
      ${selectedCutsForMoodboardReact
        .map(
          (cut) => `
        <img src="${
          cut.imageUrl || cut.image_url || ""
        }" style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px;" />
      `
        )
        .join("")}
    </div>
  `;
}

function renderDiaryLayout() {
  return `
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px; padding: 16px;">
      <img src="${
        selectedCutsForMoodboardReact[0]?.imageUrl || ""
      }" style="width: 100%; height: 200px; object-fit: cover; border-radius: 8px;" />
      <div style="display: flex; flex-direction: column; gap: 12px;">
