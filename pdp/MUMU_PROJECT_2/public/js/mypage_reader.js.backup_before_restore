function updateStep2Preview() {
  const previewArea = document.getElementById("step2-preview");
  if (!previewArea || selectedCutsForMoodboard.length === 0) return;

  if (selectedMoodStyle && selectedLayout) {
    previewArea.style.display = "block";
    generateMoodPreview();
  }
}

function generateMoodPreview() {
  const previewCanvas = document.getElementById("mood-preview-canvas");
  if (!previewCanvas || selectedCutsForMoodboard.length === 0) return;

  if (!selectedLayout) return;

  const gap =
    selectedDensity === "spacious"
      ? 20
      : selectedDensity === "compact"
      ? 8
      : 12;
  const bgColor = getMoodBackgroundColor(selectedMoodStyle);

  let layoutHTML = "";

  switch (selectedLayout) {
    case "grid":
      layoutHTML = generateGridLayout(gap);
      break;
    case "masonry":
      layoutHTML = generateMasonryLayout(gap);
      break;
    case "vertical-story":
      layoutHTML = generateVerticalStoryLayout(gap);
      break;
    case "horizontal-flow":
      layoutHTML = generateHorizontalFlowLayout(gap);
      break;
    case "collage":
      layoutHTML = generateCollageLayout(gap);
      break;
    case "diary-page":
      layoutHTML = generateDiaryPageLayout(gap);
      break;
    case "photo-quote":
      layoutHTML = generatePhotoQuoteLayout(gap);
      break;
    case "scrapbook-lite":
      layoutHTML = generateScrapbookLiteLayout(gap);
      break;
    default:
      layoutHTML = generateGridLayout(gap);
  }

  previewCanvas.innerHTML = `
    <div class="mood-preview-container" style="background-color: ${bgColor}; padding: ${gap}px; border-radius: 8px;">
      ${layoutHTML}
    </div>
  `;
}

function generateGridLayout(gap) {
  const cols = Math.ceil(Math.sqrt(selectedCutsForMoodboard.length));
  return `
    <div style="display: grid; grid-template-columns: repeat(${cols}, 1fr); gap: ${gap}px;">
      ${selectedCutsForMoodboard
        .slice(0, 6)
        .map(
          (cut) => `
        <img src="${
          cut.imageUrl || cut.image_url || ""
        }" style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px;" />
      `
        )
        .join("")}
    </div>
  `;
}

