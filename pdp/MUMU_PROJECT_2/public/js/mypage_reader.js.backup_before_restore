/**
 * 무드보드 저장
 */
window.saveMoodboardFromStepsReact = async function () {
  if (selectedCutsForMoodboardReact.length < 3) {
    alert("최소 3개 이상의 컷을 선택해주세요");
    return;
  }

  if (!selectedLayoutReact) {
    alert("레이아웃을 선택해주세요");
    return;
  }

  try {
    const firebaseUser = await ensureFirebaseUser();
    if (!firebaseUser) {
      alert("로그인이 필요합니다");
      return;
    }

    const supabaseClient = await loadSupabaseClient();
    if (!supabaseClient) {
      alert("서비스에 연결할 수 없습니다");
      return;
    }

    // 무드보드 데이터 구성
    const moodboardData = {
      name: "새 무드보드",
      layout: selectedLayoutReact,
      cuts: selectedCutsForMoodboardReact.map((cut) => cut.id),
      blocks: selectedCutsForMoodboardReact.map((cut, index) => ({
        type: "image",
        image_url: cut.imageUrl || cut.image_url,
        order_index: index,
        x: 0,
        y: 0,
        width: 150,
        height: 150,
      })),
      backgroundColor: "#FFFFFF",
      is_public: true,
    };

    // user_feed_events에 저장
    const { data, error } = await supabaseClient
      .from("user_feed_events")
      .insert({
        user_id: firebaseUser.uid,
        event_type: "moodboard_created",
        metadata: moodboardData,
      })
      .select()
      .single();

    if (error) {
      console.error("[무드보드 저장] 오류:", error);
      alert("무드보드 저장에 실패했습니다");
      return;
    }

    console.log("[무드보드 저장] 성공:", data);

    // 모달 닫기
    closeMoodboardCreateModalReact();

    // 무드보드 목록 새로고침
    await loadMoodboards();
    await loadMyMoodMoodboards();

    alert("무드보드가 저장되었습니다");
  } catch (error) {
    console.error("[무드보드 저장] 예외:", error);
    alert("무드보드 저장 중 오류가 발생했습니다");
  }
};

function closeMoodboardCreateModalReact() {
  const modal = document.getElementById("moodboardCreateModal");
  if (modal) {
    modal.style.display = "none";
  }

  // 모든 step 숨기기
  document.querySelectorAll(".moodboard-step-react").forEach((step) => {
    step.classList.remove("active");
  });

  // Step 1로 리셋
  const step1 = document.getElementById("moodboard-step-1");
  if (step1) {
    step1.classList.add("active");
  }

  selectedCutsForMoodboardReact = [];
  selectedLayoutReact = null;
}

// 기존 closeMoodboardCreateModal도 React 스타일 모달 지원
const originalCloseMoodboardCreateModal = window.closeMoodboardCreateModal;
window.closeMoodboardCreateModal = function () {
  // React 스타일 모달이 열려있으면 React 스타일로 닫기
  const reactStep1 = document.getElementById("moodboard-step-1");
  if (reactStep1 && reactStep1.classList.contains("active")) {
    closeMoodboardCreateModalReact();
  } else {
    // 기존 방식으로 닫기
    if (originalCloseMoodboardCreateModal) {
      originalCloseMoodboardCreateModal();
    }
  }
};

