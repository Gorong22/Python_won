    });
    emojiBtn.addEventListener("mouseleave", () => {
      emojiBtn.style.background = "transparent";
    });
    emojiBtn.addEventListener("click", () => {
      // 스티커 컨텍스트인 경우
      if (currentEmojiPickerContext === "sticker") {
        emojiStickers.push({
          id: Date.now(),
          emoji: emoji,
          position: "top-right",
        });
        renderEmojiStickers();
        generateFinalMoodboard();
        closeEmojiPickerModal();
        currentEmojiPickerContext = null;
        return;
      }

      // 기존 텍스트 블록 편집 로직 (block이 있는 경우만)
      if (!block) return;
      const textContent = block.querySelector(".text-content");
      if (textContent) {
        textContent.focus();
        try {
          const selection = window.getSelection();
          if (selection.rangeCount > 0) {
            const range = selection.getRangeAt(0);
            range.deleteContents();
            const textNode = document.createTextNode(emoji);
            range.insertNode(textNode);
            range.collapse(false);
            selection.removeAllRanges();
            selection.addRange(range);
          } else {
            textContent.textContent += emoji;
            const range = document.createRange();
            range.selectNodeContents(textContent);
            range.collapse(false);
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
          }
        } catch (error) {
          textContent.textContent += emoji;
        }
        if (typeof updateBlockBackgroundForEmoji === "function") {
          updateBlockBackgroundForEmoji(block);
        }
      }
      closeEmojiPickerModal();
    });
    emojiGrid.appendChild(emojiBtn);
  });
}

function renderEmojiStickers() {
  const stickersList = document.getElementById("step3-emoji-stickers");
  if (!stickersList) return;

  if (emojiStickers.length === 0) {
    stickersList.innerHTML = "";
    return;
  }

  stickersList.innerHTML = emojiStickers
    .map(
      (sticker, index) => `
    <div class="emoji-sticker-item" data-sticker-id="${sticker.id}">
      <span class="emoji-sticker-display">${sticker.emoji}</span>
      <button class="emoji-sticker-remove" onclick="removeEmojiSticker(${sticker.id})">×</button>
    </div>
  `
    )
    .join("");
}

window.removeEmojiSticker = function (stickerId) {
  emojiStickers = emojiStickers.filter((s) => s.id !== stickerId);
  renderEmojiStickers();
  generateFinalMoodboard();
};

function generateFinalMoodboard() {
  const previewArea = document.getElementById("step3-preview");
  if (!previewArea || selectedCutsForMoodboard.length === 0) return;

  if (!selectedLayout) {
    selectedLayout = "grid"; // 기본값
  }

  const gap =
    selectedDensity === "spacious"
      ? 20
      : selectedDensity === "compact"
      ? 8
      : 12;
  const bgColor = getMoodBackgroundColor(selectedMoodStyle || "soft");

  let layoutHTML = "";

  switch (selectedLayout) {
    case "grid":
      layoutHTML = generateFinalGridLayout(gap);
      break;
    case "masonry":
      layoutHTML = generateFinalMasonryLayout(gap);
      break;
    case "vertical-story":
      layoutHTML = generateFinalVerticalStoryLayout(gap);
      break;
    case "horizontal-flow":
      layoutHTML = generateFinalHorizontalFlowLayout(gap);
      break;
    case "collage":
      layoutHTML = generateFinalCollageLayout(gap);
      break;
    case "diary-page":
      layoutHTML = generateFinalDiaryPageLayout(gap);
      break;
    case "photo-quote":
      layoutHTML = generateFinalPhotoQuoteLayout(gap);
      break;
    case "scrapbook-lite":
      layoutHTML = generateFinalScrapbookLiteLayout(gap);
      break;
    default:
      layoutHTML = generateFinalGridLayout(gap);
  }

  // 텍스트 블록 추가
  let textBlocksHTML = "";
  if (textBlocks.length > 0) {
    textBlocksHTML = textBlocks
      .map((block) => {
        const fontSize =
          block.size === "small"
            ? "14px"
            : block.size === "large"
            ? "20px"
            : "16px";
        const positionStyle =
          block.position === "top"
            ? "margin-bottom: 16px;"
            : block.position === "bottom"
            ? "margin-top: 16px;"
            : "margin: 16px 0;";
        return `
        <div class="text-block-final" style="${positionStyle} text-align: center; font-family: ${block.font}; font-size: ${fontSize}; color: #333;">
          ${block.text}
        </div>
      `;
      })
      .join("");
  }

  // 이모티콘 스티커 추가
  let stickersHTML = "";
  if (emojiStickers.length > 0) {
    stickersHTML = emojiStickers
      .map((sticker) => {
        const positionStyle = getStickerPositionStyle(sticker.position);
        return `
        <div class="emoji-sticker-final" style="${positionStyle} font-size: 32px; position: absolute;">
          ${sticker.emoji}
        </div>
      `;
      })
      .join("");
  }

  previewArea.innerHTML = `
    <div class="moodboard-final-preview" style="background-color: ${bgColor}; padding: ${gap}px; border-radius: 8px; position: relative; min-height: 400px;">
      ${textBlocks
        .filter((b) => b.position === "top")
        .map((b) => {
          const fontSize =
            b.size === "small" ? "14px" : b.size === "large" ? "20px" : "16px";
          return `<div style="text-align: center; font-family: ${b.font}; font-size: ${fontSize}; color: #333; margin-bottom: ${gap}px;">${b.text}</div>`;
        })
        .join("")}
      ${layoutHTML}
      ${textBlocks
        .filter((b) => b.position === "middle")
        .map((b) => {
          const fontSize =
            b.size === "small" ? "14px" : b.size === "large" ? "20px" : "16px";
          return `<div style="text-align: center; font-family: ${b.font}; font-size: ${fontSize}; color: #333; margin: ${gap}px 0;">${b.text}</div>`;
        })
        .join("")}
      ${textBlocks
        .filter((b) => b.position === "bottom")
        .map((b) => {
          const fontSize =
            b.size === "small" ? "14px" : b.size === "large" ? "20px" : "16px";
          return `<div style="text-align: center; font-family: ${b.font}; font-size: ${fontSize}; color: #333; margin-top: ${gap}px;">${b.text}</div>`;
        })
        .join("")}
      ${stickersHTML}
    </div>
  `;

  generatedMoodboardLayout = {
    style: selectedMoodStyle || "soft",
    layout: selectedLayout || "grid",
    density: selectedDensity,
    cuts: selectedCutsForMoodboard,
    textBlocks: textBlocks,
    emojiStickers: emojiStickers,
  };
}

function getStickerPositionStyle(position) {
  const positions = {
    "top-left": "top: 16px; left: 16px;",
    "top-right": "top: 16px; right: 16px;",
    "bottom-left": "bottom: 16px; left: 16px;",
    "bottom-right": "bottom: 16px; right: 16px;",
    center: "top: 50%; left: 50%; transform: translate(-50%, -50%);",
  };
  return positions[position] || positions["top-right"];
}

function generateFinalGridLayout(gap) {
  const cols = Math.ceil(Math.sqrt(selectedCutsForMoodboard.length));
  return `
    <div style="display: grid; grid-template-columns: repeat(${cols}, 1fr); gap: ${gap}px;">
      ${selectedCutsForMoodboard
        .map(
          (cut) => `
        <img src="${
          cut.imageUrl || cut.image_url || ""
        }" style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px;" />
      `
        )
        .join("")}
    </div>
  `;
}

