function getMoodBackgroundColor(style) {
  const colors = {
    soft: "#FFF5F5",
    blue: "#E8F4F8",
    warm: "#FFF8E1",
    calm: "#F5F5F5",
    vintage: "#F5F0E8",
    daily: "#FAFAFA",
    minimal: "#FFFFFF",
    film: "#E8E8E8",
    diary: "#FEF9E7",
    mono: "#F5F5F5",
  };
  return colors[style] || "#FAFAFA";
}

window.saveMoodboardFromSteps = async function () {
  const titleInput = document.getElementById("step3-title-input");
  const title = titleInput ? titleInput.value.trim() : "새 무드보드";

  if (!title) {
    alert("무드보드 제목을 입력해주세요");
    return;
  }

  if (step3CanvasItems.length === 0) {
    alert("최소 1개 이상의 요소를 추가해주세요");
    return;
  }

  try {
    const firebaseUser = await ensureFirebaseUser();
    if (!firebaseUser) {
      alert("로그인이 필요합니다");
      return;
    }

    const supabaseClient = await loadSupabaseClient();
    if (!supabaseClient) {
      alert("서비스에 연결할 수 없습니다");
      return;
    }

    // 캔버스 데이터를 blocks 형식으로 변환
    const blocks = step3CanvasItems
      .map((item) => {
        if (item.type === "cut") {
          return {
            type: "image",
            imageUrl: item.data.imageUrl || item.data.image_url,
            x: item.x,
            y: item.y,
            width: item.width,
            height: item.height,
          };
        } else if (item.type === "text") {
          return {
            type: "text",
            text: item.data.text || "",
            x: item.x,
            y: item.y,
            font: item.data.font || currentTextFont,
            align: item.data.align || currentTextAlign,
            color: item.data.color || currentTextColor,
            size: item.data.size || currentTextSize,
          };
        } else if (item.type === "sticker") {
          return {
            type: "sticker",
            emoji: item.data.emoji,
            x: item.x,
            y: item.y,
          };
        }
        return null;
      })
      .filter((b) => b !== null);

    // 썸네일 생성 (첫 번째 컷 또는 첫 번째 이미지)
    const firstCut = step3CanvasItems.find((i) => i.type === "cut");
    const thumbnail = firstCut
      ? firstCut.data.imageUrl || firstCut.data.image_url
      : null;

    // 무드보드 저장
    const moodboardData = {
      name: title,
      backgroundColor: step3BackgroundColor,
      blocks: blocks,
      thumbnail: thumbnail,
      isPublic: false, // 기본값은 비공개
    };

    // user_feed_events에 저장
    const { data: eventData, error: eventError } = await supabaseClient
      .from("user_feed_events")
      .insert({
        user_id: firebaseUser.uid,
        event_type: "moodboard_created",
        metadata: {
          moodboard_data: moodboardData,
          isPublic: false,
        },
      })
      .select()
      .single();

    if (eventError) {
      console.error("[무드보드 저장] 오류:", eventError);
      alert("무드보드 저장 중 오류가 발생했습니다");
      return;
    }

    // 공개/비공개 선택 모달 표시
    showMoodboardSaveModal(eventData.id, moodboardData);
  } catch (error) {
    console.error("[무드보드 저장] 예외:", error);
    alert("무드보드 저장 중 오류가 발생했습니다");
  }
};

// 무드보드 저장 후 공개/비공개 선택 모달
function showMoodboardSaveModal(eventId, moodboardData) {
  const modal = document.createElement("div");
  modal.className = "moodboard-save-modal";
  modal.style.cssText = `
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex; align-items: center; justify-content: center;
    z-index: 10000;
  `;

  modal.innerHTML = `
    <div style="background: white; border-radius: 16px; padding: 24px; max-width: 320px; width: 90%;">
      <h3 style="margin: 0 0 16px 0; font-size: 18px; font-weight: 600;">무드보드가 저장되었습니다</h3>
      <div style="margin-bottom: 20px;">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <input type="checkbox" id="moodboard-public-toggle" style="width: 20px; height: 20px;" />
          <span>공개하기</span>
        </label>
      </div>
      <div style="display: flex; gap: 8px;">
        <button id="save-modal-mypage-btn" style="flex: 1; padding: 12px; background: #F7F7F8; color: #111; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
          마이페이지로
        </button>
      </div>
    </div>
  `;

  document.body.appendChild(modal);

  const toggle = modal.querySelector("#moodboard-public-toggle");

  modal
    .querySelector("#save-modal-mypage-btn")
    .addEventListener("click", async () => {
      if (toggle.checked) {
        await updateMoodboardPublicStatus(eventId, true);
      }
      modal.remove();
      closeMoodboardCreateModal();
      window.location.reload();
    });

  modal
    .querySelector(".moodboard-save-modal")
    .addEventListener("click", (e) => {
      if (e.target === modal) {
        modal.remove();
      }
    });
}

async function updateMoodboardPublicStatus(eventId, isPublic) {
  try {
    const supabaseClient = await loadSupabaseClient();
    if (!supabaseClient) return;

    const { data } = await supabaseClient
      .from("user_feed_events")
      .select("metadata")
      .eq("id", eventId)
      .single();

    if (data) {
      const updatedMetadata = {
        ...data.metadata,
        isPublic: isPublic,
        moodboard_data: {
          ...data.metadata.moodboard_data,
          isPublic: isPublic,
        },
      };

      await supabaseClient
        .from("user_feed_events")
        .update({ metadata: updatedMetadata })
        .eq("id", eventId);
    }
  } catch (error) {
    console.error("[무드보드 공개 상태 업데이트] 오류:", error);
  }
}

