/**
 * Load moodboards for MY MOOD tab
 */
async function loadMyMoodMoodboards() {
  const heroEl = document.getElementById("mypageMoodHero");
  const gridEl = document.getElementById("mypageMoodGrid");
  const emptyEl = document.getElementById("mypageMoodEmpty");

  if (!heroEl || !gridEl || !emptyEl) {
    console.warn("[MY MOOD] DOM 요소를 찾을 수 없습니다");
    return;
  }

  // 🔥 CRITICAL FIX: userId가 없어도 빈 상태를 반드시 렌더링
  try {
    // 먼저 무드보드 목록 로드 (userId가 없어도 시도)
    await loadMoodboards();

    if (moodboards.length === 0) {
      // 빈 상태 반드시 표시
      heroEl.style.display = "none";
      gridEl.innerHTML = "";
      emptyEl.style.display = "flex";
      return;
    }

    emptyEl.style.display = "none";

    // 대표 무드보드 찾기
    const featured =
      moodboards.find(
        (m) => m.isRepresentative === true || m.isRepresentative === "true"
      ) || moodboards[0];

    // Hero 무드보드 표시
    if (featured) {
      heroEl.style.display = "block";
      const thumbnail =
        featured.thumbnail_url || featured.backgroundColor || "#667eea";
      heroEl.innerHTML = `
        <div class="mypage-mood-hero-content" style="background: ${thumbnail}">
          <div class="mypage-mood-hero-overlay"></div>
          <button class="mypage-mood-hero-menu" onclick="openMoodboardMenu('${
            featured.id
          }')">⋮</button>
          <h2 class="mypage-mood-hero-title">${featured.name || "무제"}</h2>
        </div>
      `;
      heroEl.onclick = () => openMoodboardDetail(featured);
    } else {
      heroEl.style.display = "none";
    }

    // 무드보드 그리드 렌더링 (대표 제외)
    const otherMoodboards = moodboards.filter((m) => m.id !== featured?.id);
    gridEl.innerHTML = "";

    if (otherMoodboards.length === 0 && featured) {
      // 대표만 있고 다른 무드보드가 없는 경우
      gridEl.innerHTML = "";
    } else {
      otherMoodboards.forEach((moodboard) => {
        const card = createMyMoodMoodboardCard(moodboard);
        gridEl.appendChild(card);
      });
    }
  } catch (error) {
    console.error("[MY MOOD 무드보드] 로드 오류:", error);
    // 🔥 CRITICAL FIX: 에러 발생 시에도 빈 상태 반드시 표시
    heroEl.style.display = "none";
    gridEl.innerHTML = "";
    emptyEl.style.display = "flex";
  }
}

