window.openFollowListModal = async function (type) {
  const modal = document.getElementById("followListModal");
  const titleEl = document.getElementById("follow-list-title");
  const bodyEl = document.getElementById("follow-list-body");

  if (!modal || !titleEl || !bodyEl) {
    console.error("[팔로우 모달] 모달 요소를 찾을 수 없습니다", {
      modal: !!modal,
      titleEl: !!titleEl,
      bodyEl: !!bodyEl,
    });
    return;
  }

  try {
    const firebaseUser = await ensureFirebaseUser();
    if (!firebaseUser) {
      alert("로그인이 필요합니다");
      return;
    }

    const supabaseClient = await loadSupabaseClient();
    if (!supabaseClient) {
      alert("서비스에 연결할 수 없습니다");
      return;
    }

    titleEl.textContent = type === "following" ? "팔로잉" : "팔로워";
    bodyEl.innerHTML =
      '<div style="text-align: center; padding: 40px;">로딩 중...</div>';

    // 모달 표시
    modal.style.display = "flex";
    modal.classList.add("active");

    let list = [];

    if (type === "following") {
      // 팔로잉 목록: reader_follows에서 follower_id가 현재 사용자인 경우
      // following_id가 내가 팔로우한 사람
      const { data: readerFollows } = await supabaseClient
        .from("reader_follows")
        .select("following_id")
        .eq("follower_id", firebaseUser.uid);

      if (readerFollows && readerFollows.length > 0) {
        // removed: Firestore 접근 로직 제거 - Supabase readers 테이블에서 닉네임 가져오기
        const followingIds = readerFollows.map((f) => f.following_id);
        const { data: readersData } = await supabaseClient
          .from("readers")
          .select("firebase_uid, nickname")
          .in("firebase_uid", followingIds);

        const readersMap = new Map();
        if (readersData) {
          readersData.forEach((reader) => {
            readersMap.set(
              reader.firebase_uid,
              reader.nickname || `user_${reader.firebase_uid.substring(0, 8)}`
            );
          });
        }

        const usersWithNicknames = followingIds.map((id) => ({
          id: id,
          nickname: readersMap.get(id) || `user_${id.substring(0, 8)}`,
        }));

        list = usersWithNicknames.map((user) => ({
          id: user.id,
          name: `@${user.nickname}`,
          type: "user",
          avatar: null,
        }));
      }
    } else {
      // 팔로워 목록: reader_follows에서 following_id가 현재 사용자인 경우
      // follower_id가 나를 팔로우한 사람
      const { data: readerFollowers } = await supabaseClient
        .from("reader_follows")
        .select("follower_id")
        .eq("following_id", firebaseUser.uid);

      if (readerFollowers && readerFollowers.length > 0) {
        // removed: Firestore 접근 로직 제거 - Supabase readers 테이블에서 닉네임 가져오기
        const followerIds = readerFollowers.map((f) => f.follower_id);
        const { data: readersData } = await supabaseClient
          .from("readers")
          .select("firebase_uid, nickname")
          .in("firebase_uid", followerIds);

        const readersMap = new Map();
        if (readersData) {
          readersData.forEach((reader) => {
            readersMap.set(
              reader.firebase_uid,
              reader.nickname || `user_${reader.firebase_uid.substring(0, 8)}`
            );
          });
        }

        const usersWithNicknames = followerIds.map((id) => ({
          id: id,
          nickname: readersMap.get(id) || `user_${id.substring(0, 8)}`,
        }));

        list = usersWithNicknames.map((user) => ({
          id: user.id,
          name: `@${user.nickname}`,
          type: "user",
          avatar: null,
        }));
      }
    }

    if (list.length === 0) {
      bodyEl.innerHTML = `
        <div style="text-align: center; padding: 40px; color: #999;">
          <p>${
            type === "following" ? "팔로잉한" : "팔로워"
          } 사용자가 없습니다</p>
        </div>
      `;
    } else {
      bodyEl.innerHTML = list
        .map(
          (item) => `
        <div class="follow-list-item-react">
          <div class="follow-list-item-info-react">
            <div class="follow-list-item-avatar-react">${item.name
              .replace("@", "")
              .charAt(0)
              .toUpperCase()}</div>
            <span class="follow-list-item-name-react">${item.name}</span>
          </div>
          <button class="follow-list-item-btn-react ${
            type === "following" ? "following" : "follow"
          }" onclick="window.toggleFollowFromList('${item.id}', '${
            item.type
          }', event)">
            ${type === "following" ? "팔로잉" : "팔로우"}
          </button>
        </div>
      `
        )
        .join("");
    }
  } catch (error) {
    console.error("[팔로우] 리스트 로드 오류:", error);
    bodyEl.innerHTML = `
      <div style="text-align: center; padding: 40px; color: #999;">
        <p>리스트를 불러오는 중 오류가 발생했습니다</p>
      </div>
    `;
  }
};

