        metadata: {
          moodboard_id: `moodboard_${Date.now()}`,
          moodboard_data: moodboardData,
        },
      })
      .select()
      .single();

    if (error) {
      console.error("[무드보드] 저장 오류:", error);
      alert("무드보드 저장에 실패했습니다");
      return;
    }

    closeMoodboardCreateModal();
    showMoodboardSaveCompleteModal(data.id, moodboardData);
  } catch (error) {
    console.error("[무드보드] 저장 중 오류:", error);
    alert("무드보드 저장 중 오류가 발생했습니다");
  }
};

function generateMoodboardBlocks(layout) {
  const blocks = [];
  const { cuts, layout: layoutInfo } = layout;
  const { cols } = layoutInfo;

  const itemWidth = 100 / cols;
  let row = 0;
  let col = 0;

  cuts.forEach((cut, index) => {
    if (col >= cols) {
      col = 0;
      row++;
    }

    blocks.push({
      type: "image",
      imageUrl: cut.imageUrl || cut.image_url,
      cutId: cut.id,
      x: col * itemWidth,
      y: row * 200,
      width: itemWidth - 2,
      height: 200,
      zIndex: index + 1,
    });

    col++;
  });

  return blocks;
}

function showMoodboardSaveCompleteModal(moodboardId, moodboardData) {
  const isPublic = confirm(
    "무드보드가 저장되었습니다.\n\n공개하시겠습니까? (확인: 공개, 취소: 비공개)"
  );
  updateMoodboardPrivacy(moodboardId, isPublic);
}

async function updateMoodboardPrivacy(moodboardId, isPublic) {
  try {
    const firebaseUser = await ensureFirebaseUser();
    if (!firebaseUser) return;

    const supabaseClient = await loadSupabaseClient();
    if (!supabaseClient) return;

    const { data: eventsData } = await supabaseClient
      .from("user_feed_events")
      .select("*")
      .eq("user_id", firebaseUser.uid)
      .eq("event_type", "moodboard_created")
      .eq("id", moodboardId)
      .single();

    if (eventsData) {
      const metadata = eventsData.metadata || {};
      const moodboardData = metadata.moodboard_data || metadata || {};
      moodboardData.isPublic = isPublic;
      metadata.isPublic = isPublic;
      metadata.moodboard_data = moodboardData;

      await supabaseClient
        .from("user_feed_events")
        .update({ metadata: metadata })
        .eq("id", moodboardId);
    }

    await loadMoodboards();

    if (isPublic) {
      alert("무드보드가 공개되었습니다.");
    }
  } catch (error) {
    console.error("[무드보드] 공개 설정 오류:", error);
  }
}

