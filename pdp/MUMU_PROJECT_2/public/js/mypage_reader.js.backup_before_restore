/**
 * Render moodboard detail content
 */
function renderMoodboardDetailContent(container, moodboard) {
  // 무드보드 블록들을 렌더링
  if (!moodboard.blocks || moodboard.blocks.length === 0) {
    container.innerHTML = `
      <div style="text-align: center; padding: 40px; color: #999;">
        무드보드 내용이 없습니다
      </div>
    `;
    return;
  }

  // 레이아웃에 따라 다른 스타일 적용
  const layout = moodboard.layout || "clean-grid";
  container.innerHTML = "";
  container.className = "moodboard-detail-fullscreen-content";

  // 레이아웃별 스타일 적용
  switch (layout) {
    case "clean-grid":
      container.style.display = "grid";
      container.style.gridTemplateColumns =
        "repeat(auto-fit, minmax(150px, 1fr))";
      container.style.gap = "12px";
      container.style.padding = "20px";
      break;
    case "collage":
      container.style.display = "grid";
      container.style.gridTemplateColumns =
        "repeat(auto-fit, minmax(120px, 1fr))";
      container.style.gap = "8px";
      container.style.padding = "16px";
      container.style.gridAutoFlow = "dense";
      break;
    case "vertical":
      container.style.display = "flex";
      container.style.flexDirection = "column";
      container.style.gap = "16px";
      container.style.padding = "20px";
      break;
    case "diary":
    case "chaos":
    default:
      container.style.display = "grid";
      container.style.gridTemplateColumns =
        "repeat(auto-fit, minmax(150px, 1fr))";
      container.style.gap = "12px";
      container.style.padding = "20px";
      break;
  }

  moodboard.blocks.forEach((block, index) => {
    const blockEl = createMoodboardDetailBlock(block, layout);
    container.appendChild(blockEl);
  });
}

/**
 * Create moodboard detail block element
 */
function createMoodboardDetailBlock(block, layout) {
  const blockEl = document.createElement("div");
  blockEl.className = "moodboard-detail-block";
  blockEl.style.borderRadius = "12px";
  blockEl.style.overflow = "hidden";
  blockEl.style.boxShadow = "0 2px 8px rgba(0, 0, 0, 0.1)";

  if (block.type === "image" && block.image_url) {
    blockEl.innerHTML = `<img src="${block.image_url}" style="width: 100%; height: auto; display: block;" />`;
    if (layout === "vertical") {
      blockEl.style.width = "100%";
    }
  } else if (block.type === "text") {
    const bgColor = block.backgroundColor || "#fafafa";
    const textColor = block.textColor || "#333";
    const fontSize = block.fontSize || "16px";
    blockEl.style.background = bgColor;
    blockEl.style.color = textColor;
    blockEl.style.padding = "16px";
    blockEl.style.fontSize = fontSize;
    blockEl.textContent = block.text || block.content || "";

    // Step 3에서 추가한 텍스트 블록인 경우 absolute positioning
    if (block.x !== undefined && block.y !== undefined) {
      blockEl.style.position = "absolute";
      blockEl.style.left = `${block.x}%`;
      blockEl.style.top = `${block.y}%`;
      blockEl.style.width = `${block.w || 200}px`;
      blockEl.style.minHeight = `${block.h || 50}px`;
    }
  } else if (block.type === "emoji") {
    blockEl.style.fontSize = "48px";
    blockEl.style.display = "flex";
    blockEl.style.alignItems = "center";
    blockEl.style.justifyContent = "center";
    blockEl.style.padding = "20px";
    blockEl.style.backgroundColor = "rgba(255, 255, 255, 0.9)";
    blockEl.textContent = block.content || block.emoji || "😊";

    // Step 3에서 추가한 이모지 블록인 경우 absolute positioning
    if (block.x !== undefined && block.y !== undefined) {
      blockEl.style.position = "absolute";
      blockEl.style.left = `${block.x}%`;
      blockEl.style.top = `${block.y}%`;
      blockEl.style.width = `${block.w || 60}px`;
      blockEl.style.height = `${block.h || 60}px`;
    }
  } else {
    blockEl.style.background = "#f5f5f5";
    blockEl.style.height = "200px";
    blockEl.style.display = "flex";
    blockEl.style.alignItems = "center";
    blockEl.style.justifyContent = "center";
    blockEl.textContent = "블록 내용";
  }

  return blockEl;
}

