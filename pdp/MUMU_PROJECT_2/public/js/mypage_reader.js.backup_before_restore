window.toggleFollowFromList = async function (userId, userType, event) {
  try {
    const firebaseUser = await ensureFirebaseUser();
    if (!firebaseUser) {
      alert("로그인이 필요합니다");
      return;
    }

    const supabaseClient = await loadSupabaseClient();
    if (!supabaseClient) {
      alert("서비스에 연결할 수 없습니다");
      return;
    }

    const titleEl = document.getElementById("follow-list-title");
    const type = titleEl?.textContent === "팔로잉" ? "following" : "followers";

    // 현재 팔로우 상태 확인 (reader_follows만 사용)
    // follower_id가 나이고 following_id가 상대방인 경우 팔로우 중
    const { data } = await supabaseClient
      .from("reader_follows")
      .select("follower_id, following_id")
      .eq("follower_id", firebaseUser.uid)
      .eq("following_id", userId)
      .maybeSingle();
    const isFollowing = !!data;

    // Optimistic UI 업데이트
    const buttonEl = event?.target?.closest(".follow-list-item-btn-react");
    if (buttonEl) {
      if (isFollowing) {
        buttonEl.textContent = "팔로우";
        buttonEl.classList.remove("following");
        buttonEl.classList.add("follow");
      } else {
        buttonEl.textContent = "팔로잉";
        buttonEl.classList.remove("follow");
        buttonEl.classList.add("following");
      }
    }

    // 실제 팔로우/언팔로우 처리 (reader_follows만 사용)
    if (isFollowing) {
      // 언팔로우
      await supabaseClient
        .from("reader_follows")
        .delete()
        .eq("follower_id", firebaseUser.uid)
        .eq("following_id", userId);
    } else {
      // 팔로우
      await supabaseClient.from("reader_follows").insert({
        follower_id: firebaseUser.uid,
        following_id: userId,
      });
    }

    // 팔로워/팔로잉 수 업데이트
    await loadMyMoodProfile();

    // 리스트 새로고침
    await window.openFollowListModal(type);
  } catch (error) {
    console.error("[팔로우] 토글 오류:", error);
    alert("팔로우 처리 중 오류가 발생했습니다");
    // 오류 발생 시 리스트 새로고침
    const titleEl = document.getElementById("follow-list-title");
    if (titleEl) {
      const type = titleEl.textContent === "팔로잉" ? "following" : "followers";
      await window.openFollowListModal(type);
    }
  }
};

