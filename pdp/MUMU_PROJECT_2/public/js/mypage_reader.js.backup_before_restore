// React 스타일 에디터 상태
let selectedCutsForMoodboardReact = [];
let selectedLayoutReact = null;

/**
 * React 스타일 Step 1: 컷 선택
 */
function loadCutsForStep1React() {
  const gridEl = document.getElementById("step1-cuts-grid-react");
  if (!gridEl) return;

  // 저장된 컷이 없으면 먼저 로드
  if (savedCuts.length === 0) {
    loadSavedCuts().then(() => {
      renderCutsForStep1React();
    });
  } else {
    renderCutsForStep1React();
  }
}

function renderCutsForStep1React() {
  const gridEl = document.getElementById("step1-cuts-grid-react");
  const countEl = document.getElementById("selected-cuts-count-react");
  const nextBtn = document.getElementById("step1-next-btn-react");

  if (!gridEl) return;

  if (savedCuts.length === 0) {
    gridEl.innerHTML = `
      <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: #999;">
        <p>저장된 컷이 없습니다</p>
        <p style="font-size: 14px; margin-top: 8px;">먼저 피드에서 컷을 저장해주세요</p>
      </div>
    `;
    return;
  }

  gridEl.innerHTML = savedCuts
    .map((cut) => {
      const isSelected = selectedCutsForMoodboardReact.some(
        (c) => c.id === cut.id
      );
      return `
        <div class="cut-selection-item-react ${
          isSelected ? "selected" : ""
        }" onclick="toggleCutSelectionReact('${cut.id}')">
          <img src="${
            cut.imageUrl || cut.image_url || ""
          }" alt="컷" loading="lazy" />
          ${isSelected ? '<div class="cut-selection-check-react">✓</div>' : ""}
        </div>
      `;
    })
    .join("");

  // 카운트 및 버튼 업데이트
  if (countEl) {
    countEl.textContent = selectedCutsForMoodboardReact.length;
  }

  if (nextBtn) {
    nextBtn.disabled = selectedCutsForMoodboardReact.length < 3;
  }
}

window.toggleCutSelectionReact = function (cutId) {
  const cut = savedCuts.find((c) => c.id === cutId);
  if (!cut) return;

  const index = selectedCutsForMoodboardReact.findIndex((c) => c.id === cutId);
  if (index >= 0) {
    selectedCutsForMoodboardReact.splice(index, 1);
  } else {
    if (selectedCutsForMoodboardReact.length >= 12) {
      alert("최대 12개까지 선택할 수 있습니다");
      return;
    }
    selectedCutsForMoodboardReact.push(cut);
  }

  renderCutsForStep1React();
};

